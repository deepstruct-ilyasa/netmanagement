node_modules/
.env

# Database SQLite & file WAL sementara
database/*.db
database/*.db-shm
database/*.db-wal

# File upload user (sisakan folder kosongnya saja)
public/uploads/*
!public/uploads/.gitkeep

# Foto profil user (sisakan folder kosongnya saja, favicon.ico tetap aman)
public/img/profile/*
!public/img/profile/.gitkeep
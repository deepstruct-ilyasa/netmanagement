{
  "name": "netmanagement",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "css:watch": "npx tailwindcss -i ./src/css/input.css -o ./public/css/output.css --watch",
    "css:build": "npx tailwindcss -i ./src/css/input.css -o ./public/css/output.css --minify",
    "dev": "concurrently -n \"CSS,APP\" -c \"cyan,green\" \"npm run css:watch\" \"nodemon app.js\""
  },
  "nodemonConfig": {
    "ignore": [
      "database/*",
      "public/uploads/*",
      "public/css/*"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "nodemon": "^3.1.14",
    "tailwindcss": "^3.4.19"
  }
}
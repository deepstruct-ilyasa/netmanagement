<%- include('partials/header', { pageTitle: 'Master Assets Perangkat' }) %>

<main class="p-4 sm:p-6 flex-1 w-full space-y-5">

  <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
    <div id="alert-error" class="bg-rose-500/15 border border-rose-500/40 text-rose-400 px-4 py-3 rounded-xl flex items-center justify-between text-sm">
      <div class="flex items-center gap-2.5">
        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0"></i>
        <span><%= errorMsg %></span>
      </div>
      <button onclick="document.getElementById('alert-error').remove()" class="p-1 hover:text-white cursor-pointer">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>
  <% } %>

  <% if (typeof successMsg !== 'undefined' && successMsg) { %>
    <div id="alert-success" class="bg-emerald-500/15 border border-emerald-500/40 text-emerald-400 px-4 py-3 rounded-xl flex items-center justify-between text-sm">
      <div class="flex items-center gap-2.5">
        <i data-lucide="check-circle-2" class="w-5 h-5 shrink-0"></i>
        <span><%= successMsg %></span>
      </div>
      <button onclick="document.getElementById('alert-success').remove()" class="p-1 hover:text-white cursor-pointer">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>
  <% } %>

  <!-- Header Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-800 border border-slate-700 p-4 rounded-xl">
    <div>
      <h2 class="text-base font-semibold text-white">Inventaris & Master Aset IT</h2>
      <p class="text-xs text-slate-400">Registrasi fisik perangkat, pelacakan status operasional, garansi, mutasi lokasi, dan riwayat perbaikan.</p>
    </div>
    <% if (can('asset.write')) { %>
      <div class="flex flex-wrap items-center gap-2">
        <button type="button" onclick="openModal('modal-asset-settings')"
          class="inline-flex items-center justify-center gap-2 bg-slate-700 hover:bg-slate-600 text-slate-200 border border-slate-600 font-medium text-xs px-3.5 py-2.5 rounded-lg transition cursor-pointer">
          <i data-lucide="settings-2" class="w-4 h-4 text-sky-400"></i>
          <span>Format Kode</span>
        </button>
        <button type="button" onclick="openAddAssetModal()"
          class="inline-flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-semibold text-sm px-4 py-2.5 rounded-lg transition shadow-sm cursor-pointer">
          <i data-lucide="plus" class="w-4 h-4"></i>
          <span>Tambah Aset</span>
        </button>
      </div>
    <% } %>
  </div>

  <!-- Ringkasan Statistik Aset -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
    <div class="bg-slate-800 border border-slate-700 rounded-xl p-4">
      <div class="flex items-center justify-between text-slate-400 text-xs mb-1">
        <span>Total Unit Aset</span>
        <i data-lucide="boxes" class="w-4 h-4 text-sky-400"></i>
      </div>
      <div class="text-2xl font-bold text-white"><%= stats.total %> <span class="text-xs font-normal text-slate-400">Unit</span></div>
      <div class="text-[11px] text-slate-400 mt-1">Nilai: Rp <%= stats.totalValue.toLocaleString('id-ID') %></div>
    </div>

    <div class="bg-slate-800 border border-slate-700 rounded-xl p-4">
      <div class="flex items-center justify-between text-slate-400 text-xs mb-1">
        <span>Terpasang (Active)</span>
        <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400"></i>
      </div>
      <div class="text-2xl font-bold text-emerald-400"><%= stats.active %> <span class="text-xs font-normal text-slate-400">Unit</span></div>
      <div class="text-[11px] text-slate-400 mt-1">Operasional di jaringan</div>
    </div>

    <div class="bg-slate-800 border border-slate-700 rounded-xl p-4">
      <div class="flex items-center justify-between text-slate-400 text-xs mb-1">
        <span>Cadangan (Spare)</span>
        <i data-lucide="archive" class="w-4 h-4 text-amber-400"></i>
      </div>
      <div class="text-2xl font-bold text-amber-400"><%= stats.spare %> <span class="text-xs font-normal text-slate-400">Unit</span></div>
      <div class="text-[11px] text-slate-400 mt-1">Belum di Distribusikan</div>
    </div>

    <div class="bg-slate-800 border border-slate-700 rounded-xl p-4">
      <div class="flex items-center justify-between text-slate-400 text-xs mb-1">
        <span>Service / Rusak</span>
        <i data-lucide="wrench" class="w-4 h-4 text-rose-400"></i>
      </div>
      <div class="text-2xl font-bold text-rose-400"><%= stats.issue %> <span class="text-xs font-normal text-slate-400">Unit</span></div>
      <div class="text-[11px] text-slate-400 mt-1">Maintenance atau rusak</div>
    </div>
  </div>

  <!-- Tabel Daftar Aset -->
  <div class="bg-slate-800 border border-slate-700 rounded-xl shadow-lg overflow-hidden">
    <div class="p-4 border-b border-slate-700/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-900/30">
      <!-- Filter Cepat Status -->
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <button type="button" onclick="setAssetStatusFilter('all')" data-status-btn="all"
          class="asset-status-pill px-3 py-1.5 rounded-lg font-semibold bg-emerald-500 text-slate-950 cursor-pointer transition">
          Semua
        </button>
        <button type="button" onclick="setAssetStatusFilter('active')" data-status-btn="active"
          class="asset-status-pill px-3 py-1.5 rounded-lg font-medium bg-slate-800 text-slate-300 border border-slate-700 hover:bg-slate-700 cursor-pointer transition">
          Active
        </button>
        <button type="button" onclick="setAssetStatusFilter('spare')" data-status-btn="spare"
          class="asset-status-pill px-3 py-1.5 rounded-lg font-medium bg-slate-800 text-slate-300 border border-slate-700 hover:bg-slate-700 cursor-pointer transition">
          Spare
        </button>
        <button type="button" onclick="setAssetStatusFilter('maintenance')" data-status-btn="maintenance"
          class="asset-status-pill px-3 py-1.5 rounded-lg font-medium bg-slate-800 text-slate-300 border border-slate-700 hover:bg-slate-700 cursor-pointer transition">
          Service
        </button>
        <button type="button" onclick="setAssetStatusFilter('broken')" data-status-btn="broken"
          class="asset-status-pill px-3 py-1.5 rounded-lg font-medium bg-slate-800 text-slate-300 border border-slate-700 hover:bg-slate-700 cursor-pointer transition">
          Rusak
        </button>
      </div>

      <!-- Search & Per Page -->
      <div class="flex flex-row items-center justify-end gap-3">
        <div class="relative flex-1 sm:flex-initial sm:w-72">
          <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"></i>
          <input type="text" id="asset-search-input" oninput="onAssetSearch(this.value)"
            placeholder="Cari kode aset, SN, brand, model, hostname..."
            class="w-full bg-slate-900 border border-slate-600 rounded-lg pl-9 pr-3 py-2 text-xs text-white placeholder-slate-400 focus:outline-none focus:border-emerald-400">
        </div>
        <div class="flex items-center gap-2 text-xs shrink-0">
          <select id="asset-per-page" onchange="changeAssetPerPage(this.value)" class="bg-slate-900 border border-slate-600 rounded-lg px-2 py-2 text-white focus:outline-none focus:border-emerald-400">
            <option value="8">8</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
          </select>
        </div>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-sm whitespace-nowrap">
        <thead>
          <tr class="bg-slate-900/60 border-b border-slate-700 text-slate-400 text-xs uppercase">
            <th class="py-3 px-4 w-12 text-center">No</th>
            <th class="py-3 px-4">Kode Aset</th>
            <th class="py-3 px-4">Jenis Perangkat</th>
            <th class="py-3 px-4">Perangkat</th>
            <th class="py-3 px-4">Serial Number</th>
            <th class="py-3 px-4">Cabang</th>
            <th class="py-3 px-4">Hostname</th>
            <th class="py-3 px-4 text-center">Status</th>
            <th class="py-3 px-4">Garansi</th>
            <th class="py-3 px-4 text-center">Aksi</th>
          </tr>
        </thead>
        <tbody id="assets-table-body" class="divide-y divide-slate-700/60">
          <% if (assets.length === 0) { %>
            <tr>
              <td colspan="10" class="py-10 text-center text-xs text-slate-400">Belum ada data aset terdaftar.</td>
            </tr>
          <% } %>

          <% assets.forEach((a, idx) => { %>
            <tr class="asset-row hover:bg-slate-700/25 transition" data-status="<%= a.status %>">
              <td class="asset-no-cell py-3.5 px-4 text-center text-slate-400 font-mono"><%= idx + 1 %></td>
              <td class="py-3.5 px-4">
                <a href="/assets/<%= a.id %>" class="font-mono font-bold text-emerald-400 hover:underline">
                  <%= a.asset_code %>
                </a>
              </td>
              <td class="py-3.5 px-4">
                <div class="text-slate-400 mt-0.5"><%= a.type_name %></div>
              </td>
              <td class="py-3.5 px-4">
                <div class="font-semibold text-white">
                  <%= a.brand_name || '-' %> <%= a.model_name || '' %>
                </div>
              </td>
              <td class="py-3.5 px-4">
                <div class="font-semibold text-white">
                  <%= a.serial_number || '-' %>
                </div>
              </td>
              <td class="py-3.5 px-4">
                <span class="px-2 py-0.5 rounded bg-slate-900 border border-slate-700 text-xs font-semibold text-sky-400">
                  <%= a.branch_code %>
                </span>
              </td>
              <td class="py-3.5 px-4">
                <% if (a.linked_hostname) { %>
                  <div class="text-xs text-slate-200 mt-1 font-medium">
                    <i data-lucide="network" class="w-3 h-3 inline text-emerald-400 mr-1"></i><%= a.linked_hostname %>
                    <span class="text-slate-400 font-mono">(<%= a.linked_ip || '-' %>)</span>
                  </div>
                <% } else { %>
                  <div class="text-[11px] text-slate-500 mt-1">Gudang / Belum Terpasang</div>
                <% } %>
              </td>
              <td class="py-3.5 px-4 text-center">
                <%
                  const statusMap = {
                    active: { label: 'ACTIVE', cls: 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30' },
                    spare: { label: 'SPARE', cls: 'bg-amber-500/15 text-amber-400 border-amber-500/30' },
                    maintenance: { label: 'SERVICE', cls: 'bg-sky-500/15 text-sky-400 border-sky-500/30' },
                    broken: { label: 'RUSAK', cls: 'bg-rose-500/15 text-rose-400 border-rose-500/30' },
                    disposed: { label: 'AFKIR', cls: 'bg-slate-700 text-slate-400 border-slate-600' }
                  };
                  const st = statusMap[a.status] || statusMap.spare;
                %>
                <span class="px-2.5 py-0.5 rounded text-[11px] font-bold border <%= st.cls %>">
                  <%= st.label %>
                </span>
              </td>
              <td class="py-3.5 px-4 text-xs">
                <% if (a.warranty_end) { %>
                  <% const isExpired = new Date(a.warranty_end) < new Date(); %>
                  <span class="<%= isExpired ? 'text-rose-400' : 'text-emerald-400' %> font-mono">
                    <%= a.warranty_end %>
                  </span>
                  <div class="text-[10px] text-slate-400"><%= isExpired ? 'Expired' : 'Garansi Aktif' %></div>
                <% } else { %>
                  <span class="text-slate-500">-</span>
                <% } %>
              </td>
              <td class="py-3.5 px-4 text-center space-x-1">
                <a href="/assets/<%= a.id %>" title="Detail & Riwayat Aset"
                  class="inline-flex p-2 rounded-lg bg-slate-700/70 hover:bg-slate-700 text-slate-200 border border-slate-600 transition">
                  <i data-lucide="eye" class="w-4 h-4"></i>
                </a>
                <button type="button" title="Cetak Label QR Aset"
                  onclick="openQrLabelModal('<%= a.id %>', '<%= a.asset_code %>', '<%= (a.brand_name || '') + ' ' + (a.model_name || a.type_name) %>', '<%= a.serial_number || '-' %>', '<%= a.branch_code %>')"
                  class="p-2 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 transition cursor-pointer">
                  <i data-lucide="qr-code" class="w-4 h-4"></i>
                </button>
                <% if (can('asset.write')) { %>
                  <button type="button" title="Edit Aset"
                    onclick='openEditAssetModal(<%- JSON.stringify(a) %>)'
                    class="p-2 rounded-lg bg-sky-500/10 hover:bg-sky-500/20 text-sky-400 border border-sky-500/30 transition cursor-pointer">
                    <i data-lucide="square-pen" class="w-4 h-4"></i>
                  </button>
                  <% if (!a.linked_device_id) { %>
                    <button type="button" title="Hapus Aset"
                      onclick="openDeleteAssetModal('<%= a.id %>', '<%= a.asset_code %>')"
                      class="p-2 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 transition cursor-pointer">
                      <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                  <% } %>
                <% } %>
              </td>
            </tr>
          <% }) %>

          <tr id="assets-no-result" class="hidden">
            <td colspan="10" class="py-10 text-center text-xs text-slate-400">Tidak ada data aset yang cocok dengan filter/pencarian.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Footer Pagination -->
    <div id="assets-pagination-footer" class="px-4 py-3 border-t border-slate-700/80 bg-slate-900/30 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-slate-400">
      <div id="assets-page-info">Menampilkan 0 - 0 dari 0 data</div>
      <div id="assets-page-buttons" class="flex flex-wrap items-center gap-1"></div>
    </div>
  </div>

</main>

<% if (can('asset.write')) { %>
<!-- =========================================================
     MODAL REGISTRASI ASET BARU (SCROLLABLE BODY & RESPONSIVE GRID)
     ========================================================= -->
<div id="modal-add-asset" class="fixed inset-0 z-50 hidden flex items-center justify-center p-3 sm:p-4">
  <div onclick="closeModal('modal-add-asset')" class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm"></div>
  <div class="relative bg-slate-800 border border-slate-700 rounded-2xl w-full max-w-2xl max-h-[90vh] flex flex-col shadow-2xl z-10 overflow-hidden">
    <div class="px-4 sm:px-6 py-3.5 border-b border-slate-700 flex items-center justify-between shrink-0">
      <h3 class="text-sm sm:text-base font-semibold text-emerald-400">+ Registrasi Aset Perangkat Baru</h3>
      <button type="button" onclick="closeModal('modal-add-asset')" class="text-slate-400 hover:text-white p-1 cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form action="/assets" method="POST" enctype="multipart/form-data" class="flex flex-col flex-1 min-h-0 text-xs sm:text-sm">
      <div class="p-4 sm:p-6 overflow-y-auto space-y-3.5 flex-1">
        <!-- Mode Penomoran Kode Aset -->
        <div class="bg-slate-900/70 border border-slate-700 rounded-xl p-3 space-y-2">
          <label class="block text-slate-300 font-medium text-xs">Nomor / Kode Aset</label>
          <div class="flex flex-wrap gap-3 sm:gap-4 text-xs">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name="code_mode" value="auto" checked onchange="toggleAssetCodeInput(this.value)">
              <span class="text-emerald-400 font-semibold">Otomatis (<%= settings.asset_code_format %>)</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name="code_mode" value="manual" onchange="toggleAssetCodeInput(this.value)">
              <span class="text-slate-300">Input Manual (Stiker Lama)</span>
            </label>
          </div>
          <input type="text" name="manual_asset_code" id="manual_asset_code_input" disabled
            placeholder="Contoh: <%= sampleAssetCode %>"
            class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-white text-xs font-mono disabled:opacity-50 focus:outline-none focus:border-emerald-400">
        </div>

        <div class="grid grid-cols-2 gap-2.5 sm:gap-3">
          <div>
            <label class="block text-slate-300 text-xs mb-1">Cabang Pemilik *</label>
            <select name="branch_id" required class="w-full bg-slate-900 border border-slate-600 rounded-lg px-2.5 sm:px-3 py-2 text-white text-xs focus:outline-none focus:border-emerald-400">
              <% branches.forEach(b => { %>
                <option value="<%= b.id %>" <%= String(selectedBranchId) === String(b.id) ? 'selected' : '' %>>
                  [<%= b.branch_code %>] <%= b.branch_name %>
                </option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="block text-slate-300 text-xs mb-1">Jenis Perangkat *</label>
            <select name="device_type_id" id="add_asset_type_id" required onchange="onAssetDeviceTypeChange('add_asset')"
              class="w-full bg-slate-900 border border-slate-600 rounded-lg px-2.5 sm:px-3 py-2 text-white text-xs focus:outline-none focus:border-emerald-400">
              <option value="">-- Pilih Jenis --</option>
              <% deviceTypes.forEach(dt => { %>
                <option value="<%= dt.id %>"><%= dt.type_name %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-2.5 sm:gap-3">
          <div>
            <div class="flex items-center justify-between gap-1 mb-1">
              <label class="text-slate-300 text-xs truncate">Brand / Merk</label>
              <% if (can('menu.brands')) { %>
                <a href="/brands" class="text-[10px] sm:text-[11px] text-emerald-400 hover:underline font-medium shrink-0">+ Brand</a>
              <% } %>
            </div>
            <select name="brand_id" id="add_asset_brand_id" disabled onchange="onAssetBrandChange('add_asset')"
              class="w-full bg-slate-900 border border-slate-600 rounded-lg px-2.5 sm:px-3 py-2 text-white text-xs disabled:opacity-50 disabled:cursor-not-allowed focus:outline-none focus:border-emerald-400">
              <option value="">-- Pilih Jenis Dulu --</option>
            </select>
          </div>
          <div>
            <div class="flex items-center justify-between gap-1 mb-1">
              <label class="text-slate-300 text-xs truncate">Model / Type</label>
              <% if (can('menu.device-models')) { %>
                <a href="/device-models" class="text-[10px] sm:text-[11px] text-sky-400 hover:underline font-medium shrink-0">+ Model</a>
              <% } %>
            </div>
            <select name="model_id" id="add_asset_model_id" disabled
              class="w-full bg-slate-900 border border-slate-600 rounded-lg px-2.5 sm:px-3 py-2 text-white text-xs disabled:opacity-50 disabled:cursor-not-allowed focus:outline-none focus:border-emerald-400">
              <option value="">-- Pilih Brand Dulu --</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-2.5 sm:gap-3">
          <div>
            <label class="block text-slate-300 text-xs mb-1">Serial Number (SN)</label>
            <input type="text" name="serial_number" placeholder="Contoh: H2308123456" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-2.5 sm:px-3 py-2 text-white text-xs font-mono focus:outline-none focus:border-emerald-400">
          </div>
          <div>
            <label class="block text-slate-300 text-xs mb-1">MAC Address Utama</label>
            <input type="text" name="mac_address" placeholder="DC:2C:6E:XX:XX:XX" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-2.5 sm:px-3 py-2 text-white text-xs font-mono focus:outline-none focus:border-emerald-400">
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3">
          <div>
            <label class="block text-slate-300 text-xs mb-1">Status Awal</label>
            <select name="status" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-2.5 sm:px-3 py-2 text-white text-xs focus:outline-none focus:border-emerald-400">
              <option value="spare" selected>Spare (Gudang IT)</option>
              <option value="maintenance">Service / RMA</option>
              <option value="broken">Rusak</option>
            </select>
          </div>
          <div>
            <label class="block text-slate-300 text-xs mb-1">Kondisi Fisik</label>
            <select name="condition" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-2.5 sm:px-3 py-2 text-white text-xs focus:outline-none focus:border-emerald-400">
              <option value="good" selected>Baik (Good)</option>
              <option value="fair">Kurang Baik (Fair)</option>
              <option value="damaged">Rusak (Damaged)</option>
            </select>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <label class="block text-slate-300 text-xs mb-1">Harga Perolehan (Rp)</label>
            <input type="number" name="purchase_price" min="0" value="0" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-2.5 sm:px-3 py-2 text-white text-xs focus:outline-none focus:border-emerald-400">
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3">
          <div>
            <label class="block text-slate-300 text-xs mb-1">Tanggal Beli</label>
            <input type="date" name="purchase_date" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-2.5 sm:px-3 py-2 text-white text-xs focus:outline-none focus:border-emerald-400">
          </div>
          <div>
            <label class="block text-slate-300 text-xs mb-1">Akhir Garansi</label>
            <input type="date" name="warranty_end" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-2.5 sm:px-3 py-2 text-white text-xs focus:outline-none focus:border-emerald-400">
          </div>
          <div class="col-span-2 sm:col-span-1">
            <label class="block text-slate-300 text-xs mb-1">Vendor / Supplier</label>
            <input type="text" name="vendor_name" placeholder="Nama toko / distributor" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-2.5 sm:px-3 py-2 text-white text-xs focus:outline-none focus:border-emerald-400">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-2.5 sm:gap-3">
          <div>
            <label class="block text-slate-300 text-xs mb-1">Foto Fisik Perangkat</label>

<%- include('../partials/header', { pageTitle: 'Detail & Riwayat Aset' }) %>

<main class="p-4 sm:p-6 flex-1 w-full space-y-5">

  <!-- Header & Tombol Aksi -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-800 border border-slate-700 p-4 rounded-xl">
    <div class="flex items-center gap-3">
      <a href="/assets" class="p-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 transition">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
      </a>
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-base font-bold font-mono text-emerald-400"><%= asset.asset_code %></h2>
        </div>
        <span class="px-2 py-0.5 rounded text-[11px] font-bold uppercase bg-slate-900 border border-slate-600 text-slate-200">
          <%= asset.status %>
        </span>
        <p class="text-xs text-slate-400"><%= asset.type_name %> — <%= asset.brand_name || '-' %> <%= asset.model_name || '' %></p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2 text-xs">
      <% if (can('asset.write')) { %>
        <button type="button" onclick="openModal('modal-move-asset')"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-sky-500/15 hover:bg-sky-500/25 text-sky-400 border border-sky-500/30 font-semibold transition cursor-pointer">
          <i data-lucide="arrow-left-right" class="w-4 h-4"></i>
          <span>Mutasi Lokasi</span>
        </button>
        <button type="button" onclick="openModal('modal-maintenance-asset')"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-amber-500/15 hover:bg-amber-500/25 text-amber-400 border border-amber-500/30 font-semibold transition cursor-pointer">
          <i data-lucide="wrench" class="w-4 h-4"></i>
          <span>Catat Service</span>
        </button>
      <% } %>
    </div>
  </div>

  <!-- Grid Profil, Stiker QR & Dokumentasi Foto -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 items-stretch">
    <!-- Kolom Kiri (2/3): Informasi Spesifikasi & Stiker Label QR -->
    <div class="lg:col-span-2 flex flex-col gap-5">
      <div class="bg-slate-800 border border-slate-700 rounded-xl p-5 space-y-4 text-xs">
        <h3 class="text-sm font-semibold text-white border-b border-slate-700 pb-2.5">Spesifikasi & Administrasi Aset</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <span class="text-slate-400 block">Cabang Lokasi Saat Ini</span>
            <span class="text-white font-semibold">[<%= asset.branch_code %>] <%= asset.branch_name %></span>
          </div>
          <div>
            <span class="text-slate-400 block">Status Operasional Jaringan</span>
            <% if (asset.linked_hostname) { %>
              <a href="/devices/<%= asset.linked_device_id %>/visual" class="text-emerald-400 hover:underline font-semibold inline-flex items-center gap-1">
                <span>Terpasang pada: <%= asset.linked_hostname %></span>
                <i data-lucide="external-link" class="w-3 h-3"></i>
              </a>
            <% } else { %>
              <span class="text-amber-400">Belum terpasang di topologi.</span>
            <% } %>
          </div>
          <div>
            <span class="text-slate-400 block">Serial Number (SN)</span>
            <span class="text-white font-mono"><%= asset.serial_number || '-' %></span>
          </div>
          <div>
            <span class="text-slate-400 block">MAC Address</span>
            <span class="text-white font-mono"><%= asset.mac_address || '-' %></span>
          </div>
          <div>
            <span class="text-slate-400 block">Tanggal Beli & Vendor</span>
            <span class="text-white"><%= asset.purchase_date || '-' %> (<%= asset.vendor_name || '-' %>)</span>
          </div>
          <div>
            <span class="text-slate-400 block">Masa Garansi & Nilai Perolehan</span>
            <span class="text-white"><%= asset.warranty_end || '-' %> — Rp <%= (Number(asset.purchase_price) || 0).toLocaleString('id-ID') %></span>
          </div>
        </div>
        <div>
          <span class="text-slate-400 block">Catatan Kelengkapan</span>
          <p class="text-slate-200 bg-slate-900/70 border border-slate-700 rounded-lg p-3 mt-1"><%= asset.notes || 'Tidak ada catatan tambahan.' %></p>
        </div>
      </div>

      <!-- Kartu Tampilan Stiker Label Aset -->
      <div class="bg-slate-800 border border-slate-700 rounded-xl p-5 space-y-4 text-xs flex-1 flex flex-col justify-between">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-700 pb-2.5">
          <div>
            <h3 class="text-sm font-semibold text-amber-400 flex items-center gap-1.5">
              <i data-lucide="qr-code" class="w-4 h-4"></i>
              <span>Stiker Label QR Aset</span>
            </h3>
            <p class="text-[11px] text-slate-400 mt-0.5">Preview stiker fisik untuk ditempel pada perangkat.</p>
          </div>
          <div class="flex items-center gap-2">
            <select id="detail-inline-paper-size" onchange="renderDetailInlineSticker()"
              class="bg-slate-900 border border-slate-600 rounded-lg px-2.5 py-1.5 text-white text-xs focus:outline-none focus:border-amber-400">
              <option value="58x32" selected>58 x 32 mm</option>
              <option value="50x30">50 x 30 mm</option>
              <option value="60x40">60 x 40 mm</option>
              <option value="80x50">80 x 50 mm</option>
            </select>
            <button type="button" onclick="openDetailStickerModal()"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-600 text-slate-950 font-semibold text-xs transition cursor-pointer">
              <i data-lucide="printer" class="w-3.5 h-3.5"></i>
              <span>Cetak</span>
            </button>
          </div>
        </div>

        <div id="detail-inline-sticker-box"
          class="bg-slate-950/70 border border-dashed border-slate-700 rounded-xl py-6 px-4 flex-1 flex items-center justify-center overflow-x-auto">
          <span class="text-slate-400 text-xs">Memuat stiker QR...</span>
        </div>
      </div>
    </div>

    <!-- Kolom Kanan (1/3): Foto Fisik & Foto SN -->
    <div class="bg-slate-800 border border-slate-700 rounded-xl p-5 flex flex-col text-xs h-full">
      <h3 class="text-sm font-semibold text-white border-b border-slate-700 pb-2.5 mb-4 shrink-0">Dokumentasi Fisik</h3>
      <div class="flex-1 flex flex-col gap-4 min-h-0">
        <div class="flex-1 flex flex-col min-h-0">
          <span class="text-slate-400 block mb-1.5 shrink-0">Foto Fisik Perangkat</span>
          <% if (asset.physical_photo) { %>
            <div onclick="openAssetImageZoom('<%= asset.physical_photo %>', 'Foto Fisik - <%= asset.asset_code %>')"
              class="relative flex-1 min-h-[120px] rounded-lg overflow-hidden border border-slate-600 cursor-zoom-in group">
              <img src="<%= asset.physical_photo %>" alt="Foto Fisik" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
              <div class="absolute inset-0 bg-slate-950/50 opacity-0 group-hover:opacity-100 flex items-center justify-center transition">
                <span class="px-2.5 py-1 rounded bg-slate-900/90 text-emerald-400 font-semibold inline-flex items-center gap-1">
                  <i data-lucide="maximize-2" class="w-3.5 h-3.5"></i> Perbesar
                </span>
              </div>
            </div>
          <% } else { %>
            <div class="flex-1 min-h-[100px] w-full rounded-lg bg-slate-900 border border-slate-700 flex items-center justify-center text-slate-500">Belum ada foto fisik</div>
          <% } %>
        </div>

        <div class="flex-1 flex flex-col min-h-0">
          <span class="text-slate-400 block mb-1.5 shrink-0">Foto Stiker Serial Number</span>
          <% if (asset.sn_photo) { %>
            <div onclick="openAssetImageZoom('<%= asset.sn_photo %>', 'Foto Stiker SN - <%= asset.asset_code %>')"
              class="relative flex-1 min-h-[120px] rounded-lg overflow-hidden border border-slate-600 cursor-zoom-in group">
              <img src="<%= asset.sn_photo %>" alt="Foto SN" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
              <div class="absolute inset-0 bg-slate-950/50 opacity-0 group-hover:opacity-100 flex items-center justify-center transition">
                <span class="px-2.5 py-1 rounded bg-slate-900/90 text-emerald-400 font-semibold inline-flex items-center gap-1">
                  <i data-lucide="maximize-2" class="w-3.5 h-3.5"></i> Perbesar
                </span>
              </div>
            </div>
          <% } else { %>
            <div class="flex-1 min-h-[100px] w-full rounded-lg bg-slate-900 border border-slate-700 flex items-center justify-center text-slate-500">Belum ada foto SN</div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Riwayat Mutasi & Riwayat Service -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
    <!-- Timeline Mutasi -->
    <div class="bg-slate-800 border border-slate-700 rounded-xl p-5 space-y-3">
      <h3 class="text-sm font-semibold text-sky-400 border-b border-slate-700 pb-2.5">Riwayat Mutasi & Penempatan</h3>
      <div class="space-y-3 text-xs max-h-80 overflow-y-auto pr-1">
        <% if (movements.length === 0) { %>
          <p class="text-slate-500 py-4 text-center">Belum ada catatan mutasi.</p>
        <% } %>
        <% movements.forEach(m => { %>
          <div class="bg-slate-900/70 border border-slate-700/80 rounded-lg p-3 space-y-1">
            <div class="flex items-center justify-between">
              <span class="font-bold text-sky-400"><%= m.movement_type %></span>
              <span class="text-[11px] font-mono text-slate-400"><%= m.movement_date %></span>
            </div>
            <div class="text-slate-200">
              <%= m.from_branch_code ? `[${m.from_branch_code}]` : 'Registrasi' %> &rarr;
              <span class="font-semibold text-emerald-400"><%= m.to_branch_code ? `[${m.to_branch_code}]` : '-' %></span>
              (<%= m.to_location || '-' %>)
            </div>
            <% if (m.notes) { %>
              <div class="text-slate-400"><%= m.notes %></div>
            <% } %>
            <div class="text-[11px] text-slate-500">PIC: <%= m.moved_by %></div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Timeline Perbaikan / Service -->
    <div class="bg-slate-800 border border-slate-700 rounded-xl p-5 space-y-3">
      <h3 class="text-sm font-semibold text-amber-400 border-b border-slate-700 pb-2.5">Riwayat Perbaikan / Maintenance</h3>
      <div class="space-y-3 text-xs max-h-80 overflow-y-auto pr-1">
        <% if (maintenances.length === 0) { %>
          <p class="text-slate-500 py-4 text-center">Belum ada riwayat kerusakan atau perbaikan.</p>
        <% } %>
        <% maintenances.forEach(mt => { %>
          <div class="bg-slate-900/70 border border-slate-700/80 rounded-lg p-3 space-y-1">
            <div class="flex items-center justify-between">
              <span class="font-bold uppercase <%= mt.status === 'resolved' ? 'text-emerald-400' : 'text-amber-400' %>"><%= mt.status %></span>
              <span class="text-[11px] font-mono text-slate-400"><%= mt.issue_date %></span>
            </div>
            <div class="font-semibold text-white"><%= mt.problem_description %></div>
            <% if (mt.action_taken) { %>
              <div class="text-slate-300">Tindakan: <%= mt.action_taken %></div>
            <% } %>
            <div class="text-[11px] text-slate-400">
              Vendor: <%= mt.service_vendor %> | Biaya: Rp <%= (Number(mt.cost) || 0).toLocaleString('id-ID') %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

</main>

<!-- MODAL ZOOM FOTO DOKUMENTASI ASET -->
<div id="modal-asset-image-zoom" class="fixed inset-0 z-[60] hidden flex items-center justify-center p-4">
  <div onclick="closeModal('modal-asset-image-zoom')" class="fixed inset-0 bg-slate-950/85 backdrop-blur-sm"></div>
  <div class="relative bg-slate-800 border border-slate-700 rounded-2xl w-full max-w-3xl max-h-[90vh] flex flex-col shadow-2xl z-10 overflow-hidden">
    <div class="px-5 py-3.5 border-b border-slate-700 flex items-center justify-between">
      <h3 id="zoom-asset-img-title" class="text-sm font-semibold text-white truncate">Preview Foto</h3>
      <button type="button" onclick="closeModal('modal-asset-image-zoom')" class="text-slate-400 hover:text-white p-1 cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>
    <div class="p-4 bg-slate-950 flex-1 overflow-auto flex items-center justify-center">
      <img id="zoom-asset-img-src" src="" alt="Preview Foto" class="max-h-[65vh] w-auto object-contain rounded-lg border border-slate-800">
    </div>
    <div class="px-5 py-3.5 border-t border-slate-700 flex justify-end gap-2 bg-slate-800">
      <a id="zoom-asset-img-download" href="#" download
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-slate-950 text-xs font-semibold transition">
        <i data-lucide="download" class="w-4 h-4"></i>
        <span>Download</span>
      </a>
      <button type="button" onclick="closeModal('modal-asset-image-zoom')"
        class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-medium cursor-pointer">
        Tutup
      </button>
    </div>
  </div>
</div>

<!-- MODAL CETAK STIKER LABEL QR ASET -->
<div id="modal-qr-label" class="fixed inset-0 z-50 hidden flex items-center justify-center p-3 sm:p-4">
  <div onclick="closeModal('modal-qr-label')" class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm"></div>
  <div class="relative bg-slate-800 border border-slate-700 rounded-2xl w-full max-w-xl max-h-[90vh] flex flex-col shadow-2xl z-10 overflow-hidden">
    <div class="px-5 py-3.5 border-b border-slate-700 flex items-center justify-between shrink-0">
      <div>
        <h3 class="text-base font-semibold text-amber-400">Stiker Label Inventaris Aset</h3>
        <p class="text-[11px] text-slate-400">Tampilan preview persis sama dengan ukuran kertas label yang dicetak.</p>
      </div>
      <button type="button" onclick="closeModal('modal-qr-label')" class="text-slate-400 hover:text-white p-1 cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <div class="p-4 sm:p-5 overflow-y-auto space-y-4 flex-1">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-slate-900/70 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs">
        <label for="label-paper-size" class="text-slate-300 font-medium">Ukuran Kertas Label:</label>
        <select id="label-paper-size" onchange="renderDetailStickerModalPreview()"
          class="bg-slate-800 border border-slate-600 rounded-lg px-2.5 py-1.5 text-white text-xs focus:outline-none focus:border-amber-400">
          <option value="58x32" selected>58 x 32 mm (Standar Stiker)</option>
          <option value="50x30">50 x 30 mm (Thermal Kecil)</option>
          <option value="60x40">60 x 40 mm (Thermal Sedang)</option>
          <option value="80x50">80 x 50 mm (Label Besar)</option>
        </select>
      </div>

      <div id="sticker-preview-container"
        class="bg-slate-950/70 border border-dashed border-slate-700 rounded-xl p-4 flex flex-col items-center gap-4 max-h-[50vh] overflow-y-auto">
      </div>
    </div>

    <div class="px-5 py-3 border-t border-slate-700 bg-slate-800/95 flex items-center justify-end gap-2 shrink-0">
      <button type="button" onclick="closeModal('modal-qr-label')" class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs sm:text-sm cursor-pointer">Tutup</button>
      <button type="button" onclick="printDetailSticker()"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-amber-500 hover:bg-amber-600 text-slate-950 font-semibold text-xs sm:text-sm cursor-pointer">
        <i data-lucide="printer" class="w-4 h-4"></i>
        <span>Print Stiker</span>
      </button>
    </div>
  </div>
</div>

<% if (can('asset.write')) { %>
<!-- MODAL MUTASI ASET -->
<div id="modal-move-asset" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
  <div onclick="closeModal('modal-move-asset')" class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm"></div>
  <div class="relative bg-slate-800 border border-slate-700 rounded-2xl w-full max-w-md p-6 shadow-2xl z-10 space-y-4">
    <div class="flex items-center justify-between border-b border-slate-700 pb-3">
      <h3 class="text-base font-semibold text-sky-400">Mutasi / Perpindahan Aset</h3>
      <button type="button" onclick="closeModal('modal-move-asset')" class="text-slate-400 hover:text-white cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>
    <form action="/assets/<%= asset.id %>/move" method="POST" class="space-y-4 text-sm">
      <input type="hidden" name="redirect_to" value="/assets/<%= asset.id %>">
      <div>
        <label class="block text-slate-300 mb-1">Jenis Pergerakan *</label>
        <select name="movement_type" required class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white">
          <option value="MUTASI_CABANG">Mutasi Antar Cabang</option>
          <option value="PINDAH_RUANG">Pindah Ruangan / Rak</option>
          <option value="DISMANTLE">Tarik ke Gudang (Spare / Lepas dari Jaringan)</option>
          <option value="DISPOSAL">Afkir / Penghapusan Aset (Disposal)</option>
        </select>
      </div>
      <div>
        <label class="block text-slate-300 mb-1">Cabang Tujuan *</label>
        <select name="to_branch_id" required class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white">
          <% (typeof allBranches !== 'undefined' ? allBranches : branches).forEach(b => { %>
            <option value="<%= b.id %>" <%= String(b.id) === String(asset.branch_id) ? 'selected' : '' %>>
              [<%= b.branch_code %>] <%= b.branch_name %>
            </option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block text-slate-300 mb-1">Ruangan / Lokasi Tujuan</label>
        <input type="text" name="to_location" placeholder="Contoh: Ruang Server Lt. 2 / Gudang IT" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white">
      </div>
      <div>
        <label class="block text-slate-300 mb-1">Alasan / Keterangan</label>
        <textarea name="notes" rows="2" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white"></textarea>
      </div>
      <div class="pt-2 flex justify-end gap-2">
        <button type="button" onclick="closeModal('modal-move-asset')" class="px-4 py-2 rounded-lg bg-slate-700 text-slate-200 cursor-pointer">Batal</button>
        <button type="submit" class="px-4 py-2 rounded-lg bg-sky-500 text-slate-950 font-semibold cursor-pointer">Simpan Mutasi</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL CATAT PERBAIKAN / SERVICE -->
<div id="modal-maintenance-asset" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
  <div onclick="closeModal('modal-maintenance-asset')" class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm"></div>
  <div class="relative bg-slate-800 border border-slate-700 rounded-2xl w-full max-w-md p-6 shadow-2xl z-10 space-y-4">
    <div class="flex items-center justify-between border-b border-slate-700 pb-3">
      <h3 class="text-base font-semibold text-amber-400">Catat Service / Perbaikan Aset</h3>
      <button type="button" onclick="closeModal('modal-maintenance-asset')" class="text-slate-400 hover:text-white cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>
    <form action="/assets/<%= asset.id %>/maintenance" method="POST" class="space-y-3 text-sm">
      <input type="hidden" name="redirect_to" value="/assets/<%= asset.id %>">
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-slate-300 mb-1">Tanggal Lapor *</label>
          <input type="date" name="issue_date" required value="<%= new Date().toISOString().split('T')[0] %>" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white">
        </div>
        <div>
          <label class="block text-slate-300 mb-1">Tanggal Selesai</label>
          <input type="date" name="resolved_date" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white">
        </div>
      </div>
      <div>
        <label class="block text-slate-300 mb-1">Keluhan / Kerusakan *</label>
        <textarea name="problem_description" rows="2" required placeholder="Contoh: Port 1-4 mati total / Adaptor rusak" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white"></textarea>
      </div>
      <div>
        <label class="block text-slate-300 mb-1">Tindakan Perbaikan</label>
        <textarea name="action_taken" rows="2" placeholder="Contoh: Penggantian adaptor & reset konfigurasi" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white"></textarea>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-slate-300 mb-1">Pelaksana / Vendor</label>
          <input type="text" name="service_vendor" value="Internal IT" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white">
        </div>
        <div>
          <label class="block text-slate-300 mb-1">Biaya (Rp)</label>
          <input type="number" name="cost" min="0" value="0" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white">
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-slate-300 mb-1">Status Perbaikan</label>
          <select name="maintenance_status" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white">
            <option value="open">Proses (Open)</option>
            <option value="resolved">Selesai (Resolved)</option>
            <option value="unrepairable">Tidak Bisa Diperbaiki</option>
          </select>
        </div>
        <div>
          <label class="block text-slate-300 mb-1">Update Status Aset</label>
          <select name="asset_status_after" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white">
            <option value="">-- Tetap --</option>
            <option value="maintenance">Service / RMA</option>
            <option value="spare">Kembali ke Gudang (Spare)</option>
            <option value="active">Kembali Aktif</option>
            <option value="broken">Rusak Total (Broken)</option>
          </select>
        </div>
      </div>
      <div class="pt-2 flex justify-end gap-2">
        <button type="button" onclick="closeModal('modal-maintenance-asset')" class="px-4 py-2 rounded-lg bg-slate-700 text-slate-200 cursor-pointer">Batal</button>
        <button type="submit" class="px-4 py-2 rounded-lg bg-amber-500 text-slate-950 font-semibold cursor-pointer">Simpan Log</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<script src="/js/qrcode.min.js"></script>
<script>
  const DETAIL_ASSET_STICKER = <%- JSON.stringify({
    id: asset.id,
    code: asset.asset_code,
    deviceName: ((asset.brand_name || '') + ' ' + (asset.model_name || asset.type_name || '')).trim(),
    sn: asset.serial_number || '-',
    branchCode: asset.branch_code || '-'
  }) %>;
  const ORG_NAME_FOR_STICKER = <%- JSON.stringify((typeof settings !== 'undefined' && settings.organization_name) ? settings.organization_name : 'IT ASSET') %>;

  const LABEL_PRESETS = {
    '58x32': { widthMm: 58, heightMm: 32, qrMm: 18, codePt: 6, textPt: 6, metaPt: 5.5, scalePreview: 1.35 },
    '50x30': { widthMm: 50, heightMm: 30, qrMm: 16, codePt: 6, textPt: 5.3, metaPt: 5, scalePreview: 1.45 },
    '60x40': { widthMm: 60, heightMm: 40, qrMm: 22, codePt: 7.8, textPt: 6.8, metaPt: 6.2, scalePreview: 1.3 },
    '80x50': { widthMm: 80, heightMm: 50, qrMm: 28, codePt: 9.5, textPt: 8.2, metaPt: 7.5, scalePreview: 1.15 }
  };

  let cachedDetailQrDataUrl = null;

  function openAssetImageZoom(src, title) {
    document.getElementById('zoom-asset-img-title').textContent = title;
    document.getElementById('zoom-asset-img-src').src = src;
    document.getElementById('zoom-asset-img-download').href = src;
    openModal('modal-asset-image-zoom');
  }

  function escapeHtml(str) {
    return String(str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function generateQrImageDataUrl(text, sizePx = 200) {
    return new Promise((resolve) => {
      if (typeof QRCode === 'undefined') {
        resolve(null);
        return;
      }

      const tempDiv = document.createElement('div');
      tempDiv.style.position = 'fixed';
      tempDiv.style.left = '-9999px';
      document.body.appendChild(tempDiv);

      new QRCode(tempDiv, {
        text,
        width: sizePx,
        height: sizePx,
        colorDark: '#000000',
        colorLight: '#ffffff',
        correctLevel: QRCode.CorrectLevel.M
      });

      setTimeout(() => {
        const canvas = tempDiv.querySelector('canvas');
        const img = tempDiv.querySelector('img');
        let dataUrl = null;
        if (canvas) {
          dataUrl = canvas.toDataURL('image/png');
        } else if (img && img.src) {
          dataUrl = img.src;
        }
        tempDiv.remove();
        resolve(dataUrl);
      }, 45);
    });
  }

  function buildSingleStickerInnerHtml(d, p) {
    const qrImgTag = d.qrDataUrl
      ? `<img src="${d.qrDataUrl}" style="width:${p.qrMm}mm;height:${p.qrMm}mm;display:block;object-fit:contain;" />`
      : `<div style="width:${p.qrMm}mm;height:${p.qrMm}mm;border:1px solid #000;display:flex;align-items:center;justify-content:center;font-size:6pt;text-align:center;">NO QR</div>`;

    return `
      <div style="
        width: 100%;
        height: 100%;
        border: 1.2pt solid #000;
        border-radius: 1.5mm;
        padding: 1.4mm 1.8mm;
        display: flex;
        align-items: center;
        gap: 1.8mm;
        overflow: hidden;
        background: #fff;
        color: #000;
        font-family: Arial, Helvetica, sans-serif;
        box-sizing: border-box;
      ">
        <div style="flex: 0 0 auto; display: flex; align-items: center; justify-content: center;">
          ${qrImgTag}
        </div>
        <div style="flex: 1 1 auto; min-width: 0; overflow: hidden; display: flex; flex-direction: column; justify-content: center; gap: 0.5mm; text-align: left;">
          <div style="
            font-size: ${p.metaPt}pt;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.2px;
            border-bottom: 0.7pt solid #000;
            padding-bottom: 0.3mm;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
          ">${escapeHtml(ORG_NAME_FOR_STICKER)}</div>
          <div style="
            font-size: ${p.codePt}pt;
            font-weight: 700;
            line-height: 1.15;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
          ">${escapeHtml(d.code)}</div>
          <div style="
            font-size: ${p.textPt}pt;
            font-weight: 700;
            line-height: 1.15;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
          ">${escapeHtml(d.deviceName || '-')}</div>
          <div style="
            font-size: ${p.metaPt}pt;
            font-weight: 700;
            line-height: 1.15;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
          ">SN: ${escapeHtml(d.sn || '-')}</div>
        </div>
      </div>
    `;
  }

  async function ensureDetailQrDataUrl() {
    if (cachedDetailQrDataUrl) return cachedDetailQrDataUrl;
    const qrText = String(DETAIL_ASSET_STICKER.code || '').trim();
    cachedDetailQrDataUrl = await generateQrImageDataUrl(qrText, 200);
    return cachedDetailQrDataUrl;
  }

  async function renderDetailInlineSticker() {
    const box = document.getElementById('detail-inline-sticker-box');
    if (!box) return;

    const qrDataUrl = await ensureDetailQrDataUrl();
    const sizeKey = document.getElementById('detail-inline-paper-size')?.value || '58x32';
    const p = LABEL_PRESETS[sizeKey] || LABEL_PRESETS['58x32'];
    const extraY = (p.heightMm * (p.scalePreview - 1)) / 2;

    box.innerHTML = `
      <div style="
        width: ${p.widthMm}mm;
        height: ${p.heightMm}mm;
        padding: 1.2mm;
        background: #fff;
        border-radius: 2mm;
        box-shadow: 0 4px 14px rgba(0,0,0,0.45);
        transform: scale(${p.scalePreview});
        transform-origin: center center;
        margin: ${extraY}mm 0;
        box-sizing: border-box;
        flex-shrink: 0;
      ">
        ${buildSingleStickerInnerHtml({ ...DETAIL_ASSET_STICKER, qrDataUrl }, p)}
      </div>
    `;
  }

  async function renderDetailStickerModalPreview() {
    const container = document.getElementById('sticker-preview-container');
    if (!container) return;

    const qrDataUrl = await ensureDetailQrDataUrl();
    const sizeKey = document.getElementById('label-paper-size')?.value || '58x32';
    const p = LABEL_PRESETS[sizeKey] || LABEL_PRESETS['58x32'];
    const extraY = (p.heightMm * (p.scalePreview - 1)) / 2;

    container.innerHTML = `
      <div style="
        width: ${p.widthMm}mm;
        height: ${p.heightMm}mm;
        padding: 1.2mm;
        background: #fff;
        border-radius: 2mm;
        box-shadow: 0 4px 14px rgba(0,0,0,0.45);
        transform: scale(${p.scalePreview});
        transform-origin: center center;
        margin: ${extraY}mm 0;
        box-sizing: border-box;
        flex-shrink: 0;
      ">
        ${buildSingleStickerInnerHtml({ ...DETAIL_ASSET_STICKER, qrDataUrl }, p)}
      </div>
    `;
  }

  function openDetailStickerModal() {
    const inlineSize = document.getElementById('detail-inline-paper-size')?.value || '58x32';
    const modalSelect = document.getElementById('label-paper-size');
    if (modalSelect) modalSelect.value = inlineSize;
    openModal('modal-qr-label');
    renderDetailStickerModalPreview();
  }

  async function printDetailSticker() {
    const qrDataUrl = await ensureDetailQrDataUrl();
    const sizeKey = document.getElementById('label-paper-size')?.value || '58x32';
    const p = LABEL_PRESETS[sizeKey] || LABEL_PRESETS['58x32'];

    const win = window.open('', '_blank', 'width=460,height=360');
    win.document.write(`
      <!DOCTYPE html>
      <html>
        <head>
          <meta charset="UTF-8">
          <title>Cetak Label ${escapeHtml(DETAIL_ASSET_STICKER.code)}</title>
          <style>
            @page {
              size: ${p.widthMm}mm ${p.heightMm}mm;
              margin: 0mm;
            }
            * {
              box-sizing: border-box;
              margin: 0;
              padding: 0;
              -webkit-print-color-adjust: exact;
              print-color-adjust: exact;
            }
            html, body {
              width: ${p.widthMm}mm;
              background: #fff;
              color: #000;
              font-family: Arial, Helvetica, sans-serif;
            }
            .label-page {
              width: ${p.widthMm}mm;
              height: ${p.heightMm}mm;
              padding: 1.2mm;
              overflow: hidden;
              display: flex;
              align-items: center;
              justify-content: center;
            }
          </style>
        </head>
        <body>
          <div class="label-page">
            ${buildSingleStickerInnerHtml({ ...DETAIL_ASSET_STICKER, qrDataUrl }, p)}
          </div>
          <script>
            window.onload = function() {
              setTimeout(function() {
                window.focus();
                window.print();
                window.close();
              }, 150);
            };
          <\/script>
        </body>
      </html>
    `);
    win.document.close();
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderDetailInlineSticker();

    const serverError = <%- JSON.stringify(typeof errorMsg !== 'undefined' ? errorMsg : null) %>;
    const serverSuccess = <%- JSON.stringify(typeof successMsg !== 'undefined' ? successMsg : null) %>;

    if (serverError) {
      showAppAlert('error', 'Terjadi Kesalahan', serverError);
    } else if (serverSuccess) {
      showAppAlert('success', 'Berhasil', serverSuccess);
    }
  });
</script>

<%- include('../partials/footer') %>
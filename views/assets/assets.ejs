  <div class="relative bg-slate-800 border border-slate-700 rounded-2xl w-full max-w-2xl max-h-[88vh] flex flex-col shadow-2xl z-10 overflow-hidden">
    <div class="px-5 py-3 border-b border-slate-700 flex items-center justify-between">
      <h4 id="zoom-edit-photo-title" class="text-sm font-semibold text-white truncate">Preview Foto Aset</h4>
      <button type="button" onclick="closeModal('modal-zoom-edit-photo')" class="text-slate-400 hover:text-white p-1 cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <div class="p-4 bg-slate-950 flex-1 overflow-auto flex items-center justify-center">
      <img id="zoom-edit-photo-img" src="" alt="Perbesar Foto" class="max-h-[65vh] w-auto object-contain rounded-lg border border-slate-800">
    </div>

    <div id="zoom-edit-photo-delete-confirm" class="hidden px-5 py-3 bg-rose-950/80 border-t border-rose-500/40 flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs bg-slate-800">
      <span class="text-rose-200 font-medium">Yakin ingin menghapus foto ini secara permanen?</span>
      <form id="zoom-edit-photo-delete-form" method="POST" class="flex items-center gap-2 shrink-0">
        <input type="hidden" name="photo_type" id="zoom-edit-photo-type-input" value="">
        <button type="button" onclick="toggleZoomEditPhotoDeleteConfirm(false)" class="px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 cursor-pointer">
          Batal
        </button>
        <button type="submit" class="px-3.5 py-1.5 rounded-lg bg-rose-500 hover:bg-rose-600 text-white font-semibold cursor-pointer">
          Ya, Hapus Foto
        </button>
      </form>
    </div>

    <div id="zoom-edit-photo-footer" class="px-5 py-3 border-t border-slate-700 flex items-center justify-between gap-2 bg-slate-800">
      <% if (can('asset.write')) { %>
        <button type="button" onclick="toggleZoomEditPhotoDeleteConfirm(true)"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-rose-500/15 hover:bg-rose-500/25 text-rose-400 border border-rose-500/30 text-xs font-semibold transition cursor-pointer">
          <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
          <span>Hapus</span>
        </button>
      <% } else { %>
        <div></div>
      <% } %>

      <div class="flex items-center gap-2">
        <a id="zoom-edit-photo-download" href="#" download
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-slate-950 text-xs font-semibold transition">
          <i data-lucide="download" class="w-3.5 h-3.5"></i>
          <span>Download</span>
        </a>
        <button type="button" onclick="closeModal('modal-zoom-edit-photo')"
          class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-medium cursor-pointer">
          Tutup
        </button>
      </div>
    </div>
  </div>
</div>

<!-- =========================================================
     MODAL CETAK STIKER LABEL QR ASET (SATUAN & MASSAL - WYSIWYG)
     ========================================================= -->
<div id="modal-qr-label" class="fixed inset-0 z-50 hidden flex items-center justify-center p-3 sm:p-4">
  <div onclick="closeModal('modal-qr-label')" class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm"></div>
  <div class="relative bg-slate-800 border border-slate-700 rounded-2xl w-full max-w-xl max-h-[90vh] flex flex-col shadow-2xl z-10 overflow-hidden">
    <div class="px-5 py-3.5 border-b border-slate-700 flex items-center justify-between shrink-0">
      <div>
        <h3 class="text-base font-semibold text-amber-400" id="qr-modal-title">Stiker Label Inventaris Aset</h3>
        <p class="text-[11px] text-slate-400" id="qr-modal-subtitle">Tampilan preview persis sama dengan ukuran kertas label yang dicetak.</p>
      </div>
      <button type="button" onclick="closeModal('modal-qr-label')" class="text-slate-400 hover:text-white p-1 cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <div class="p-4 sm:p-5 overflow-y-auto space-y-4 flex-1">
      <!-- Pilihan Ukuran Kertas Label -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-slate-900/70 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs">
        <label for="label-paper-size" class="text-slate-300 font-medium">Ukuran Kertas Label:</label>
        <select id="label-paper-size" onchange="renderStickerPreviewList()"
          class="bg-slate-800 border border-slate-600 rounded-lg px-2.5 py-1.5 text-white text-xs focus:outline-none focus:border-amber-400">
          <option value="58x32" selected>58 x 32 mm (Standar Stiker)</option>
          <option value="50x30">50 x 30 mm (Thermal Kecil)</option>
          <option value="60x40">60 x 40 mm (Thermal Sedang)</option>
          <option value="80x50">80 x 50 mm (Label Besar)</option>

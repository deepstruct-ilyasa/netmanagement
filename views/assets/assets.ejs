<!-- Offline QRCode Library (Pastikan file qrcode.min.js ada di folder public/js/) -->
<script src="/js/qrcode.min.js"></script>

<script>
  const allAssetBrands = <%- JSON.stringify(typeof brands !== 'undefined' ? brands : []) %>;
  const allAssetModels = <%- JSON.stringify(typeof models !== 'undefined' ? models : []) %>;
  const ORG_NAME_FOR_STICKER = <%- JSON.stringify(settings.organization_name || 'IT ASSET') %>;
  const AUDIT_PREFILL_ITEM = <%- JSON.stringify(typeof auditPrefillItem !== 'undefined' ? auditPrefillItem : null) %>;
  const INITIAL_ERROR_MSG = <%- JSON.stringify(typeof errorMsg !== 'undefined' ? errorMsg : '') %>;
  const INITIAL_SUCCESS_MSG = <%- JSON.stringify(typeof successMsg !== 'undefined' ? successMsg : '') %>;

  const selectedAssetsMap = new Map();
  let preparedStickersList = [];
  let currentEditingAssetId = null;

  function triggerFlashPopupModal() {
    if (typeof window.showAppAlert !== 'function') return;

    if (INITIAL_ERROR_MSG) {
      window.showAppAlert('error', INITIAL_ERROR_MSG, 'Gagal Memproses Aset');
    } else if (INITIAL_SUCCESS_MSG) {
      window.showAppAlert('success', INITIAL_SUCCESS_MSG, 'Berhasil');
    }

    if ((INITIAL_ERROR_MSG || INITIAL_SUCCESS_MSG) && window.history && window.history.replaceState) {
      const cleanUrl = new URL(window.location.href);
      cleanUrl.searchParams.delete('error');
      cleanUrl.searchParams.delete('err');
      cleanUrl.searchParams.delete('success');
      cleanUrl.searchParams.delete('msg');
      window.history.replaceState({}, document.title, cleanUrl.pathname + cleanUrl.search);
    }
  }

  function autoSelectPrefillTaxonomy() {
    if (!AUDIT_PREFILL_ITEM) return;

    const rawType = String(AUDIT_PREFILL_ITEM.unregistered_type || '').trim().toLowerCase();
    const rawBrandModel = `${AUDIT_PREFILL_ITEM.unregistered_brand_model || ''} ${AUDIT_PREFILL_ITEM.unregistered_name || ''}`.toLowerCase();

    const typeSelect = document.getElementById('add_asset_type_id');
    if (typeSelect && rawType) {
      const matchedTypeOpt = Array.from(typeSelect.options).find(opt =>
        opt.value && opt.textContent.trim().toLowerCase().includes(rawType)
      );
      if (matchedTypeOpt) {
        typeSelect.value = matchedTypeOpt.value;
      }
    }

    let matchedBrandId = '';
    if (rawBrandModel) {
      const foundBrand = allAssetBrands.find(b =>
        rawBrandModel.includes(String(b.brand_name || '').trim().toLowerCase())
      );
      if (foundBrand) {
        matchedBrandId = String(foundBrand.id);
        if (typeSelect && !typeSelect.value) {
          const modelWithBrand = allAssetModels.find(m => String(m.brand_id) === matchedBrandId);
          if (modelWithBrand) typeSelect.value = String(modelWithBrand.device_type_id);
        }
      }
    }

    let matchedModelId = '';
    if (rawBrandModel) {
      const foundModel = allAssetModels.find(m =>
        rawBrandModel.includes(String(m.model_name || '').trim().toLowerCase())
      );
      if (foundModel) {
        matchedModelId = String(foundModel.id);
        if (!matchedBrandId) matchedBrandId = String(foundModel.brand_id);
        if (typeSelect && !typeSelect.value) typeSelect.value = String(foundModel.device_type_id);
      }
    }

    onAssetDeviceTypeChange('add_asset', matchedBrandId, matchedModelId);
    openModal('modal-add-asset');
  }

  document.addEventListener('DOMContentLoaded', () => {
    onAssetDeviceTypeChange('add_asset');
    loadAssetState();
    renderAssetsTable();
    autoSelectPrefillTaxonomy();
    triggerFlashPopupModal();
  });

  // =========================================================
  // CASCADING KETAT: JENIS PERANGKAT -> BRAND -> MODEL
  // =========================================================
  function onAssetDeviceTypeChange(prefix, selectedBrandId = '', selectedModelId = '') {
    const typeSelect = document.getElementById(`${prefix}_type_id`);
    const brandSelect = document.getElementById(`${prefix}_brand_id`);
    const modelSelect = document.getElementById(`${prefix}_model_id`);

    if (!typeSelect || !brandSelect || !modelSelect) return;

    const typeId = typeSelect.value;

    brandSelect.innerHTML = '';
    modelSelect.innerHTML = '<option value="">-- Pilih Brand Dulu --</option>';
    modelSelect.disabled = true;

    if (!typeId) {
      brandSelect.innerHTML = '<option value="">-- Pilih Jenis Dulu --</option>';
      brandSelect.disabled = true;
      return;
    }

    const matchingModelsForType = allAssetModels.filter(m =>
      String(m.device_type_id) === String(typeId)
    );
    const brandIdsForType = new Set(matchingModelsForType.map(m => String(m.brand_id)));

    const filteredBrands = allAssetBrands.filter(b =>
      brandIdsForType.has(String(b.id)) || (selectedBrandId && String(b.id) === String(selectedBrandId))
    );

    if (filteredBrands.length === 0) {
      brandSelect.innerHTML = '<option value="">-- Belum ada brand/model --</option>';
      brandSelect.disabled = true;
      return;
    }

    brandSelect.disabled = false;

    const defaultBrandOpt = document.createElement('option');
    defaultBrandOpt.value = '';
    defaultBrandOpt.textContent = '-- Pilih Brand / Merk --';
    brandSelect.appendChild(defaultBrandOpt);

    filteredBrands.forEach(b => {
      const opt = document.createElement('option');
      opt.value = b.id;
      opt.textContent = b.brand_name;
      if (selectedBrandId && String(b.id) === String(selectedBrandId)) {
        opt.selected = true;
      }
      brandSelect.appendChild(opt);
    });

    if (selectedBrandId) {
      onAssetBrandChange(prefix, selectedModelId);
    }
  }

  function onAssetBrandChange(prefix, selectedModelId = '') {
    const typeSelect = document.getElementById(`${prefix}_type_id`);
    const brandSelect = document.getElementById(`${prefix}_brand_id`);
    const modelSelect = document.getElementById(`${prefix}_model_id`);

    if (!typeSelect || !brandSelect || !modelSelect) return;

    const typeId = typeSelect.value;
    const brandId = brandSelect.value;

    modelSelect.innerHTML = '';

    if (!typeId || !brandId) {
      modelSelect.innerHTML = '<option value="">-- Pilih Brand Dulu --</option>';
      modelSelect.disabled = true;
      return;
    }

    const filteredModels = allAssetModels.filter(m =>
      String(m.device_type_id) === String(typeId) &&
      String(m.brand_id) === String(brandId)
    );

    if (filteredModels.length === 0) {
      modelSelect.innerHTML = '<option value="">-- Belum ada model --</option>';
      modelSelect.disabled = true;
      return;
    }

    modelSelect.disabled = false;

    const defaultModelOpt = document.createElement('option');
    defaultModelOpt.value = '';
    defaultModelOpt.textContent = '-- Pilih Model / Type --';
    modelSelect.appendChild(defaultModelOpt);

    filteredModels.forEach(m => {
      const opt = document.createElement('option');
      opt.value = m.id;
      opt.textContent = m.model_name;
      if (selectedModelId && String(m.id) === String(selectedModelId)) {
        opt.selected = true;
      }
      modelSelect.appendChild(opt);
    });
  }

  function openAddAssetModal() {
    const typeSelect = document.getElementById('add_asset_type_id');
    if (typeSelect) {
      typeSelect.value = '';
      onAssetDeviceTypeChange('add_asset');
    }
    openModal('modal-add-asset');
  }

  // =========================================================
  // CHECKBOX SELECTION UNTUK CETAK MASSAL
  // =========================================================
  function onAssetCheckboxChange(checkboxEl) {
    const id = String(checkboxEl.getAttribute('data-asset-id'));
    const row = checkboxEl.closest('tr');

    if (checkboxEl.checked) {
      const data = JSON.parse(checkboxEl.getAttribute('data-qr-asset'));
      selectedAssetsMap.set(id, data);
      if (row) row.classList.add('bg-amber-500/10');
    } else {
      selectedAssetsMap.delete(id);
      if (row) row.classList.remove('bg-amber-500/10');
    }

    syncSelectionUI();
  }

  function toggleSelectAllVisible(checked) {
    const visibleCheckboxes = Array.from(document.querySelectorAll('#assets-table-body .asset-row:not(.hidden) .asset-select-checkbox'));
    visibleCheckboxes.forEach(cb => {
      cb.checked = checked;
      onAssetCheckboxChange(cb);
    });
  }

  function syncSelectionUI() {
    const toolbar = document.getElementById('bulk-print-toolbar');
    const countEl = document.getElementById('bulk-selected-count');
    const totalSelected = selectedAssetsMap.size;

    if (countEl) countEl.textContent = String(totalSelected);
    if (toolbar) {
      if (totalSelected > 0) {
        toolbar.classList.remove('hidden');
        toolbar.classList.add('inline-flex');
      } else {
        toolbar.classList.add('hidden');
        toolbar.classList.remove('inline-flex');
      }
    }

    const masterCb = document.getElementById('select-all-visible-assets');
    if (masterCb) {
      const visibleCheckboxes = Array.from(document.querySelectorAll('#assets-table-body .asset-row:not(.hidden) .asset-select-checkbox'));
      if (visibleCheckboxes.length === 0) {
        masterCb.checked = false;
        masterCb.indeterminate = false;
      } else {
        const checkedCount = visibleCheckboxes.filter(cb => cb.checked).length;
        masterCb.checked = checkedCount === visibleCheckboxes.length;
        masterCb.indeterminate = checkedCount > 0 && checkedCount < visibleCheckboxes.length;
      }
    }
  }

  // =========================================================
  // TABEL, FILTER STATUS, SEARCH & PAGINATION
  // =========================================================
  const ASSET_STATE_KEY = 'netmgmt_assets_table_state';
  let assetState = { page: 1, perPage: 8, status: 'all', search: '' };

  function loadAssetState() {
    const selectEl = document.getElementById('asset-per-page');
    const searchEl = document.getElementById('asset-search-input');

    const validOptions = selectEl
      ? Array.from(selectEl.options).map(opt => parseInt(opt.value, 10))
      : [8, 25, 50, 100];
    const defaultPerPage = validOptions[0] || 8;

    try {
      const saved = JSON.parse(sessionStorage.getItem(ASSET_STATE_KEY));
      if (saved) assetState = { ...assetState, ...saved };
    } catch (e) {}

    if (!validOptions.includes(Number(assetState.perPage))) {
      assetState.perPage = defaultPerPage;
      saveAssetState();
    }

    if (selectEl) selectEl.value = String(assetState.perPage);
    if (searchEl) searchEl.value = assetState.search || '';
    updateStatusPillsUI();
  }

  function saveAssetState() {
    sessionStorage.setItem(ASSET_STATE_KEY, JSON.stringify(assetState));
  }

  function updateStatusPillsUI() {
    document.querySelectorAll('.asset-status-pill').forEach(btn => {
      const isMatch = btn.getAttribute('data-status-btn') === assetState.status;
      btn.className = isMatch
        ? 'asset-status-pill px-3 py-1.5 rounded-lg font-semibold bg-emerald-500 text-slate-950 cursor-pointer transition'
        : 'asset-status-pill px-3 py-1.5 rounded-lg font-medium bg-slate-800 text-slate-300 border border-slate-700 hover:bg-slate-700 cursor-pointer transition';
    });
  }

  function setAssetStatusFilter(status) {
    assetState.status = status;
    assetState.page = 1;
    saveAssetState();
    updateStatusPillsUI();
    renderAssetsTable();
  }

  function onAssetSearch(val) {
    assetState.search = val;
    assetState.page = 1;
    saveAssetState();
    renderAssetsTable();
  }

  function changeAssetPerPage(val) {
    assetState.perPage = parseInt(val, 10) || 8;
    assetState.page = 1;
    saveAssetState();
    renderAssetsTable();
  }

  function goToAssetPage(page) {
    assetState.page = page;
    saveAssetState();
    renderAssetsTable();
  }

  function renderAssetsTable() {
    const rows = Array.from(document.querySelectorAll('#assets-table-body .asset-row'));
    const noResultRow = document.getElementById('assets-no-result');
    const footer = document.getElementById('assets-pagination-footer');

    if (rows.length === 0) {
      if (footer) footer.classList.add('hidden');
      return;
    }

    const query = (assetState.search || '').trim().toLowerCase();
    const matchedRows = [];

    rows.forEach(row => {
      const rowStatus = row.getAttribute('data-status');
      const matchStatus = assetState.status === 'all' || rowStatus === assetState.status;
      const matchSearch = !query || row.textContent.toLowerCase().includes(query);
      if (matchStatus && matchSearch) {
        matchedRows.push(row);
      } else {
        row.classList.add('hidden');
      }
    });

    const totalItems = matchedRows.length;
    const totalPages = Math.max(1, Math.ceil(totalItems / assetState.perPage));
    if (assetState.page > totalPages) {
      assetState.page = totalPages;
      saveAssetState();
    }

    const startIdx = (assetState.page - 1) * assetState.perPage;
    const endIdx = startIdx + assetState.perPage;

    matchedRows.forEach((row, idx) => {
      const isVisible = idx >= startIdx && idx < endIdx;
      row.classList.toggle('hidden', !isVisible);
      if (isVisible) {
        const noCell = row.querySelector('.asset-no-cell');
        if (noCell) noCell.textContent = idx + 1;
      }
    });

    if (noResultRow) {
      noResultRow.classList.toggle('hidden', totalItems > 0);
    }

    renderAssetPagination({
      infoEl: document.getElementById('assets-page-info'),
      buttonsEl: document.getElementById('assets-page-buttons'),
      totalItems,
      page: assetState.page,
      perPage: assetState.perPage,
      onPageClick: goToAssetPage
    });

    syncSelectionUI();
  }

  function renderAssetPagination({ infoEl, buttonsEl, totalItems, page, perPage, onPageClick }) {
    if (!infoEl || !buttonsEl) return;
    const totalPages = Math.max(1, Math.ceil(totalItems / perPage));
    const from = totalItems === 0 ? 0 : (page - 1) * perPage + 1;
    const to = Math.min(page * perPage, totalItems);
    infoEl.textContent = `Menampilkan ${from} - ${to} dari ${totalItems} data`;

    buttonsEl.innerHTML = '';
    if (totalItems === 0) return;

    const createBtn = (label, targetPage, disabled, active) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = label;
      btn.disabled = disabled;
      btn.className = active
        ? 'px-2.5 py-1 rounded-md bg-emerald-500 text-slate-950 font-bold cursor-pointer'
        : disabled
          ? 'px-2.5 py-1 rounded-md bg-slate-800/50 text-slate-600 border border-slate-700/50 cursor-not-allowed'
          : 'px-2.5 py-1 rounded-md bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition cursor-pointer';
      if (!disabled && !active) {
        btn.addEventListener('click', () => onPageClick(targetPage));
      }
      return btn;
    };

    buttonsEl.appendChild(createBtn('‹ Prev', page - 1, page <= 1, false));

    const pages = [];
    for (let p = 1; p <= totalPages; p++) {
      if (p === 1 || p === totalPages || (p >= page - 1 && p <= page + 1)) {
        pages.push(p);
      } else if (pages[pages.length - 1] !== '...') {
        pages.push('...');
      }
    }

    pages.forEach(p => {
      if (p === '...') {
        const span = document.createElement('span');
        span.textContent = '...';
        span.className = 'px-1.5 text-slate-500';
        buttonsEl.appendChild(span);
      } else {
        buttonsEl.appendChild(createBtn(String(p), p, false, p === page));
      }
    });

    buttonsEl.appendChild(createBtn('Next ›', page + 1, page >= totalPages, false));
  }

  function toggleAssetCodeInput(mode) {
    const inp = document.getElementById('manual_asset_code_input');
    if (!inp) return;
    inp.disabled = mode !== 'manual';
    if (mode === 'manual') inp.focus();
  }

  function openEditAssetModal(asset) {
    currentEditingAssetId = asset.id;
    document.getElementById('edit-asset-form').action = `/assets/${asset.id}/update`;
    document.getElementById('edit_asset_code').value = asset.asset_code || '';
    document.getElementById('edit_asset_type_id').value = asset.device_type_id || '';

    onAssetDeviceTypeChange('edit_asset', asset.brand_id || '', asset.model_id || '');

    document.getElementById('edit_asset_sn').value = asset.serial_number || '';
    document.getElementById('edit_asset_mac').value = asset.mac_address || '';
    document.getElementById('edit_asset_status').value = asset.status || 'spare';
    document.getElementById('edit_asset_condition').value = asset.condition || 'good';
    document.getElementById('edit_asset_price').value = asset.purchase_price || 0;
    document.getElementById('edit_asset_purchase_date').value = asset.purchase_date || '';
    document.getElementById('edit_asset_warranty_end').value = asset.warranty_end || '';
    document.getElementById('edit_asset_vendor').value = asset.vendor_name || '';
    document.getElementById('edit_asset_notes').value = asset.notes || '';

    const physWrap = document.getElementById('edit_physical_photo_preview_wrap');
    const physImg = document.getElementById('edit_physical_photo_preview');
    if (physWrap && physImg) {
      if (asset.physical_photo) {
        physImg.src = asset.physical_photo;
        physWrap.classList.remove('hidden');
        physWrap.classList.add('flex');
      } else {
        physImg.src = '';
        physWrap.classList.add('hidden');
        physWrap.classList.remove('flex');
      }
    }

    const snWrap = document.getElementById('edit_sn_photo_preview_wrap');
    const snImg = document.getElementById('edit_sn_photo_preview');
    if (snWrap && snImg) {
      if (asset.sn_photo) {
        snImg.src = asset.sn_photo;
        snWrap.classList.remove('hidden');
        snWrap.classList.add('flex');
      } else {
        snImg.src = '';
        snWrap.classList.add('hidden');
        snWrap.classList.remove('flex');
      }
    }

    openModal('modal-edit-asset');
  }

  function zoomEditPhoto(type) {
    const isPhys = type === 'physical';
    const imgEl = document.getElementById(isPhys ? 'edit_physical_photo_preview' : 'edit_sn_photo_preview');
    const src = imgEl ? imgEl.getAttribute('src') : '';
    if (!src) return;

    const codeVal = document.getElementById('edit_asset_code')?.value || 'Aset';
    document.getElementById('zoom-edit-photo-title').textContent =
      `${isPhys ? 'Foto Fisik' : 'Foto Stiker SN'} - ${codeVal}`;
    document.getElementById('zoom-edit-photo-img').src = src;

    const dlBtn = document.getElementById('zoom-edit-photo-download');
    if (dlBtn) {
      dlBtn.href = src;
      dlBtn.setAttribute('download', src.split('/').pop() || 'foto-aset.jpg');
    }

    const delForm = document.getElementById('zoom-edit-photo-delete-form');
    const typeInput = document.getElementById('zoom-edit-photo-type-input');
    if (delForm && currentEditingAssetId) {
      delForm.action = `/assets/${currentEditingAssetId}/delete-photo`;
    }
    if (typeInput) {
      typeInput.value = isPhys ? 'physical' : 'sn';
    }

    toggleZoomEditPhotoDeleteConfirm(false);
    openModal('modal-zoom-edit-photo');
  }

  function toggleZoomEditPhotoDeleteConfirm(showConfirm) {
    const confirmBar = document.getElementById('zoom-edit-photo-delete-confirm');
    const footerBar = document.getElementById('zoom-edit-photo-footer');
    if (!confirmBar || !footerBar) return;

    if (showConfirm) {
      confirmBar.classList.remove('hidden');
      confirmBar.classList.add('flex');
      footerBar.classList.add('hidden');
      footerBar.classList.remove('flex');
    } else {
      confirmBar.classList.add('hidden');
      confirmBar.classList.remove('flex');
      footerBar.classList.remove('hidden');
      footerBar.classList.add('flex');
    }
  }

  function openDeleteAssetModal(id, code) {
    document.getElementById('delete-asset-code').textContent = code;
    document.getElementById('delete-asset-form').action = `/assets/${id}/delete`;
    openModal('modal-delete-asset');
  }

  // =========================================================
  // STIKER LABEL QR CODE (SATUAN & MASSAL - WYSIWYG)
  // =========================================================
  const LABEL_PRESETS = {
    '58x32': { widthMm: 58, heightMm: 32, qrMm: 18, codePt: 6, textPt: 6, metaPt: 5.5, scalePreview: 1.35 },
    '50x30': { widthMm: 50, heightMm: 30, qrMm: 16, codePt: 6, textPt: 5.3, metaPt: 5, scalePreview: 1.45 },
    '60x40': { widthMm: 60, heightMm: 40, qrMm: 22, codePt: 7.8, textPt: 6.8, metaPt: 6.2, scalePreview: 1.3 },
    '80x50': { widthMm: 80, heightMm: 50, qrMm: 28, codePt: 9.5, textPt: 8.2, metaPt: 7.5, scalePreview: 1.15 }
  };

  function escapeHtml(str) {
    return String(str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function generateQrImageDataUrl(text, sizePx = 180) {
    return new Promise((resolve) => {
      if (typeof QRCode === 'undefined') {
        resolve(null);
        return;
      }

      const tempDiv = document.createElement('div');
      tempDiv.style.position = 'fixed';
      tempDiv.style.left = '-9999px';
      document.body.appendChild(tempDiv);

      new QRCode(tempDiv, {
        text,
        width: sizePx,
        height: sizePx,
        colorDark: '#000000',
        colorLight: '#ffffff',
        correctLevel: QRCode.CorrectLevel.M
      });

      setTimeout(() => {
        const canvas = tempDiv.querySelector('canvas');
        const img = tempDiv.querySelector('img');
        let dataUrl = null;
        if (canvas) {
          dataUrl = canvas.toDataURL('image/png');
        } else if (img && img.src) {
          dataUrl = img.src;
        }
        tempDiv.remove();
        resolve(dataUrl);
      }, 45);
    });
  }

  function buildSingleStickerInnerHtml(d, p) {
    const qrImgTag = d.qrDataUrl
      ? `<img src="${d.qrDataUrl}" style="width:${p.qrMm}mm;height:${p.qrMm}mm;display:block;object-fit:contain;" />`
      : `<div style="width:${p.qrMm}mm;height:${p.qrMm}mm;border:1px solid #000;display:flex;align-items:center;justify-content:center;font-size:6pt;text-align:center;">NO QR</div>`;

    return `
      <div style="
        width: 100%;
        height: 100%;
        border: 1.2pt solid #000;
        border-radius: 1.5mm;
        padding: 1.4mm 1.8mm;
        display: flex;
        align-items: center;
        gap: 1.8mm;
        overflow: hidden;
        background: #fff;
        color: #000;
        font-family: Arial, Helvetica, sans-serif;
        box-sizing: border-box;
      ">
        <div style="flex: 0 0 auto; display: flex; align-items: center; justify-content: center;">
          ${qrImgTag}
        </div>
        <div style="flex: 1 1 auto; min-width: 0; overflow: hidden; display: flex; flex-direction: column; justify-content: center; gap: 0.5mm; text-align: left;">
          <div style="
            font-size: ${p.metaPt}pt;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.2px;
            border-bottom: 0.7pt solid #000;
            padding-bottom: 0.3mm;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
          ">${escapeHtml(ORG_NAME_FOR_STICKER)}</div>
          <div style="
            font-size: ${p.codePt}pt;
            font-weight: 700;
            line-height: 1.15;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
          ">${escapeHtml(d.code)}</div>
          <div style="
            font-size: ${p.textPt}pt;
            font-weight: 700;
            line-height: 1.15;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
          ">${escapeHtml(d.deviceName || '-')}</div>
          <div style="
            font-size: ${p.metaPt}pt;
            font-weight: 700;
            line-height: 1.15;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
          ">SN: ${escapeHtml(d.sn || '-')}</div>
        </div>
      </div>
    `;
  }

  function renderStickerPreviewList() {
    const container = document.getElementById('sticker-preview-container');
    if (!container) return;

    const sizeKey = document.getElementById('label-paper-size')?.value || '58x32';
    const p = LABEL_PRESETS[sizeKey] || LABEL_PRESETS['58x32'];

    if (!preparedStickersList.length) {
      container.innerHTML = '<div class="text-xs text-slate-400 py-6">Tidak ada stiker untuk ditampilkan.</div>';
      return;
    }

    container.innerHTML = preparedStickersList.map(d => {
      const extraY = (p.heightMm * (p.scalePreview - 1)) / 2;
      return `
        <div style="
          width: ${p.widthMm}mm;
          height: ${p.heightMm}mm;
          padding: 1.2mm;
          background: #fff;
          border-radius: 2mm;
          box-shadow: 0 4px 14px rgba(0,0,0,0.45);
          transform: scale(${p.scalePreview});
          transform-origin: center center;
          margin: ${extraY}mm 0;
          box-sizing: border-box;
          flex-shrink: 0;
        ">
          ${buildSingleStickerInnerHtml(d, p)}
        </div>
      `;
    }).join('');
  }

  async function prepareAndOpenQrModal(assetsArray, isBulk = false) {
    const container = document.getElementById('sticker-preview-container');
    const titleEl = document.getElementById('qr-modal-title');
    const subtitleEl = document.getElementById('qr-modal-subtitle');
    const totalBadgeEl = document.getElementById('qr-modal-total-badge');
    const printBtnLabelEl = document.getElementById('btn-print-sticker-label');

    if (titleEl) {
      titleEl.textContent = isBulk
        ? `Cetak Label QR (${assetsArray.length} Aset)`
        : 'Stiker Label Inventaris Aset';
    }
    if (subtitleEl) {
      subtitleEl.textContent = isBulk
        ? 'Setiap stiker dicetak pada 1 halaman label terpisah secara berurutan.'
        : 'Tampilan preview sama dengan ukuran kertas label yang dicetak.';
    }
    if (totalBadgeEl) totalBadgeEl.textContent = String(assetsArray.length);
    if (printBtnLabelEl) {
      printBtnLabelEl.textContent = isBulk ? `Print (${assetsArray.length})` : 'Print Stiker';
    }

    container.innerHTML = '<div class="text-xs text-slate-400 py-8">Membuat QR Code...</div>';
    openModal('modal-qr-label');

    const results = [];
    for (const item of assetsArray) {
      const qrText = String(item.code || '').trim();
      const qrDataUrl = await generateQrImageDataUrl(qrText, 200);
      results.push({ ...item, qrText, qrDataUrl });
    }

    preparedStickersList = results;
    renderStickerPreviewList();
  }

  function openSingleQrLabelModal(btn) {
    const data = JSON.parse(btn.getAttribute('data-qr-asset'));
    prepareAndOpenQrModal([data], false);
  }

  function openBulkQrLabelModal() {
    const list = Array.from(selectedAssetsMap.values());
    if (list.length === 0) {
      if (typeof window.showAppAlert === 'function') {
        window.showAppAlert('warning', 'Pilih minimal 1 perangkat menggunakan checkbox terlebih dahulu sebelum mencetak label.', 'Belum Ada Aset Dipilih');
      }
      return;
    }
    prepareAndOpenQrModal(list, true);
  }

  function printAllPreparedStickers() {
    if (!preparedStickersList.length) return;

    const sizeKey = document.getElementById('label-paper-size')?.value || '58x32';
    const p = LABEL_PRESETS[sizeKey] || LABEL_PRESETS['58x32'];

    const pagesHtml = preparedStickersList.map((d, idx) => {
      const isLast = idx === preparedStickersList.length - 1;
      return `
        <div class="label-page" style="${isLast ? '' : 'page-break-after: always; break-after: page;'}">
          ${buildSingleStickerInnerHtml(d, p)}
        </div>
      `;
    }).join('');

    const win = window.open('', '_blank', 'width=460,height=360');
    win.document.write(`
      <!DOCTYPE html>
      <html>
        <head>
          <meta charset="UTF-8">
          <title>Cetak ${preparedStickersList.length} Label Aset</title>
          <style>
            @page {
              size: ${p.widthMm}mm ${p.heightMm}mm;
              margin: 0mm;
            }
            * {
              box-sizing: border-box;
              margin: 0;
              padding: 0;
              -webkit-print-color-adjust: exact;
              print-color-adjust: exact;
            }
            html, body {
              width: ${p.widthMm}mm;
              background: #fff;
              color: #000;
              font-family: Arial, Helvetica, sans-serif;
            }
            .label-page {
              width: ${p.widthMm}mm;
              height: ${p.heightMm}mm;
              padding: 1.2mm;
              overflow: hidden;
              display: flex;
              align-items: center;
              justify-content: center;
            }
          </style>
        </head>
        <body>
          ${pagesHtml}
          <script>
            window.onload = function() {
              setTimeout(function() {
                window.focus();
                window.print();
                window.close();
              }, 150);
            };
          <\/script>
        </body>
      </html>
    `);
    win.document.close();
  }
</script>


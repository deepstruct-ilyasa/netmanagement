<!-- MODAL PENGATURAN FORMAT KODE ASET -->
<div id="modal-asset-settings" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
  <div onclick="closeModal('modal-asset-settings')" class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm"></div>
  <div class="relative bg-slate-800 border border-slate-700 rounded-2xl w-full max-w-md p-6 shadow-2xl z-10 space-y-4">
    <div class="flex items-center justify-between border-b border-slate-700 pb-3">
      <h3 class="text-base font-semibold text-emerald-400">Pengaturan Format Kode Aset</h3>
      <button type="button" onclick="closeModal('modal-asset-settings')" class="text-slate-400 hover:text-white cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <% const isFormatLocked = (typeof totalAssetCount !== 'undefined' ? totalAssetCount : assets.length) > 0; %>

    <form action="/assets/settings" method="POST" class="space-y-4 text-sm">
      <div>
        <label class="block text-slate-300 mb-1">Nama Instansi (Untuk Label QR)</label>
        <input type="text" name="organization_name" value="<%= settings.organization_name %>" required
          class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-emerald-400">
      </div>

      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="block text-slate-300">Pola Format Nomor Aset *</label>
          <% if (isFormatLocked) { %>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-amber-500/15 border border-amber-500/30 text-amber-400 text-[10px] font-semibold">
              <i data-lucide="lock" class="w-3 h-3"></i>
              <span>Terkunci</span>
            </span>
          <% } else { %>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-[10px] font-semibold">
              <i data-lucide="unlock" class="w-3 h-3"></i>
              <span>Dapat Diubah</span>
            </span>
          <% } %>
        </div>

        <input type="text" name="asset_code_format" value="<%= settings.asset_code_format %>" required
          <%= isFormatLocked ? 'readonly' : '' %>
          class="w-full rounded-lg px-3 py-2 font-mono focus:outline-none <%= isFormatLocked
            ? 'bg-slate-900 border border-slate-700 text-slate-400 cursor-not-allowed select-all'
            : 'bg-slate-900 border border-slate-600 text-emerald-400 focus:border-emerald-400' %>">

        <% if (isFormatLocked) { %>
          <div class="mt-2 p-2.5 rounded-lg bg-amber-500/10 border border-amber-500/25 text-[11px] text-amber-300/90 leading-relaxed flex items-start gap-2">
            <i data-lucide="info" class="w-4 h-4 text-amber-400 shrink-0 mt-0.5"></i>
            <span>
              Format kode aset dikunci otomatis karena sudah terdapat <strong><%= typeof totalAssetCount !== 'undefined' ? totalAssetCount : assets.length %> data aset</strong> terdaftar. Untuk mengubah pola format, seluruh data aset harus kosong terlebih dahulu.
            </span>
          </div>
        <% } else { %>
          <p class="text-[11px] text-slate-400 mt-1.5 leading-relaxed">
            Variabel tersedia: <code class="text-emerald-400">{BRANCH}</code>, <code class="text-emerald-400">{YYMMDD}</code>, <code class="text-emerald-400">{YYYY}</code>, <code class="text-emerald-400">{YY}</code>, <code class="text-emerald-400">{MM}</code>, <code class="text-emerald-400">{DD}</code>, <code class="text-emerald-400">{SEQ:6}</code>.
          </p>
        <% } %>
      </div>

      <div class="pt-2 flex justify-end gap-2">
        <button type="button" onclick="closeModal('modal-asset-settings')" class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 cursor-pointer">Batal</button>
        <button type="submit" class="px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-semibold cursor-pointer">
          <%= isFormatLocked ? 'Simpan' : 'Simpan Pola' %>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL HAPUS ASET -->
<div id="modal-delete-asset" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
  <div onclick="closeModal('modal-delete-asset')" class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm"></div>
  <div class="relative bg-slate-800 border border-slate-700 rounded-2xl w-full max-w-md p-6 shadow-2xl z-10 space-y-4">
    <h3 class="text-lg font-semibold text-white">Hapus Data Aset?</h3>
    <p class="text-sm text-slate-300">
      Apakah Anda yakin ingin menghapus permanen aset <span id="delete-asset-code" class="font-bold font-mono text-rose-400"></span>?
    </p>
    <form id="delete-asset-form" method="POST" class="pt-2 flex justify-end gap-2 text-sm">
      <button type="button" onclick="closeModal('modal-delete-asset')" class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 cursor-pointer">Batal</button>
      <button type="submit" class="px-4 py-2 rounded-lg bg-rose-500 hover:bg-rose-600 text-white font-semibold cursor-pointer">Ya, Hapus</button>
    </form>
  </div>
</div>
<% } %>


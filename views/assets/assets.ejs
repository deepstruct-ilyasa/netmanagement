    <div class="px-5 py-3 border-t border-slate-700 bg-slate-100 dark:bg-slate-800/95 flex items-center justify-between gap-2 shrink-0">
      <span class="text-xs text-slate-400">Total: <strong id="qr-modal-total-badge" class="text-amber-400">1</strong> stiker</span>
      <div class="flex items-center gap-2">
        <button type="button" onclick="closeModal('modal-qr-label')" class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs sm:text-sm cursor-pointer">Tutup</button>

          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-amber-500 hover:bg-amber-600 text-slate-950 font-semibold text-xs sm:text-sm cursor-pointer">
          <i data-lucide="printer" class="w-4 h-4"></i>
          <span id="btn-print-sticker-label">Print Stiker</span>

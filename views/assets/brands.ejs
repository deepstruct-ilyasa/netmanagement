<%- include('../partials/header', { pageTitle: 'Master Brand / Merk' }) %>

<main class="p-4 sm:p-6 flex-1 w-full space-y-5">

  <!-- Header Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-800 border border-slate-700 p-4 rounded-xl">
    <div>
      <h2 class="text-base font-semibold text-white">Daftar Brand / Merk Perangkat</h2>
      <p class="text-xs text-slate-400">Kelola daftar pabrikan perangkat jaringan.</p>
    </div>
    <% if (can('brand.write')) { %>
      <button onclick="openModal('modal-add-brand')" class="inline-flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-semibold text-sm px-4 py-2.5 rounded-lg transition shadow-sm cursor-pointer">
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>Tambah Brand / Merk</span>
      </button>
    <% } %>
  </div>

  <!-- Tabel Brand / Merk + Filter & Search -->
  <div class="bg-slate-800 border border-slate-700 rounded-xl shadow-lg overflow-hidden">
    <div class="p-4 border-b border-slate-700/80 flex flex-row items-center justify-end gap-3 bg-slate-900/30">
      <div class="relative flex-1 sm:flex-initial sm:w-72">
        <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"></i>
        <input type="text" id="brand-search-input" oninput="onBrandSearch(this.value)"
          placeholder="Cari nama brand / merk..."
          class="w-full bg-slate-900 border border-slate-600 rounded-lg pl-9 pr-3 py-2 text-xs text-white placeholder-slate-400 focus:outline-none focus:border-emerald-400">
      </div>
      <div class="flex items-center gap-2 text-xs shrink-0">
        <select id="brand-per-page" onchange="changeBrandPerPage(this.value)" class="bg-slate-900 border border-slate-600 rounded-lg px-2 py-1.5 text-white focus:outline-none focus:border-emerald-400">
          <option value="8">8</option>
          <option value="25">25</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-sm whitespace-nowrap">
        <thead>
          <tr class="bg-slate-900/60 border-b border-slate-700 text-slate-400 text-xs uppercase">
            <th class="py-3 px-4 w-16 text-center">No</th>
            <th class="py-3 px-4">Nama Brand / Merk</th>
            <th class="py-3 px-4 text-center">Jumlah Model</th>
            <th class="py-3 px-4 text-center">Perangkat Terpasang</th>
            <% if (can('brand.write')) { %>
              <th class="py-3 px-4 text-right">Aksi</th>
            <% } %>
          </tr>
        </thead>
        <tbody id="brands-table-body" class="divide-y divide-slate-700/60">
          <% if (brands.length === 0) { %>
            <tr>
              <td colspan="5" class="py-10 text-center text-xs text-slate-400">Belum ada data brand.</td>
            </tr>
          <% } %>
          <% brands.forEach((b, index) => { %>
            <tr class="brand-row hover:bg-slate-700/30 transition">
              <td class="brand-no-cell py-3.5 px-4 text-center text-slate-400 font-mono"><%= index + 1 %></td>
              <td class="py-3.5 px-4 font-semibold text-white"><%= b.brand_name %></td>
              <td class="py-3.5 px-4 text-center">
                <% if (can('menu.device-models')) { %>
                  <a href="/device-models" class="px-2.5 py-0.5 rounded text-xs font-medium bg-sky-500/15 text-sky-400 border border-sky-500/30 hover:bg-sky-500/25 transition">
                    <%= b.model_count %> Model
                  </a>
                <% } else { %>
                  <span class="px-2.5 py-0.5 rounded text-xs font-medium bg-sky-500/15 text-sky-400 border border-sky-500/30">
                    <%= b.model_count %> Model
                  </span>
                <% } %>
              </td>
              <td class="py-3.5 px-4 text-center">
                <span class="px-2.5 py-0.5 rounded text-xs font-medium dark:bg-slate-700/80 text-slate-200 border border-slate-600">
                  <%= b.device_count %> Unit
                </span>
              </td>
              <% if (can('brand.write')) { %>
                <td class="py-3.5 px-4 text-right space-x-1.5">
                  <button type="button" title="Edit Brand"
                    onclick="openEditBrandModal('<%= b.id %>', '<%= b.brand_name %>')"
                    class="p-2 rounded-lg bg-sky-500/10 hover:bg-sky-500/20 text-sky-400 border border-sky-500/30 transition cursor-pointer">
                    <i data-lucide="square-pen" class="w-4 h-4"></i>
                  </button>
                  <button type="button" title="Hapus Brand"
                    onclick="openDeleteBrandModal('<%= b.id %>', '<%= b.brand_name %>')"
                    class="p-2 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 transition cursor-pointer">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                  </button>
                </td>
              <% } %>
            </tr>
          <% }) %>

          <tr id="brands-no-result" class="hidden">
            <td colspan="5" class="py-10 text-center text-xs text-slate-400">Tidak ada brand yang cocok dengan pencarian.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Footer Pagination -->
    <div id="brands-pagination-footer" class="px-4 py-3 border-t border-slate-200 dark:border-slate-700/80 bg-slate-50/80 dark:bg-slate-900/30 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-600 dark:text-slate-400">
      <div id="brands-page-info">
        Menampilkan <span class="text-slate-900 dark:text-white font-semibold">0</span> perangkat
      </div>
      <div id="brands-page-buttons" class="inline-flex items-center gap-1.5"></div>
    </div>
  </div>

</main>

<% if (can('brand.write')) { %>
<!-- Form Tersembunyi untuk Submit Hapus Brand via Global Confirm Modal -->
<form id="delete-brand-form" method="POST" class="hidden"></form>

<!-- MODAL TAMBAH BRAND -->
<div id="modal-add-brand" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
  <div onclick="closeModal('modal-add-brand')" class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm"></div>
  <div class="relative bg-slate-800 border border-slate-700 rounded-2xl w-full max-w-md p-6 shadow-2xl z-10 space-y-4">
    <div class="flex items-center justify-between border-b border-slate-700 pb-3">
      <h3 class="text-base font-semibold text-emerald-400">+ Tambah Brand / Merk</h3>
      <button type="button" onclick="closeModal('modal-add-brand')" class="text-slate-400 hover:text-white cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>
    <form action="/brands" method="POST" class="space-y-4 text-sm">
      <div>
        <label class="block text-slate-300 mb-1">Nama Brand / Merk *</label>
        <input type="text" name="brand_name" required placeholder="Contoh: MikroTik, Ruijie, UniFi" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-emerald-400">
      </div>
      <div class="pt-2 flex justify-end gap-2">
        <button type="button" onclick="closeModal('modal-add-brand')" class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 cursor-pointer">Batal</button>
        <button type="submit" class="px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-semibold cursor-pointer">Simpan</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL EDIT BRAND -->
<div id="modal-edit-brand" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
  <div onclick="closeModal('modal-edit-brand')" class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm"></div>
  <div class="relative bg-slate-800 border border-slate-700 rounded-2xl w-full max-w-md p-6 shadow-2xl z-10 space-y-4">
    <div class="flex items-center justify-between border-b border-slate-700 pb-3">
      <h3 class="text-base font-semibold text-emerald-400">Edit Brand / Merk</h3>
      <button type="button" onclick="closeModal('modal-edit-brand')" class="text-slate-400 hover:text-white cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>
    <form id="edit-brand-form" method="POST" class="space-y-4 text-sm">
      <div>
        <label class="block text-slate-300 mb-1">Nama Brand / Merk *</label>
        <input type="text" name="brand_name" id="edit_brand_name" required class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-emerald-400">
      </div>
      <div class="pt-2 flex justify-end gap-2">
        <button type="button" onclick="closeModal('modal-edit-brand')" class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 cursor-pointer">Batal</button>
        <button type="submit" class="px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-semibold cursor-pointer">Update</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<script>
  const BRAND_STATE_KEY = 'netmgmt_brand_table_state';
  let brandState = { page: 1, perPage: 8, search: '' };

  function loadBrandState() {
    const selectEl = document.getElementById('brand-per-page');
    const searchEl = document.getElementById('brand-search-input');

    const validOptions = selectEl
      ? Array.from(selectEl.options).map(opt => parseInt(opt.value, 10))
      : [8, 25, 50, 100];
    const defaultPerPage = validOptions[0] || 8;

    try {
      const saved = JSON.parse(sessionStorage.getItem(BRAND_STATE_KEY));
      if (saved) brandState = { ...brandState, ...saved };
    } catch (e) {}

    if (!validOptions.includes(Number(brandState.perPage))) {
      brandState.perPage = defaultPerPage;
      saveBrandState();
    }

    if (selectEl) selectEl.value = String(brandState.perPage);
    if (searchEl) searchEl.value = brandState.search || '';
  }

  function saveBrandState() {
    sessionStorage.setItem(BRAND_STATE_KEY, JSON.stringify(brandState));
  }

  function onBrandSearch(val) {
    brandState.search = val;
    brandState.page = 1;
    saveBrandState();
    renderBrandsTable();
  }

  function changeBrandPerPage(val) {
    brandState.perPage = parseInt(val, 10) || 8;
    brandState.page = 1;
    saveBrandState();
    renderBrandsTable();
  }

  function goToBrandPage(page) {
    brandState.page = page;
    saveBrandState();
    renderBrandsTable();
  }

  function renderBrandsTable() {
    const rows = Array.from(document.querySelectorAll('#brands-table-body .brand-row'));
    const noResultRow = document.getElementById('brands-no-result');
    const footer = document.getElementById('brands-pagination-footer');

    if (rows.length === 0) {
      if (footer) footer.classList.add('hidden');
      return;
    }

    const query = (brandState.search || '').trim().toLowerCase();
    const matchedRows = [];

    rows.forEach(row => {
      const matchSearch = !query || row.textContent.toLowerCase().includes(query);
      if (matchSearch) {
        matchedRows.push(row);
      } else {
        row.classList.add('hidden');
      }
    });

    const totalItems = matchedRows.length;
    const totalPages = Math.max(1, Math.ceil(totalItems / brandState.perPage));
    if (brandState.page > totalPages) {
      brandState.page = totalPages;
      saveBrandState();
    }

    const startIdx = (brandState.page - 1) * brandState.perPage;
    const endIdx = startIdx + brandState.perPage;

    matchedRows.forEach((row, idx) => {
      const isVisible = idx >= startIdx && idx < endIdx;
      row.classList.toggle('hidden', !isVisible);
      if (isVisible) {
        const noCell = row.querySelector('.brand-no-cell');
        if (noCell) noCell.textContent = idx + 1;
      }
    });

    if (noResultRow) {
      noResultRow.classList.toggle('hidden', totalItems > 0);
    }

    renderPaginationControls({
      infoEl: document.getElementById('brands-page-info'),
      buttonsEl: document.getElementById('brands-page-buttons'),
      totalItems,
      page: brandState.page,
      perPage: brandState.perPage,
      onPageClick: goToBrandPage
    });
  }

  function renderPaginationControls({ infoEl, buttonsEl, totalItems, page, perPage, onPageClick }) {
    if (!infoEl || !buttonsEl) return;
    const totalPages = Math.max(1, Math.ceil(totalItems / perPage));
    const from = totalItems === 0 ? 0 : (page - 1) * perPage + 1;
    const to = Math.min(page * perPage, totalItems);
    infoEl.textContent = `Menampilkan ${from} - ${to} dari ${totalItems} data`;

    buttonsEl.innerHTML = '';
    if (totalItems === 0) return;

    const createBtn = (label, targetPage, disabled, active) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = label;
      btn.disabled = disabled;
      btn.className = active
        ? 'px-2.5 py-1 rounded-md bg-emerald-500 text-slate-950 font-bold cursor-pointer'
        : disabled
          ? 'px-2.5 py-1 rounded-md bg-slate-800/50 text-slate-600 border border-slate-700/50 cursor-not-allowed'
          : 'px-2.5 py-1 rounded-md bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition cursor-pointer';
      if (!disabled && !active) {
        btn.addEventListener('click', () => onPageClick(targetPage));
      }
      return btn;
    };

    buttonsEl.appendChild(createBtn('‹ Prev', page - 1, page <= 1, false));

    const pages = [];
    for (let p = 1; p <= totalPages; p++) {
      if (p === 1 || p === totalPages || (p >= page - 1 && p <= page + 1)) {
        pages.push(p);
      } else if (pages[pages.length - 1] !== '...') {
        pages.push('...');
      }
    }

    pages.forEach(p => {
      if (p === '...') {
        const span = document.createElement('span');
        span.textContent = '...';
        span.className = 'px-1.5 text-slate-500';
        buttonsEl.appendChild(span);
      } else {
        buttonsEl.appendChild(createBtn(String(p), p, false, p === page));
      }
    });

    buttonsEl.appendChild(createBtn('Next ›', page + 1, page >= totalPages, false));
  }

  function openEditBrandModal(id, name) {
    document.getElementById('edit-brand-form').action = `/brands/${id}/update`;
    document.getElementById('edit_brand_name').value = name;
    openModal('modal-edit-brand');
  }

  function openDeleteBrandModal(id, name) {
    showAppConfirm({
      title: 'Hapus Brand / Merk?',
      message: `Apakah Anda yakin ingin menghapus brand ${name}? Seluruh model di bawah brand ini juga akan terhapus.`,
      type: 'danger',
      confirmText: 'Ya, Hapus',
      onConfirm: () => {
        const form = document.getElementById('delete-brand-form');
        form.action = `/brands/${id}/delete`;
        form.submit();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    loadBrandState();
    renderBrandsTable();

    const serverError = <%- JSON.stringify(typeof errorMsg !== 'undefined' ? errorMsg : null) %>;
    const serverSuccess = <%- JSON.stringify(typeof successMsg !== 'undefined' ? successMsg : null) %>;

    if (serverError) {
      showAppAlert('error', 'Terjadi Kesalahan', serverError);
    } else if (serverSuccess) {
      showAppAlert('success', 'Berhasil', serverSuccess);
    }
  });
</script>

<%- include('../partials/footer') %>
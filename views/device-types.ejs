<%- include('partials/header', { pageTitle: 'Master Jenis Perangkat' }) %>

<main class="p-4 sm:p-6 flex-1 w-full space-y-5">

  <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
    <div id="alert-error" class="bg-rose-500/15 border border-rose-500/40 text-rose-400 px-4 py-3 rounded-xl flex items-center justify-between text-sm">
      <div class="flex items-center gap-2.5">
        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0"></i>
        <span><%= errorMsg %></span>
      </div>
      <button onclick="document.getElementById('alert-error').remove()" class="p-1 hover:text-white cursor-pointer">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>
  <% } %>

  <% if (typeof successMsg !== 'undefined' && successMsg) { %>
    <div id="alert-success" class="bg-emerald-500/15 border border-emerald-500/40 text-emerald-400 px-4 py-3 rounded-xl flex items-center justify-between text-sm">
      <div class="flex items-center gap-2.5">
        <i data-lucide="check-circle-2" class="w-5 h-5 shrink-0"></i>
        <span><%= successMsg %></span>
      </div>
      <button onclick="document.getElementById('alert-success').remove()" class="p-1 hover:text-white cursor-pointer">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>
  <% } %>

  <!-- Header Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-800 border border-slate-700 p-4 rounded-xl">
    <div>
      <h2 class="text-base font-semibold text-white">Daftar Jenis Perangkat</h2>
      <p class="text-xs text-slate-400">Kelola kategori jenis perangkat jaringan beserta distribusi unit per cabang.</p>
    </div>
    <% if (can('device_type.write')) { %>
      <button onclick="openModal('modal-add-type')" class="inline-flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-semibold text-sm px-4 py-2.5 rounded-lg transition shadow-sm cursor-pointer">
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>Tambah Jenis Perangkat</span>
      </button>
    <% } %>
  </div>

  <!-- Tabel Device Types + Filter & Search -->
  <div class="bg-slate-800 border border-slate-700 rounded-xl shadow-lg overflow-hidden">
    <div class="p-4 border-b border-slate-700/80 flex flex-row items-center justify-end gap-3 bg-slate-900/30">
      <div class="relative flex-1 sm:flex-initial sm:w-72">
        <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"></i>
        <input type="text" id="dt-search-input" oninput="onDtSearch(this.value)"
          placeholder="Cari jenis perangkat atau cabang..."
          class="w-full bg-slate-900 border border-slate-600 rounded-lg pl-9 pr-3 py-2 text-xs text-white placeholder-slate-400 focus:outline-none focus:border-emerald-400">
      </div>
      <div class="flex items-center gap-2 text-xs shrink-0">
        <select id="dt-per-page" onchange="changeDtPerPage(this.value)" class="bg-slate-900 border border-slate-600 rounded-lg px-2 py-1.5 text-white focus:outline-none focus:border-emerald-400">
          <option value="8">8</option>
          <option value="25">25</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-sm whitespace-nowrap">
        <thead>
          <tr class="bg-slate-900/60 border-b border-slate-700 text-slate-400 text-xs uppercase">
            <th class="py-3 px-4 w-16 text-center">No</th>
            <th class="py-3 px-4">Jenis Perangkat</th>
            <th class="py-3 px-4">Cabang</th>
            <th class="py-3 px-4 text-center">Jumlah Perangkat</th>
            <% if (can('device_type.write')) { %>
              <th class="py-3 px-4 text-right">Aksi</th>
            <% } %>
          </tr>
        </thead>
        <tbody id="dt-table-body" class="divide-y divide-slate-700/60">
          <% if (deviceTypes.length === 0) { %>
            <tr>
              <td colspan="5" class="py-10 text-center text-xs text-slate-400">Belum ada data jenis perangkat.</td>
            </tr>
          <% } %>

          <% deviceTypes.forEach((dt, index) => { %>
            <% if (!dt.branches || dt.branches.length === 0) { %>
              <tr class="dt-row hover:bg-slate-700/20 transition" data-group-id="<%= dt.id %>">
                <td class="dt-no-cell py-3.5 px-4 text-center text-slate-400 font-mono"><%= index + 1 %></td>
                <td class="py-3.5 px-4 font-semibold text-white"><%= dt.type_name %></td>
                <td class="py-3.5 px-4 text-slate-500">-</td>
                <td class="py-3.5 px-4 text-center">
                  <span class="px-2.5 py-0.5 rounded text-xs font-medium bg-slate-800 text-slate-400 border border-slate-700">
                    0 Unit
                  </span>
                </td>
                <% if (can('device_type.write')) { %>
                  <td class="py-3.5 px-4 text-right space-x-1.5">
                    <button type="button" title="Edit Jenis Perangkat"
                      onclick="openEditTypeModal('<%= dt.id %>', '<%= dt.type_name %>', '<%= dt.is_switch %>')"
                      class="p-2 rounded-lg bg-sky-500/10 hover:bg-sky-500/20 text-sky-400 border border-sky-500/30 transition cursor-pointer">
                      <i data-lucide="square-pen" class="w-4 h-4"></i>
                    </button>
                    <button type="button" title="Hapus Jenis Perangkat"
                      onclick="openDeleteTypeModal('<%= dt.id %>', '<%= dt.type_name %>')"
                      class="p-2 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 transition cursor-pointer">
                      <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                  </td>
                <% } %>
              </tr>
            <% } else { %>
              <% dt.branches.forEach((br, brIdx) => { %>
                <tr class="dt-row hover:bg-slate-700/20 transition" data-group-id="<%= dt.id %>">
                  <% if (brIdx === 0) { %>
                    <td rowspan="<%= dt.rowspan %>" class="dt-no-cell py-3.5 px-4 text-center text-slate-400 font-mono align-top border-r border-slate-700/40">
                      <%= index + 1 %>
                    </td>
                    <td rowspan="<%= dt.rowspan %>" class="py-3.5 px-4 font-semibold text-white align-top border-r border-slate-700/40">
                      <div><%= dt.type_name %></div>
                      <div class="text-[11px] font-normal text-slate-400 mt-0.5">Total: <%= dt.device_count %> Unit</div>
                    </td>
                  <% } %>

                  <td class="py-3 px-4 text-slate-200 font-medium">
                    <span class="font-semibold text-emerald-400"><%= br.branch_code %></span>
                    <span class="text-slate-400 text-xs ml-1">(<%= br.branch_name %>)</span>
                  </td>

                  <td class="py-3 px-4 text-center">
                    <span class="px-2.5 py-0.5 rounded text-xs font-semibold bg-slate-700/80 text-slate-200 border border-slate-600">
                      <%= br.unit_count %> Unit
                    </span>
                  </td>

                  <% if (brIdx === 0 && can('device_type.write')) { %>
                    <td rowspan="<%= dt.rowspan %>" class="py-3.5 px-4 text-right align-top border-l border-slate-700/40 space-x-1.5">
                      <button type="button" title="Edit Jenis Perangkat"
                        onclick="openEditTypeModal('<%= dt.id %>', '<%= dt.type_name %>', '<%= dt.is_switch %>')"
                        class="p-2 rounded-lg bg-sky-500/10 hover:bg-sky-500/20 text-sky-400 border border-sky-500/30 transition cursor-pointer">
                        <i data-lucide="square-pen" class="w-4 h-4"></i>
                      </button>
                      <button type="button" title="Hapus Jenis Perangkat"
                        onclick="openDeleteTypeModal('<%= dt.id %>', '<%= dt.type_name %>')"
                        class="p-2 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 transition cursor-pointer">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                      </button>
                    </td>
                  <% } %>
                </tr>
              <% }) %>
            <% } %>
          <% }) %>

          <tr id="dt-no-result" class="hidden">
            <td colspan="5" class="py-10 text-center text-xs text-slate-400">Tidak ada jenis perangkat yang cocok dengan pencarian.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Footer Pagination -->
    <div id="dt-pagination-footer" class="px-4 py-3 border-t border-slate-200 dark:border-slate-700/80 bg-slate-50/80 dark:bg-slate-900/30 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-600 dark:text-slate-400">
      <div id="dt-page-info">
        Menampilkan <span class="text-slate-900 dark:text-white font-semibold">0</span> perangkat
      </div>
      <div id="dt-page-buttons" class="inline-flex items-center gap-1.5"></div>
    </div>
  </div>

</main>

<% if (can('device_type.write')) { %>
<!-- MODAL TAMBAH DEVICE TYPE -->
<div id="modal-add-type" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
  <div onclick="closeModal('modal-add-type')" class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm"></div>
  <div class="relative bg-slate-800 border border-slate-700 rounded-2xl w-full max-w-md p-6 shadow-2xl z-10 space-y-4">
    <div class="flex items-center justify-between border-b border-slate-700 pb-3">
      <h3 class="text-base font-semibold text-emerald-400">+ Tambah Jenis Perangkat</h3>
      <button type="button" onclick="closeModal('modal-add-type')" class="text-slate-400 hover:text-white cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form action="/device-types" method="POST" class="space-y-4 text-sm">
      <div>
        <label class="block text-slate-300 mb-1">Nama Jenis Perangkat *</label>
        <input type="text" name="type_name" required placeholder="Contoh: Router, Switch, Access Point" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-emerald-400">
      </div>

      <label class="flex items-start gap-2.5 bg-slate-900/70 border border-slate-700 rounded-xl p-3 cursor-pointer">
        <input type="checkbox" name="is_switch" value="1" class="mt-0.5 rounded border-slate-600 text-emerald-500">
        <div class="text-xs">
          <span class="block font-semibold text-slate-200">Tandai sebagai Kategori Switch</span>
          <span class="text-slate-400">Mengaktifkan opsi Managed/Unmanaged dan dukungan daya PoE saat input perangkat.</span>
        </div>
      </label>

      <div class="pt-2 flex justify-end gap-2">
        <button type="button" onclick="closeModal('modal-add-type')" class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 cursor-pointer">Batal</button>
        <button type="submit" class="px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-semibold cursor-pointer">Simpan</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL EDIT DEVICE TYPE -->
<div id="modal-edit-type" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
  <div onclick="closeModal('modal-edit-type')" class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm"></div>
  <div class="relative bg-slate-800 border border-slate-700 rounded-2xl w-full max-w-md p-6 shadow-2xl z-10 space-y-4">
    <div class="flex items-center justify-between border-b border-slate-700 pb-3">
      <h3 class="text-base font-semibold text-sky-400">Edit Jenis Perangkat</h3>
      <button type="button" onclick="closeModal('modal-edit-type')" class="text-slate-400 hover:text-white cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form id="edit-type-form" method="POST" class="space-y-4 text-sm">
      <div>
        <label class="block text-slate-300 mb-1">Nama Jenis Perangkat *</label>
        <input type="text" name="type_name" id="edit_type_name" required class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-sky-400">
      </div>

      <label class="flex items-start gap-2.5 bg-slate-900/70 border border-slate-700 rounded-xl p-3 cursor-pointer">
        <input type="checkbox" name="is_switch" id="edit_is_switch" value="1" class="mt-0.5 rounded border-slate-600 text-sky-500">
        <div class="text-xs">
          <span class="block font-semibold text-slate-200">Tandai sebagai Kategori Switch</span>
          <span class="text-slate-400">Mengaktifkan opsi Managed/Unmanaged dan dukungan daya PoE saat input perangkat.</span>
        </div>
      </label>

      <div class="pt-2 flex justify-end gap-2">
        <button type="button" onclick="closeModal('modal-edit-type')" class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 cursor-pointer">Batal</button>
        <button type="submit" class="px-4 py-2 rounded-lg bg-sky-500 hover:bg-sky-600 text-slate-950 font-semibold cursor-pointer">Update</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL HAPUS DEVICE TYPE -->
<div id="modal-delete-type" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
  <div onclick="closeModal('modal-delete-type')" class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm"></div>
  <div class="relative bg-slate-800 border border-slate-700 rounded-2xl w-full max-w-md p-6 shadow-2xl z-10 space-y-4">
    <h3 class="text-lg font-semibold text-white">Hapus Jenis Perangkat?</h3>
    <p class="text-sm text-slate-300">
      Apakah Anda yakin ingin menghapus jenis perangkat <span id="delete-type-name" class="font-bold text-rose-400"></span>?
    </p>
    <form id="delete-type-form" method="POST" class="pt-2 flex justify-end gap-2 text-sm">
      <button type="button" onclick="closeModal('modal-delete-type')" class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 cursor-pointer">Batal</button>
      <button type="submit" class="px-4 py-2 rounded-lg bg-rose-500 hover:bg-rose-600 text-white font-semibold cursor-pointer">Ya, Hapus</button>
    </form>
  </div>
</div>
<% } %>

<script>
  const DT_STATE_KEY = 'netmgmt_dt_table_state';
  let dtState = { page: 1, perPage: 8, search: '' };

  function loadDtState() {
    const selectEl = document.getElementById('dt-per-page');
    const searchEl = document.getElementById('dt-search-input');

    const validOptions = selectEl
      ? Array.from(selectEl.options).map(opt => parseInt(opt.value, 10))
      : [8, 25, 50, 100];
    const defaultPerPage = validOptions[0] || 8;

    try {
      const saved = JSON.parse(sessionStorage.getItem(DT_STATE_KEY));
      if (saved) dtState = { ...dtState, ...saved };
    } catch (e) {}

    if (!validOptions.includes(Number(dtState.perPage))) {
      dtState.perPage = defaultPerPage;
      saveDtState();
    }

    if (selectEl) selectEl.value = String(dtState.perPage);
    if (searchEl) searchEl.value = dtState.search || '';
  }

  function saveDtState() {
    sessionStorage.setItem(DT_STATE_KEY, JSON.stringify(dtState));
  }

  function onDtSearch(val) {
    dtState.search = val;
    dtState.page = 1;
    saveDtState();
    renderDtTable();
  }

  function changeDtPerPage(val) {
    dtState.perPage = parseInt(val, 10) || 8;
    dtState.page = 1;
    saveDtState();
    renderDtTable();
  }

  function goToDtPage(page) {
    dtState.page = page;
    saveDtState();
    renderDtTable();
  }

  function renderDtTable() {
    const allRows = Array.from(document.querySelectorAll('#dt-table-body .dt-row'));
    const noResultRow = document.getElementById('dt-no-result');
    const footer = document.getElementById('dt-pagination-footer');

    if (allRows.length === 0) {
      if (footer) footer.classList.add('hidden');
      return;
    }

    const groupMap = new Map();
    allRows.forEach(row => {
      const gid = row.getAttribute('data-group-id');
      if (!groupMap.has(gid)) groupMap.set(gid, []);
      groupMap.get(gid).push(row);
    });

    const query = (dtState.search || '').trim().toLowerCase();
    const matchedGroups = [];

    groupMap.forEach(rows => {
      const combinedText = rows.map(r => r.textContent).join(' ').toLowerCase();
      if (!query || combinedText.includes(query)) {
        matchedGroups.push(rows);
      } else {
        rows.forEach(r => r.classList.add('hidden'));
      }
    });

    const totalItems = matchedGroups.length;
    const totalPages = Math.max(1, Math.ceil(totalItems / dtState.perPage));
    if (dtState.page > totalPages) {
      dtState.page = totalPages;
      saveDtState();
    }

    const startIdx = (dtState.page - 1) * dtState.perPage;
    const endIdx = startIdx + dtState.perPage;

    matchedGroups.forEach((rows, idx) => {
      const isVisible = idx >= startIdx && idx < endIdx;
      rows.forEach(r => r.classList.toggle('hidden', !isVisible));
      if (isVisible) {
        const noCell = rows[0].querySelector('.dt-no-cell');
        if (noCell) noCell.textContent = idx + 1;
      }
    });

    if (noResultRow) {
      noResultRow.classList.toggle('hidden', totalItems > 0);
    }

    renderPaginationControls({
      infoEl: document.getElementById('dt-page-info'),
      buttonsEl: document.getElementById('dt-page-buttons'),
      totalItems,
      page: dtState.page,
      perPage: dtState.perPage,
      onPageClick: goToDtPage
    });
  }

  function renderPaginationControls({ infoEl, buttonsEl, totalItems, page, perPage, onPageClick }) {
    if (!infoEl || !buttonsEl) return;
    const totalPages = Math.max(1, Math.ceil(totalItems / perPage));
    const from = totalItems === 0 ? 0 : (page - 1) * perPage + 1;
    const to = Math.min(page * perPage, totalItems);
    infoEl.textContent = `Menampilkan ${from} - ${to} dari ${totalItems} data`;

    buttonsEl.innerHTML = '';
    if (totalItems === 0) return;

    const createBtn = (label, targetPage, disabled, active) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = label;
      btn.disabled = disabled;
      btn.className = active
        ? 'px-2.5 py-1 rounded-md bg-emerald-500 text-slate-950 font-bold cursor-pointer'
        : disabled
          ? 'px-2.5 py-1 rounded-md bg-slate-800/50 text-slate-600 border border-slate-700/50 cursor-not-allowed'
          : 'px-2.5 py-1 rounded-md bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition cursor-pointer';
      if (!disabled && !active) {
        btn.addEventListener('click', () => onPageClick(targetPage));
      }
      return btn;
    };

    buttonsEl.appendChild(createBtn('‹ Prev', page - 1, page <= 1, false));

    const pages = [];
    for (let p = 1; p <= totalPages; p++) {
      if (p === 1 || p === totalPages || (p >= page - 1 && p <= page + 1)) {
        pages.push(p);
      } else if (pages[pages.length - 1] !== '...') {
        pages.push('...');
      }
    }

    pages.forEach(p => {
      if (p === '...') {
        const span = document.createElement('span');
        span.textContent = '...';
        span.className = 'px-1.5 text-slate-500';
        buttonsEl.appendChild(span);
      } else {
        buttonsEl.appendChild(createBtn(String(p), p, false, p === page));
      }
    });

    buttonsEl.appendChild(createBtn('Next ›', page + 1, page >= totalPages, false));
  }

  function openEditTypeModal(id, name, isSwitch) {
    document.getElementById('edit-type-form').action = `/device-types/${id}/update`;
    document.getElementById('edit_type_name').value = name;
    document.getElementById('edit_is_switch').checked = String(isSwitch) === '1';
    openModal('modal-edit-type');
  }

  function openDeleteTypeModal(id, name) {
    document.getElementById('delete-type-name').textContent = name;
    document.getElementById('delete-type-form').action = `/device-types/${id}/delete`;
    openModal('modal-delete-type');
  }

  document.addEventListener('DOMContentLoaded', () => {
    loadDtState();
    renderDtTable();
  });
</script>

<%- include('partials/footer') %>
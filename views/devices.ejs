<%- include('partials/header', { pageTitle: 'Master Perangkat Jaringan' }) %>

<main class="p-4 sm:p-6 flex-1 w-full space-y-5">

  <!-- Bar Atas: Info Ringkas & Tombol Buka Modal Tambah -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-800 border border-slate-700 p-4 rounded-xl">
    <div>
      <h2 class="text-base font-semibold text-white">Daftar Perangkat Operasional & Faceplate</h2>
      <p class="text-xs text-slate-400">Pasang aset dari Master Assets ke topologi jaringan, atur visual faceplate, dan kelola koneksi antar port.</p>
    </div>
    <% if (can('device.write')) { %>
      <button onclick="openModal('modal-add-device')" class="inline-flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-semibold text-sm px-4 py-2.5 rounded-lg transition shadow-sm cursor-pointer">
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>Pasang Perangkat dari Aset</span>
      </button>
    <% } %>
  </div>

  <!-- Tabel Daftar Perangkat (Responsive + Search + Pagination) -->
  <div class="bg-slate-800 border border-slate-700 rounded-xl shadow-lg overflow-hidden">
    <% if (devices.length === 0) { %>
      <div class="text-center py-16 px-4 text-slate-400 text-sm">
        <p class="mb-3">Belum ada data perangkat yang terpasang di jaringan.</p>
        <% if (can('device.write')) { %>
          <button onclick="openModal('modal-add-device')" class="text-emerald-400 hover:underline font-medium cursor-pointer">
            + Pasang perangkat pertama dari stok Master Assets
          </button>
        <% } %>
      </div>
    <% } else { %>
      <!-- Toolbar Search & Entries Per Page -->
      <div class="p-4 border-b border-slate-700/80 flex flex-row items-center justify-end gap-3 bg-slate-900/30">
        <div class="relative flex-1 sm:flex-initial sm:w-72">
          <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"></i>
          <input type="text" id="device-search-input"
            placeholder="Cari hostname, kode aset, cabang, IP, brand..."
            oninput="handleSearchChange()"
            class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg pl-9 pr-8 py-2 text-xs text-slate-800 dark:text-white placeholder-slate-400 focus:outline-none focus:border-emerald-500 dark:focus:border-emerald-400 transition shadow-2xs">
          <button type="button" id="clear-search-btn" onclick="clearDeviceSearch()"
            title="Hapus pencarian"
            class="hidden text-slate-400 hover:text-slate-700 dark:hover:text-white absolute right-2.5 top-1/2 -translate-y-1/2 cursor-pointer">
            <i data-lucide="x" class="w-3.5 h-3.5"></i>
          </button>
        </div>
        <div class="flex items-center gap-2 text-xs text-slate-600 dark:text-slate-400 shrink-0">
          <select id="devices-per-page" onchange="handlePerPageChange()"
            aria-label="Jumlah data per halaman"
            class="bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg px-0.5 py-2 text-slate-800 dark:text-white font-medium focus:outline-none focus:border-emerald-500 dark:focus:border-emerald-400 cursor-pointer shadow-2xs">
            <option value="8" selected>8</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="all">Semua</option>
          </select>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm whitespace-nowrap">
          <thead>
            <tr class="bg-slate-900/60 border-b border-slate-700 text-slate-400 text-xs uppercase">
              <th class="py-3 px-4">Hostname & Kode Aset</th>
              <th class="py-3 px-4">Cabang</th>
              <th class="py-3 px-4">Lokasi</th>
              <th class="py-3 px-4">Jenis</th>
              <th class="py-3 px-4">Spesifikasi</th>
              <th class="py-3 px-4">Brand</th>
              <th class="py-3 px-4">Model</th>
              <th class="py-3 px-4">IP Address</th>
              <th class="py-3 px-4">MAC Address</th>
              <th class="py-3 px-4 text-center">Konfigurasi Port</th>
              <th class="py-3 px-4 text-center">Aksi</th>
            </tr>
          </thead>
          <tbody id="devices-table-body" class="divide-y divide-slate-700/60">
            <% devices.forEach(dev => { %>
              <tr class="device-row hover:bg-slate-700/30 transition">
                <td class="py-3.5 px-4">
                  <div class="text-slate-200 font-medium">
                    <a href="/devices/<%= dev.id %>/visual" class="text-emerald-400 hover:underline">
                      <%= dev.hostname %>
                    </a>
                  </div>
                  <% if (dev.asset_code) { %>
                    <a href="/assets/<%= dev.asset_id %>" class="inline-block mt-0.5 text-[10px] font-mono text-sky-500 hover:underline">
                      <%= dev.asset_code %>
                    </a>
                  <% } %>
                </td>
                <td class="py-3.5 px-4">
                  <div class="text-slate-200 font-medium"><%= dev.branch_code %></div>
                </td>
                <td class="py-3.5 px-4">
                  <div class="text-slate-200 font-medium"><%= dev.room_location || '-' %></div>
                </td>
                <td class="py-3.5 px-4">
                  <div class="text-slate-200 font-medium"><%= dev.type_name %></div>
                </td>
                <td class="py-3.5 px-4">
                  <% if (dev.is_switch === 1) { %>
                    <div class="text-slate-200 font-medium">
                      <%= dev.switch_management %>
                      <% if (dev.is_poe) { %>
                        <span class="ml-1 bg-amber-500/15 dark:text-amber-300 border border-amber-500/30 px-1 py-0.2 rounded text-xs">&#9889;PoE</span>
                      <% } %>
                    </div>
                  <% } else { %>
                    <span class="text-slate-500">-</span>
                  <% } %>
                </td>
                <td class="py-3.5 px-4">
                  <div class="text-slate-200 font-medium"><%= dev.display_brand || dev.brand || '-' %></div>
                </td>
                <td class="py-3.5 px-4">
                  <div class="text-slate-200 font-medium"><%= dev.display_model || dev.model || '-' %></div>
                </td>
                <td class="py-3.5 px-4 font-mono">
                  <div class="text-slate-200 font-medium"><%= dev.ip_address || 'No IP' %></div>
                </td>
                <td class="py-3.5 px-4 font-mono">
                  <div class="text-slate-200 font-medium"><%= dev.mac_address || '-' %></div>
                </td>
                <td class="py-3.5 px-4 text-center">
                  <div class="inline-flex flex-wrap items-center justify-center gap-1.5 font-medium">
                    <% if (dev.rj45_count > 0) { %>
                      <span class="bg-slate-100 text-slate-700 border border-slate-300 dark:bg-slate-700/80 dark:text-slate-200 dark:border-slate-600 px-2 py-0.5 rounded text-[11px]">
                        <%= dev.rj45_count %> RJ45 (<%= dev.rj45_capacity || '1G' %>)
                      </span>
                    <% } %>
                    <% if (dev.sfp_count > 0) { %>
                      <span class="bg-sky-100 text-sky-800 border border-sky-200 dark:bg-sky-500/15 dark:text-sky-300 dark:border-sky-500/30 px-2 py-0.5 rounded text-[11px]">
                        <%= dev.sfp_count %> SFP (<%= dev.sfp_capacity || '1G' %>)
                      </span>
                    <% } %>
                    <% if (dev.sfp_plus_count > 0) { %>
                      <span class="bg-indigo-100 text-indigo-800 border border-indigo-200 dark:bg-indigo-500/15 dark:text-indigo-300 dark:border-indigo-500/30 px-2 py-0.5 rounded text-[11px]">
                        <%= dev.sfp_plus_count %> SFP+ (<%= dev.sfp_plus_capacity || '10G' %>)
                      </span>
                    <% } %>
                    <% if (dev.qsfp_plus_count > 0) { %>
                      <span class="bg-purple-100 text-purple-800 border border-purple-200 dark:bg-purple-500/15 dark:text-purple-300 dark:border-purple-500/30 px-2 py-0.5 rounded text-[11px]">
                        <%= dev.qsfp_plus_count %> QSFP+ (<%= dev.qsfp_plus_capacity || '40G' %>)
                      </span>
                    <% } %>
                    <% if (dev.qsfp28_count > 0) { %>
                      <span class="bg-amber-100 text-amber-800 border border-amber-200 dark:bg-amber-500/15 dark:text-amber-300 dark:border-amber-500/30 px-2 py-0.5 rounded text-[11px]">
                        <%= dev.qsfp28_count %> QSFP28 (<%= dev.qsfp28_capacity || '100G' %>)
                      </span>
                    <% } %>
                  </div>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <div class="inline-flex items-center justify-end gap-1.5">
                    <a href="/devices/<%= dev.id %>/visual"
                      title="Visual Faceplate & Port"
                      class="p-2 rounded-lg bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-400 border border-emerald-500/30 transition">
                      <i data-lucide="network" class="w-4 h-4"></i>
                    </a>

                    <% if (can('device.write')) { %>
                      <button type="button"
                        title="Edit Visual & Port"
                        data-device="<%= JSON.stringify(dev) %>"
                        onclick="openEditDeviceModal(this)"
                        class="p-2 rounded-lg bg-sky-500/10 hover:bg-sky-500/20 text-sky-400 border border-sky-500/30 transition cursor-pointer">
                        <i data-lucide="square-pen" class="w-4 h-4"></i>
                      </button>

                      <button type="button"
                        title="Bongkar dari Jaringan"
                        onclick="confirmDeleteDevice('<%= dev.id %>', '<%= dev.hostname %>')"
                        class="p-2 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 transition cursor-pointer">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                      </button>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Empty State Saat Pencarian Tidak Ditemukan -->
      <div id="no-search-results" class="hidden text-center py-12 px-4 text-slate-500 dark:text-slate-400 text-xs space-y-2 bg-white dark:bg-slate-800">
        <i data-lucide="search-x" class="w-8 h-8 mx-auto text-slate-400 dark:text-slate-500"></i>
        <p>Tidak ditemukan perangkat yang cocok dengan kata kunci <span id="search-query-label" class="font-semibold text-slate-800 dark:text-white"></span>.</p>
        <button type="button" onclick="clearDeviceSearch()" class="text-emerald-600 dark:text-emerald-400 hover:underline font-medium cursor-pointer">
          Reset Pencarian
        </button>
      </div>

      <!-- Footer Pagination -->
      <div id="pagination-footer" class="px-4 py-3 border-t border-slate-200 dark:border-slate-700/80 bg-slate-50/80 dark:bg-slate-900/30 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-600 dark:text-slate-400">
        <div id="pagination-info">
          Menampilkan <span class="text-slate-900 dark:text-white font-semibold">0</span> perangkat
        </div>
        <div id="pagination-controls" class="inline-flex items-center gap-1.5"></div>
      </div>
    <% } %>
  </div>

</main>

<!-- Form Tersembunyi untuk Submit Bongkar Perangkat via Global Confirm Modal -->
<form id="delete-device-form" method="POST" class="hidden"></form>

<!-- =========================================================
     MODAL 1: PASANG PERANGKAT DARI MASTER ASSETS
     ========================================================= -->
<div id="modal-add-device" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
  <div onclick="closeModal('modal-add-device')" class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm"></div>

  <div class="relative bg-slate-800 border border-slate-700 rounded-2xl w-full max-w-2xl max-h-[90vh] flex flex-col shadow-2xl z-10">
    <div class="px-6 py-4 border-b border-slate-700 flex items-center justify-between">
      <h3 class="text-base font-semibold text-emerald-400">Distribusi Perangkat dari Aset</h3>
      <button type="button" onclick="closeModal('modal-add-device')" class="text-slate-400 hover:text-white p-1 cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form action="/devices" method="POST" class="p-6 overflow-y-auto space-y-4 text-sm">
      <!-- Pilih Unit dari Stok Master Assets (Spare) -->
      <div class="bg-emerald-500/10 border border-emerald-500/30 rounded-xl p-3.5 space-y-2.5">
        <div class="flex items-center justify-between">
          <label for="add_asset_search_input" class="text-xs font-semibold text-emerald-300">Pilih Unit Aset *</label>
          <% if (can('menu.assets')) { %>
            <a href="/assets" class="text-[11px] text-sky-400 hover:underline font-medium">+ Tambah Aset Baru</a>
          <% } %>
        </div>

        <!-- Hidden select asli agar form validation (required) & submit tetap standar -->
        <select name="asset_id" id="add_asset_id" required class="sr-only" tabindex="-1" aria-hidden="true">
          <option value="">-- Pilih Kode Aset Spare yang Akan Dipasang --</option>
          <% if (typeof spareAssets !== 'undefined') { %>
            <% spareAssets.forEach(sa => { %>
              <option value="<%= sa.id %>"
                data-code="<%= sa.asset_code %>"
                data-branch-label="<%= sa.branch_code %>"
                data-type-name="<%= sa.type_name %>"
                data-is-switch="<%= sa.is_switch %>"
                data-brand-model="<%= [sa.brand_name, sa.model_name].filter(Boolean).join(' ') || '-' %>"
                data-mac="<%= sa.mac_address || '-' %>"
                data-sn="<%= sa.serial_number || '-' %>">
                [<%= sa.asset_code %>] <%= sa.type_name %> - <%= sa.brand_name || '' %> <%= sa.model_name || '' %> (<%= sa.branch_code %> | SN: <%= sa.serial_number || '-' %>)
              </option>
            <% }) %>
          <% } %>
        </select>

        <!-- Custom Searchable Input & Dropdown List -->
        <div id="spare-asset-combobox" class="relative">
          <div class="relative flex items-center">
            <i data-lucide="search" class="w-3.5 h-3.5 text-slate-400 absolute left-3 pointer-events-none"></i>
            <input type="text" id="add_asset_search_input"
              autocomplete="off"
              placeholder="Ketik kode aset, jenis, merk/model, cabang, atau SN..."
              onfocus="openSpareAssetDropdown()"
              oninput="filterSpareAssetOptions(this.value)"
              class="w-full bg-slate-900 border border-slate-600 rounded-lg pl-8 pr-14 py-2 text-xs text-white placeholder-slate-400 focus:outline-none focus:border-emerald-400 transition">

            <button type="button" id="clear-spare-asset-btn" onclick="clearSelectedSpareAsset()"
              title="Hapus pilihan aset"
              class="hidden text-slate-400 hover:text-rose-400 absolute right-7 p-1 cursor-pointer">
              <i data-lucide="x" class="w-3.5 h-3.5"></i>
            </button>
            <button type="button" onclick="toggleSpareAssetDropdown()"
              title="Buka/tutup daftar aset"
              class="text-slate-400 hover:text-emerald-400 absolute right-2 p-1 cursor-pointer">
              <i data-lucide="chevron-down" class="w-4 h-4"></i>
            </button>
          </div>

          <!-- Daftar Hasil Pencarian Aset -->
          <div id="spare-asset-dropdown-list"
            class="hidden absolute left-0 right-0 mt-1 max-h-56 overflow-y-auto bg-slate-900 border border-slate-600 rounded-lg shadow-2xl z-30 divide-y divide-slate-800">
          </div>
        </div>

        <!-- Ringkasan Spesifikasi Fisik Otomatis dari Master Assets -->
        <div id="add_asset_spec_card" class="hidden bg-slate-900/90 border border-slate-700 rounded-lg p-3 grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-xs">
          <div>
            <span class="text-[10px] text-slate-400 block uppercase">Cabang</span>
            <span id="spec_branch" class="text-slate-200 font-semibold">-</span>
          </div>
          <div>
            <span class="text-[10px] text-slate-400 block uppercase">Jenis & Brand/Model</span>
            <span id="spec_device" class="text-slate-200 font-semibold">-</span>
          </div>
          <div>
            <span class="text-[10px] text-slate-400 block uppercase">Serial Number</span>
            <span id="spec_sn" class="text-slate-200 font-mono">-</span>
          </div>
          <div>
            <span class="text-[10px] text-slate-400 block uppercase">MAC Address</span>
            <span id="spec_mac" class="text-slate-200 font-mono">-</span>
          </div>
        </div>
      </div>

      <!-- Opsi Switch (Otomatis muncul jika aset berjenis Switch) -->
      <div id="add_switch_options" class="hidden bg-slate-900/80 border border-emerald-500/30 rounded-lg p-3.5 grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-emerald-300 text-xs mb-1">Tipe Switch</label>
          <select name="switch_management" id="add_switch_management" onchange="toggleIpField('add')" class="w-full bg-slate-800 border border-slate-600 rounded-lg px-3 py-1.5 text-white">
            <option value="Managed">Managed</option>
            <option value="Unmanaged">Unmanaged</option>
          </select>
        </div>
        <div>
          <label class="block text-emerald-300 text-xs mb-1">Dukungan Daya</label>
          <select name="is_poe" class="w-full bg-slate-800 border border-slate-600 rounded-lg px-3 py-1.5 text-white">
            <option value="0">Non-PoE</option>
            <option value="1">PoE (Power over Ethernet)</option>
          </select>
        </div>
      </div>

      <!-- Data Operasional Jaringan -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label class="block text-slate-300 text-xs mb-1">Nama / Hostname *</label>
          <input type="text" name="hostname" placeholder="RSB-IGD-SW-01" required class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white text-xs focus:outline-none focus:border-emerald-400">
        </div>
        <div>
          <label class="block text-slate-300 text-xs mb-1">Lokasi Ruangan</label>
          <input type="text" name="room_location" placeholder="Ruang Server Lt.2" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white text-xs focus:outline-none focus:border-emerald-400">
        </div>
        <div>
          <label class="block text-slate-300 text-xs mb-1">IP Address</label>
          <input type="text" name="ip_address" id="add_ip_address" placeholder="10.10.1.2" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white text-xs focus:outline-none focus:border-emerald-400">
        </div>
      </div>

      <!-- Konfigurasi Semua Tipe Port, Template Faceplate & Kapasitas -->
      <div class="bg-slate-900/60 border border-slate-700 rounded-lg p-3.5 space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2 border-b border-slate-800">
          <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Konfigurasi Port & Faceplate</span>
          <div class="flex flex-wrap items-center justify-center gap-2">
            <select name="faceplate_template" id="add_faceplate_template" onchange="onFaceplateTemplateChange('add')"
              title="Template Visual Sasis Perangkat"
              class="bg-slate-800 border border-emerald-500/40 rounded px-2.5 py-1 text-xs text-emerald-300 font-medium focus:outline-none focus:border-emerald-400">
              <option value="rackmount">Rackmount</option>
              <option value="non_rackmount">Non-Rackmount</option>
              <option value="modem_ont">Modem / ONT</option>
              <option value="access_point">Access Point</option>
              <option value="home_router">Home Router</option>
              <option value="voip">VoIP / IP Phone</option>
              <option value="dvr_nvr">DVR / NVR</option>
              <option value="cctv">CCTV / IP Camera</option>
            </select>

            <select name="port_layout" id="add_port_layout" class="bg-slate-800 border border-slate-600 rounded px-2.5 py-1 text-xs text-slate-200">
              <option value="2_row">2 Baris</option>
              <option value="1_row">1 Baris</option>
            </select>
          </div>
        </div>

        <div class="space-y-2.5 text-xs">
          <!-- RJ45 -->
          <div class="grid grid-cols-12 gap-2 items-center">
            <span class="col-span-4 font-semibold text-slate-200">RJ45 (LAN)</span>
            <div class="col-span-4">
              <input type="number" name="rj45_count" value="8" min="0" max="64" placeholder="Jumlah" class="w-full bg-slate-800 border border-slate-600 rounded px-2.5 py-1.5 text-white">
            </div>
            <div class="col-span-4">
              <select name="rj45_capacity" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1.5 text-white">
                <option value="100M">100 Mbps</option>
                <option value="1G" selected>1 Gbps</option>
                <option value="2.5G">2.5 Gbps</option>
                <option value="10G">10 Gbps</option>
              </select>
            </div>
          </div>

          <!-- SFP -->
          <div class="grid grid-cols-12 gap-2 items-center">
            <span class="col-span-4 font-semibold text-sky-300">SFP</span>
            <div class="col-span-4">
              <input type="number" name="sfp_count" value="0" min="0" max="32" placeholder="Jumlah" class="w-full bg-slate-800 border border-slate-600 rounded px-2.5 py-1.5 text-white">
            </div>
            <div class="col-span-4">
              <select name="sfp_capacity" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1.5 text-white">
                <option value="100M">100 Mbps</option>
                <option value="1G" selected>1 Gbps</option>
                <option value="2.5G">2.5 Gbps</option>
              </select>
            </div>
          </div>

          <!-- SFP+ -->
          <div class="grid grid-cols-12 gap-2 items-center">
            <span class="col-span-4 font-semibold text-indigo-300">SFP+</span>
            <div class="col-span-4">
              <input type="number" name="sfp_plus_count" value="0" min="0" max="32" placeholder="Jumlah" class="w-full bg-slate-800 border border-slate-600 rounded px-2.5 py-1.5 text-white">
            </div>
            <div class="col-span-4">
              <select name="sfp_plus_capacity" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1.5 text-white">
                <option value="1G">1 Gbps</option>
                <option value="10G" selected>10 Gbps</option>
                <option value="25G">25 Gbps (SFP28)</option>
              </select>
            </div>
          </div>

          <!-- QSFP+ -->
          <div class="grid grid-cols-12 gap-2 items-center">
            <span class="col-span-4 font-semibold text-purple-300">QSFP+</span>
            <div class="col-span-4">
              <input type="number" name="qsfp_plus_count" value="0" min="0" max="16" placeholder="Jumlah" class="w-full bg-slate-800 border border-slate-600 rounded px-2.5 py-1.5 text-white">
            </div>
            <div class="col-span-4">
              <select name="qsfp_plus_capacity" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1.5 text-white">
                <option value="40G" selected>40 Gbps</option>

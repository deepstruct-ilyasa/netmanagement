              <input type="number" name="rj45_count" id="edit_rj45_count" min="0" max="64" class="w-full bg-slate-800 border border-slate-600 rounded px-2.5 py-1.5 text-white">
            </div>
            <div class="col-span-4">
              <select name="rj45_capacity" id="edit_rj45_capacity" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1.5 text-white">
                <option value="100M">100 Mbps</option>
                <option value="1G">1 Gbps</option>

      <div class="pt-3 border-t border-slate-700 flex justify-end gap-3">
        <button type="button" onclick="closeModal('modal-edit-device')" class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 font-medium transition cursor-pointer">
          Batal
        </button>
        <button type="submit" class="px-5 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-semibold transition cursor-pointer">
          Update Perangkat
        </button>

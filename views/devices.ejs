</div>

<script>
  let addSelectedIsSwitch = false;

  // =========================================================
  // TAMPILKAN RINGKASAN SPESIFIKASI SAAT MEMILIH ASET SPARE
  // =========================================================
  function onSelectSpareAsset(selectEl) {
    const opt = selectEl.options[selectEl.selectedIndex];
    const specCard = document.getElementById('add_asset_spec_card');
    const switchOpts = document.getElementById('add_switch_options');

    if (!selectEl.value) {
      specCard.classList.add('hidden');
      switchOpts.classList.add('hidden');
      addSelectedIsSwitch = false;
      toggleIpField('add');
      return;
    }

    document.getElementById('spec_branch').textContent = opt.getAttribute('data-branch-label') || '-';
    const typeName = opt.getAttribute('data-type-name') || '';
    const brandModel = opt.getAttribute('data-brand-model') || '';
    document.getElementById('spec_device').textContent = `${typeName} (${brandModel})`;
    document.getElementById('spec_sn').textContent = opt.getAttribute('data-sn') || '-';
    document.getElementById('spec_mac').textContent = opt.getAttribute('data-mac') || '-';
    specCard.classList.remove('hidden');

    addSelectedIsSwitch = opt.getAttribute('data-is-switch') === '1';
    if (addSelectedIsSwitch) {
      switchOpts.classList.remove('hidden');
    } else {
      switchOpts.classList.add('hidden');
    }
    toggleIpField('add');
  }

  // =========================================================
  // AUTO-ADJUST PORT LAYOUT SAAT TEMPLATE FACEPLATE DIPILIH
  // =========================================================
  function onFaceplateTemplateChange(prefix) {
    const tplSelect = document.getElementById(`${prefix}_faceplate_template`);
    const layoutSelect = document.getElementById(`${prefix}_port_layout`);
    if (!tplSelect || !layoutSelect) return;

    const tpl = tplSelect.value;
    if (['modem_ont', 'access_point', 'home_router', 'voip', 'dvr_nvr', 'cctv'].includes(tpl)) {
      layoutSelect.value = '1_row';
    } else if (tpl === 'rackmount') {
      layoutSelect.value = '2_row';
    }
  }

  function toggleIpField(prefix) {
    const isSwitch = prefix === 'add'
      ? addSelectedIsSwitch
      : document.getElementById('edit_is_switch_flag').value === '1';
    const mgmt = document.getElementById(`${prefix}_switch_management`).value;
    const ipInput = document.getElementById(`${prefix}_ip_address`);

    if (isSwitch && mgmt === 'Unmanaged') {
      ipInput.value = '';
      ipInput.disabled = true;
      ipInput.placeholder = 'Unmanaged (No IP)';
    } else {
      ipInput.disabled = false;
      ipInput.placeholder = '10.10.1.2';
    }
  }

  // =========================================================
  // LOGIKA SEARCH & PAGINATION TABEL PERANGKAT
  // =========================================================
  const STORAGE_KEY = 'netmgmt_devices_table_state';

  function loadTableState() {
    try {
      const saved = JSON.parse(sessionStorage.getItem(STORAGE_KEY));
      if (saved && typeof saved === 'object') {
        return {
          currentPage: parseInt(saved.currentPage, 10) || 1,
          perPage: saved.perPage || '8',
          searchQuery: saved.searchQuery || ''
        };
      }
    } catch (e) {}
    return { currentPage: 1, perPage: '8', searchQuery: '' };
  }

  function saveTableState() {
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify({
        currentPage,
        perPage,
        searchQuery
      }));
    } catch (e) {}
  }

  const initialState = loadTableState();
  let currentPage = initialState.currentPage;
  let perPage = initialState.perPage;
  let searchQuery = initialState.searchQuery;

  function renderDeviceTable() {
    const allRows = Array.from(document.querySelectorAll('#devices-table-body .device-row'));
    if (allRows.length === 0) return;

    const query = searchQuery.trim().toLowerCase();
    const matchedRows = allRows.filter(row => {
      if (!query) return true;
      return row.textContent.toLowerCase().includes(query);
    });

    const totalMatched = matchedRows.length;
    const effectivePerPage = perPage === 'all' ? Math.max(totalMatched, 1) : parseInt(perPage, 10);
    const totalPages = Math.max(Math.ceil(totalMatched / effectivePerPage), 1);

    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    saveTableState();

    const startIndex = (currentPage - 1) * effectivePerPage;
    const endIndex = startIndex + effectivePerPage;

    allRows.forEach(row => row.classList.add('hidden'));
    matchedRows.slice(startIndex, endIndex).forEach(row => row.classList.remove('hidden'));

    const noResultsBox = document.getElementById('no-search-results');
    const paginationFooter = document.getElementById('pagination-footer');
    const tableWrapper = document.querySelector('#devices-table-body').closest('.overflow-x-auto');

    if (totalMatched === 0) {
      noResultsBox.classList.remove('hidden');
      paginationFooter.classList.add('hidden');
      tableWrapper.classList.add('hidden');
      document.getElementById('search-query-label').textContent = `"${searchQuery}"`;
      return;
    } else {
      noResultsBox.classList.add('hidden');
      paginationFooter.classList.remove('hidden');
      tableWrapper.classList.remove('hidden');
    }

    const showingStart = startIndex + 1;
    const showingEnd = Math.min(endIndex, totalMatched);
    const filterNote = query ? ` (difilter dari total ${allRows.length} perangkat)` : '';
    document.getElementById('pagination-info').innerHTML =
      `Menampilkan <span class="text-slate-900 dark:text-white font-semibold">${showingStart}&ndash;${showingEnd}</span> dari <span class="text-slate-900 dark:text-white font-semibold">${totalMatched}</span> perangkat${filterNote}`;

    const controlsEl = document.getElementById('pagination-controls');
    controlsEl.innerHTML = '';

    if (totalPages <= 1) return;

    const createPageBtn = (label, targetPage, isActive = false, isDisabled = false) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.innerHTML = label;
      btn.disabled = isDisabled;

      if (isActive) {
        btn.className = 'px-2.5 py-1 rounded-md bg-emerald-500 text-white dark:text-slate-950 font-bold shadow-2xs cursor-default';
      } else if (isDisabled) {
        btn.className = 'px-2.5 py-1 rounded-md bg-slate-100 text-slate-400 border border-slate-200 dark:bg-slate-800/50 dark:text-slate-600 dark:border-slate-700/50 cursor-not-allowed';
      } else {
        btn.className = 'px-2.5 py-1 rounded-md bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300 dark:border-slate-600 transition cursor-pointer shadow-2xs';
        btn.onclick = () => {
          currentPage = targetPage;
          renderDeviceTable();
        };
      }
      return btn;
    };

    controlsEl.appendChild(createPageBtn('&laquo; Prev', currentPage - 1, false, currentPage === 1));

    const pagesToShow = [];
    for (let p = 1; p <= totalPages; p++) {
      if (p === 1 || p === totalPages || (p >= currentPage - 1 && p <= currentPage + 1)) {
        pagesToShow.push(p);
      } else if (pagesToShow[pagesToShow.length - 1] !== '...') {
        pagesToShow.push('...');
      }
    }

    pagesToShow.forEach(item => {
      if (item === '...') {
        const dots = document.createElement('span');
        dots.textContent = '...';
        dots.className = 'px-2 py-1 text-slate-500';
        controlsEl.appendChild(dots);
      } else {
        controlsEl.appendChild(createPageBtn(item, item, item === currentPage, false));
      }
    });

    controlsEl.appendChild(createPageBtn('Next &raquo;', currentPage + 1, false, currentPage === totalPages));
  }

  function handleSearchChange() {
    const input = document.getElementById('device-search-input');
    const clearBtn = document.getElementById('clear-search-btn');
    searchQuery = input.value;
    currentPage = 1;

    if (searchQuery.length > 0) {
      clearBtn.classList.remove('hidden');
    } else {
      clearBtn.classList.add('hidden');
    }
    renderDeviceTable();
  }

  function clearDeviceSearch() {
    const input = document.getElementById('device-search-input');
    input.value = '';
    searchQuery = '';
    currentPage = 1;
    document.getElementById('clear-search-btn').classList.add('hidden');
    renderDeviceTable();
    input.focus();
  }

  function handlePerPageChange() {
    perPage = document.getElementById('devices-per-page').value;
    currentPage = 1;
    renderDeviceTable();
  }

  // =========================================================
  // LOGIKA MODAL EDIT & HAPUS
  // =========================================================
  function openEditDeviceModal(btn) {
    const dev = JSON.parse(btn.getAttribute('data-device'));

    document.getElementById('edit-device-form').action = `/devices/${dev.id}/update`;
    document.getElementById('edit_asset_code_label').textContent = dev.asset_code || `#${dev.asset_id || '-'}`;
    document.getElementById('edit_asset_detail_link').href = dev.asset_id ? `/assets/${dev.asset_id}` : '/assets';

    document.getElementById('edit_spec_branch').textContent = `[${dev.branch_code}] ${dev.branch_name}`;
    const brandModel = [dev.display_brand || dev.brand, dev.display_model || dev.model].filter(Boolean).join(' ') || '-';
    document.getElementById('edit_spec_device').textContent = `${dev.type_name} (${brandModel})`;
    document.getElementById('edit_spec_sn').textContent = dev.serial_number || '-';
    document.getElementById('edit_spec_mac').textContent = dev.mac_address || '-';

    const isSwitch = dev.is_switch === 1;
    document.getElementById('edit_is_switch_flag').value = isSwitch ? '1' : '0';
    const switchOpts = document.getElementById('edit_switch_options');
    if (isSwitch) {
      switchOpts.classList.remove('hidden');
    } else {
      switchOpts.classList.add('hidden');
    }

    document.getElementById('edit_switch_management').value = dev.switch_management || 'Managed';
    document.getElementById('edit_is_poe').value = dev.is_poe ? '1' : '0';
    document.getElementById('edit_hostname').value = dev.hostname || '';
    document.getElementById('edit_room_location').value = dev.room_location || '';
    document.getElementById('edit_ip_address').value = dev.ip_address || '';

    document.getElementById('edit_faceplate_template').value = dev.faceplate_template || 'rackmount';
    document.getElementById('edit_port_layout').value = dev.port_layout || '2_row';

    document.getElementById('edit_rj45_count').value = dev.rj45_count || 0;
    document.getElementById('edit_rj45_capacity').value = dev.rj45_capacity || '1G';

    document.getElementById('edit_sfp_count').value = dev.sfp_count || 0;
    document.getElementById('edit_sfp_capacity').value = dev.sfp_capacity || '1G';

    document.getElementById('edit_sfp_plus_count').value = dev.sfp_plus_count || 0;
    document.getElementById('edit_sfp_plus_capacity').value = dev.sfp_plus_capacity || '10G';

    document.getElementById('edit_qsfp_plus_count').value = dev.qsfp_plus_count || 0;
    document.getElementById('edit_qsfp_plus_capacity').value = dev.qsfp_plus_capacity || '40G';

    document.getElementById('edit_qsfp28_count').value = dev.qsfp28_count || 0;
    document.getElementById('edit_qsfp28_capacity').value = dev.qsfp28_capacity || '100G';

    toggleIpField('edit');
    openModal('modal-edit-device');
  }

  function confirmDeleteDevice(deviceId, hostname) {
    showAppConfirm({
      title: 'Bongkar Perangkat dari Jaringan?',
      message: `Apakah Anda yakin ingin membongkar perangkat ${hostname} dari topologi jaringan? Seluruh data port dan koneksi kabel akan dihapus, sementara unit asetnya otomatis dikembalikan ke status Spare di Master Assets.`,
      type: 'danger',
      confirmText: 'Ya, Bongkar & Kembalikan ke Spare',
      onConfirm: () => {
        const form = document.getElementById('delete-device-form');
        form.action = `/devices/${deviceId}/delete`;
        form.submit();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('device-search-input');
    const perPageSelect = document.getElementById('devices-per-page');
    const clearBtn = document.getElementById('clear-search-btn');

    if (searchInput && searchQuery) {
      searchInput.value = searchQuery;
      if (clearBtn) clearBtn.classList.remove('hidden');
    }
    if (perPageSelect && perPage) {
      perPageSelect.value = String(perPage);
    }

    renderDeviceTable();

    const serverError = <%- JSON.stringify(typeof errorMsg !== 'undefined' ? errorMsg : null) %>;
    const serverSuccess = <%- JSON.stringify(typeof successMsg !== 'undefined' ? successMsg : null) %>;

    if (serverError) {
      showAppAlert('error', 'Terjadi Kesalahan', serverError);
    } else if (serverSuccess) {
      showAppAlert('success', 'Berhasil', serverSuccess);
    }
  });

  // =========================================================
  // SEARCHABLE AUTOCOMPLETE UNTUK PILIH UNIT ASET SPARE
  // =========================================================
  function getSpareAssetItemsFromSelect() {
    const selectEl = document.getElementById('add_asset_id');
    if (!selectEl) return [];
    return Array.from(selectEl.options)
      .filter(opt => opt.value !== '')
      .map(opt => ({
        id: opt.value,
        label: opt.textContent.trim(),
        code: opt.getAttribute('data-code') || '',
        branchLabel: opt.getAttribute('data-branch-label') || '',
        typeName: opt.getAttribute('data-type-name') || '',
        brandModel: opt.getAttribute('data-brand-model') || '',
        sn: opt.getAttribute('data-sn') || '-',
        mac: opt.getAttribute('data-mac') || '-'
      }));
  }

  function renderSpareAssetDropdownItems(keyword = '') {
    const listEl = document.getElementById('spare-asset-dropdown-list');
    const selectEl = document.getElementById('add_asset_id');
    if (!listEl || !selectEl) return;

    const allItems = getSpareAssetItemsFromSelect();
    const q = keyword.trim().toLowerCase();
    const filtered = q
      ? allItems.filter(item =>
          item.label.toLowerCase().includes(q) ||
          item.mac.toLowerCase().includes(q)
        )
      : allItems;

    if (filtered.length === 0) {
      listEl.innerHTML = `
        <div class="px-3 py-3 text-xs text-slate-400 text-center">
          Tidak ada aset spare yang cocok <span class="text-white font-semibold">${keyword.replace(/</g, '&lt;')}</span>.
        </div>
      `;
      return;
    }

    listEl.innerHTML = filtered.map(item => {
      const isSelected = String(selectEl.value) === String(item.id);
      return `
        <button type="button"
          onclick="selectSpareAssetItem('${item.id}')"
          class="w-full text-left px-3 py-2 text-xs hover:bg-emerald-500/15 transition flex flex-col gap-0.5 cursor-pointer ${isSelected ? 'bg-emerald-500/20 text-emerald-300' : 'text-slate-200'}">
          <div class="flex items-center justify-between gap-2">
            <span class="font-mono font-bold text-emerald-400">${item.code}</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-800 border border-slate-700 text-slate-300">${item.branchLabel}</span>
          </div>
          <div class="text-slate-200 font-medium truncate">
            ${item.typeName} &mdash; ${item.brandModel}
          </div>
          <div class="text-[10px] text-slate-400 font-mono">
            SN: ${item.sn} &bull; MAC: ${item.mac}
          </div>
        </button>
      `;
    }).join('');
  }

  function openSpareAssetDropdown() {
    const listEl = document.getElementById('spare-asset-dropdown-list');
    const searchInput = document.getElementById('add_asset_search_input');
    if (!listEl) return;

    // Jika sudah ada aset terpilih, tampilkan semua opsi saat diklik ulang agar mudah ganti pilihan
    const selectEl = document.getElementById('add_asset_id');
    const keyword = selectEl && selectEl.value ? '' : (searchInput ? searchInput.value : '');
    renderSpareAssetDropdownItems(keyword);
    listEl.classList.remove('hidden');
  }

  function toggleSpareAssetDropdown() {
    const listEl = document.getElementById('spare-asset-dropdown-list');
    if (!listEl) return;
    if (listEl.classList.contains('hidden')) {
      openSpareAssetDropdown();
      document.getElementById('add_asset_search_input')?.focus();
    } else {
      listEl.classList.add('hidden');
    }
  }

  function filterSpareAssetOptions(val) {
    const selectEl = document.getElementById('add_asset_id');
    const clearBtn = document.getElementById('clear-spare-asset-btn');
    const listEl = document.getElementById('spare-asset-dropdown-list');

    // Reset pilihan sebelumnya jika user mengetik ulang kata kunci baru
    if (selectEl && selectEl.value) {
      selectEl.value = '';
      onSelectSpareAsset(selectEl);
    }

    if (clearBtn) {
      clearBtn.classList.toggle('hidden', val.trim().length === 0);
    }

    renderSpareAssetDropdownItems(val);
    if (listEl) listEl.classList.remove('hidden');
  }

  function selectSpareAssetItem(assetId) {
    const selectEl = document.getElementById('add_asset_id');
    const searchInput = document.getElementById('add_asset_search_input');
    const clearBtn = document.getElementById('clear-spare-asset-btn');
    const listEl = document.getElementById('spare-asset-dropdown-list');

    if (!selectEl) return;
    selectEl.value = assetId;

    const selectedOpt = selectEl.options[selectEl.selectedIndex];
    if (searchInput && selectedOpt) {
      searchInput.value = selectedOpt.textContent.trim();
    }
    if (clearBtn) clearBtn.classList.remove('hidden');
    if (listEl) listEl.classList.add('hidden');

    onSelectSpareAsset(selectEl);
  }

  function clearSelectedSpareAsset() {
    const selectEl = document.getElementById('add_asset_id');
    const searchInput = document.getElementById('add_asset_search_input');
    const clearBtn = document.getElementById('clear-spare-asset-btn');
    const listEl = document.getElementById('spare-asset-dropdown-list');

    if (selectEl) {
      selectEl.value = '';
      onSelectSpareAsset(selectEl);
    }
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
    }
    if (clearBtn) clearBtn.classList.add('hidden');
    renderSpareAssetDropdownItems('');
    if (listEl) listEl.classList.remove('hidden');
  }

  // Tutup dropdown otomatis jika klik di luar area combobox
  document.addEventListener('click', function (e) {
    const combobox = document.getElementById('spare-asset-combobox');
    const listEl = document.getElementById('spare-asset-dropdown-list');
    if (combobox && listEl && !combobox.contains(e.target)) {
      listEl.classList.add('hidden');
    }
  });
</script>

<%- include('partials/footer') %>
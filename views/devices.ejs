            </div>
            <div class="col-span-4">
              <select name="sfp_capacity" id="edit_sfp_capacity" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1.5 text-white">
                <option value="100M">100 Mbps</option>
                <option value="1G">1 Gbps</option>
                <option value="2.5G">2.5 Gbps</option>
              </select>
            </div>
          </div>

          <!-- SFP+ -->
          <div class="grid grid-cols-12 gap-2 items-center">
            <span class="col-span-4 font-semibold text-indigo-300">SFP+</span>
            <div class="col-span-4">
              <input type="number" name="sfp_plus_count" id="edit_sfp_plus_count" min="0" max="32" class="w-full bg-slate-800 border border-slate-600 rounded px-2.5 py-1.5 text-white">
            </div>
            <div class="col-span-4">
              <select name="sfp_plus_capacity" id="edit_sfp_plus_capacity" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1.5 text-white">
                <option value="1G">1 Gbps</option>
                <option value="10G">10 Gbps</option>
                <option value="25G">25 Gbps</option>
              </select>
            </div>
          </div>

          <!-- QSFP+ -->
          <div class="grid grid-cols-12 gap-2 items-center">
            <span class="col-span-4 font-semibold text-purple-300">QSFP+</span>
            <div class="col-span-4">
              <input type="number" name="qsfp_plus_count" id="edit_qsfp_plus_count" min="0" max="16" class="w-full bg-slate-800 border border-slate-600 rounded px-2.5 py-1.5 text-white">
            </div>
            <div class="col-span-4">
              <select name="qsfp_plus_capacity" id="edit_qsfp_plus_capacity" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1.5 text-white">
                <option value="40G">40 Gbps</option>
                <option value="4x10G">4x10 Gbps</option>
              </select>
            </div>
          </div>

          <!-- QSFP28 -->
          <div class="grid grid-cols-12 gap-2 items-center">
            <span class="col-span-4 font-semibold text-amber-300">QSFP28</span>
            <div class="col-span-4">
              <input type="number" name="qsfp28_count" id="edit_qsfp28_count" min="0" max="16" class="w-full bg-slate-800 border border-slate-600 rounded px-2.5 py-1.5 text-white">
            </div>
            <div class="col-span-4">
              <select name="qsfp28_capacity" id="edit_qsfp28_capacity" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1.5 text-white">
                <option value="40G">40 Gbps</option>
                <option value="100G">100 Gbps</option>

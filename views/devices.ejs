<%- include('partials/header', { pageTitle: 'Master Perangkat Jaringan' }) %>

<main class="p-4 sm:p-6 flex-1 w-full space-y-5">

  <!-- Bar Atas: Info Ringkas & Tombol Buka Modal Tambah -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-800 border border-slate-700 p-4 rounded-xl">
    <div>
      <h2 class="text-base font-semibold text-white">Daftar Aset Perangkat</h2>
      <p class="text-xs text-slate-400">Kelola perangkat jaringan tiap cabang dan konfigurasi port-nya.</p>
    </div>
    <% if (can('device.write')) { %>
      <button onclick="openModal('modal-add-device')" class="inline-flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-semibold text-sm px-4 py-2.5 rounded-lg transition shadow-sm cursor-pointer">
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>Tambah Perangkat</span>
      </button>
    <% } %>
  </div>

  <!-- Tabel Daftar Perangkat (Responsive + Search + Pagination) -->
  <div class="bg-slate-800 border border-slate-700 rounded-xl shadow-lg overflow-hidden">
    <% if (devices.length === 0) { %>
      <div class="text-center py-16 px-4 text-slate-400 text-sm">
        <p class="mb-3">Belum ada data perangkat yang terdaftar.</p>
        <% if (can('device.write')) { %>
          <button onclick="openModal('modal-add-device')" class="text-emerald-400 hover:underline font-medium cursor-pointer">
            + Tambah perangkat pertama sekarang
          </button>
        <% } %>
      </div>
    <% } else { %>
      <!-- Toolbar Search & Entries Per Page -->
      <div class="p-4 border-b border-slate-700/80 flex flex-row items-center justify-end gap-3 bg-slate-900/30">
        <div class="relative flex-1 sm:flex-initial sm:w-72">
          <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"></i>
          <input type="text" id="device-search-input"
            placeholder="Cari hostname, cabang, lokasi, IP, brand..."
            oninput="handleSearchChange()"
            class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg pl-9 pr-8 py-2 text-xs text-slate-800 dark:text-white placeholder-slate-400 focus:outline-none focus:border-emerald-500 dark:focus:border-emerald-400 transition shadow-2xs">
          <button type="button" id="clear-search-btn" onclick="clearDeviceSearch()"
            title="Hapus pencarian"
            class="hidden text-slate-400 hover:text-slate-700 dark:hover:text-white absolute right-2.5 top-1/2 -translate-y-1/2 cursor-pointer">
            <i data-lucide="x" class="w-3.5 h-3.5"></i>
          </button>
        </div>
        <div class="flex items-center gap-2 text-xs text-slate-600 dark:text-slate-400 shrink-0">
          <select id="devices-per-page" onchange="handlePerPageChange()"
            aria-label="Jumlah data per halaman"
            class="bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg px-0.5 py-2 text-slate-800 dark:text-white font-medium focus:outline-none focus:border-emerald-500 dark:focus:border-emerald-400 cursor-pointer shadow-2xs">
            <option value="8" selected>8</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="all">Semua</option>
          </select>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm whitespace-nowrap">
          <thead>
            <tr class="bg-slate-900/60 border-b border-slate-700 text-slate-400 text-xs uppercase">
              <th class="py-3 px-4">Hostname</th>
              <th class="py-3 px-4">Cabang</th>
              <th class="py-3 px-4">Lokasi</th>
              <th class="py-3 px-4">Jenis</th>
              <th class="py-3 px-4">Spesifikasi</th>
              <th class="py-3 px-4">Brand</th>
              <th class="py-3 px-4">Model</th>
              <th class="py-3 px-4">IP Address</th>
              <th class="py-3 px-4">MAC Address</th>
              <th class="py-3 px-4 text-center">Konfigurasi Port</th>
              <th class="py-3 px-4 text-center">Aksi</th>
            </tr>
          </thead>
          <tbody id="devices-table-body" class="divide-y divide-slate-700/60">
            <% devices.forEach(dev => { %>
              <tr class="device-row hover:bg-slate-700/30 transition">
                <td class="py-3.5 px-4">
                  <div class="text-slate-200 font-medium">
                    <a href="/devices/<%= dev.id %>/visual" class="text-emerald-400 hover:underline">
                      <%= dev.hostname %>
                    </a>
                  </div>
                </td>
                <td class="py-3.5 px-4">
                  <div class="text-slate-200 font-medium"><%= dev.branch_code %></div>
                </td>
                <td class="py-3.5 px-4">
                  <div class="text-slate-200 font-medium"><%= dev.room_location || '-' %></div>
                </td>
                <td class="py-3.5 px-4">
                  <div class="text-slate-200 font-medium"><%= dev.type_name %></div>
                </td>
                <td class="py-3.5 px-4">
                  <% if (dev.is_switch === 1) { %>
                    <div class="text-slate-200 font-medium">
                      <%= dev.switch_management %>
                      <% if (dev.is_poe) { %>
                        <span class="ml-1 bg-amber-500/15 dark:text-amber-300 border border-amber-500/30 px-1 py-0.2 rounded text-xs">&#9889;PoE</span>
                      <% } %>
                    </div>
                  <% } else { %>
                    <span class="text-slate-500">-</span>
                  <% } %>
                </td>
                <td class="py-3.5 px-4">
                  <div class="text-slate-200 font-medium"><%= dev.display_brand || dev.brand || '-' %></div>
                </td>
                <td class="py-3.5 px-4">
                  <div class="text-slate-200 font-medium"><%= dev.display_model || dev.model || '-' %></div>
                </td>
                <td class="py-3.5 px-4 font-mono">
                  <div class="text-slate-200 font-medium"><%= dev.ip_address || 'No IP' %></div>
                </td>
                <td class="py-3.5 px-4 font-mono">
                  <div class="text-slate-200 font-medium"><%= dev.mac_address || '-' %></div>
                </td>
                <td class="py-3.5 px-4 text-center">
                  <div class="inline-flex flex-wrap items-center justify-center gap-1.5 font-medium">
                    <% if (dev.rj45_count > 0) { %>
                      <span class="bg-slate-100 text-slate-700 border border-slate-300 dark:bg-slate-700/80 dark:text-slate-200 dark:border-slate-600 px-2 py-0.5 rounded text-[11px]">
                        <%= dev.rj45_count %> RJ45 (<%= dev.rj45_capacity || '1G' %>)
                      </span>
                    <% } %>
                    <% if (dev.sfp_count > 0) { %>
                      <span class="bg-sky-100 text-sky-800 border border-sky-200 dark:bg-sky-500/15 dark:text-sky-300 dark:border-sky-500/30 px-2 py-0.5 rounded text-[11px]">
                        <%= dev.sfp_count %> SFP (<%= dev.sfp_capacity || '1G' %>)
                      </span>
                    <% } %>
                    <% if (dev.sfp_plus_count > 0) { %>
                      <span class="bg-indigo-100 text-indigo-800 border border-indigo-200 dark:bg-indigo-500/15 dark:text-indigo-300 dark:border-indigo-500/30 px-2 py-0.5 rounded text-[11px]">
                        <%= dev.sfp_plus_count %> SFP+ (<%= dev.sfp_plus_capacity || '10G' %>)
                      </span>
                    <% } %>
                    <% if (dev.qsfp_plus_count > 0) { %>
                      <span class="bg-purple-100 text-purple-800 border border-purple-200 dark:bg-purple-500/15 dark:text-purple-300 dark:border-purple-500/30 px-2 py-0.5 rounded text-[11px]">
                        <%= dev.qsfp_plus_count %> QSFP+ (<%= dev.qsfp_plus_capacity || '40G' %>)
                      </span>
                    <% } %>
                    <% if (dev.qsfp28_count > 0) { %>
                      <span class="bg-amber-100 text-amber-800 border border-amber-200 dark:bg-amber-500/15 dark:text-amber-300 dark:border-amber-500/30 px-2 py-0.5 rounded text-[11px]">
                        <%= dev.qsfp28_count %> QSFP28 (<%= dev.qsfp28_capacity || '100G' %>)
                      </span>
                    <% } %>
                  </div>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <div class="inline-flex items-center justify-end gap-1.5">
                    <!-- Icon Visual Faceplate -->
                    <a href="/devices/<%= dev.id %>/visual"
                      title="Visual"
                      class="p-2 rounded-lg bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-400 border border-emerald-500/30 transition">
                      <i data-lucide="network" class="w-4 h-4"></i>
                    </a>

                    <% if (can('device.write')) { %>
                      <!-- Icon Edit Perangkat -->
                      <button type="button"
                        title="Edit"
                        data-device="<%= JSON.stringify(dev) %>"
                        onclick="openEditDeviceModal(this)"
                        class="p-2 rounded-lg bg-sky-500/10 hover:bg-sky-500/20 text-sky-400 border border-sky-500/30 transition cursor-pointer">
                        <i data-lucide="square-pen" class="w-4 h-4"></i>
                      </button>

                      <!-- Icon Hapus Perangkat -->
                      <button type="button"
                        title="Hapus"
                        onclick="confirmDeleteDevice('<%= dev.id %>', '<%= dev.hostname %>')"
                        class="p-2 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 transition cursor-pointer">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                      </button>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Empty State Saat Pencarian Tidak Ditemukan -->
      <div id="no-search-results" class="hidden text-center py-12 px-4 text-slate-500 dark:text-slate-400 text-xs space-y-2 bg-white dark:bg-slate-800">
        <i data-lucide="search-x" class="w-8 h-8 mx-auto text-slate-400 dark:text-slate-500"></i>
        <p>Tidak ditemukan perangkat yang cocok dengan kata kunci <span id="search-query-label" class="font-semibold text-slate-800 dark:text-white"></span>.</p>
        <button type="button" onclick="clearDeviceSearch()" class="text-emerald-600 dark:text-emerald-400 hover:underline font-medium cursor-pointer">
          Reset Pencarian
        </button>
      </div>

      <!-- Footer Pagination -->
      <div id="pagination-footer" class="px-4 py-3 border-t border-slate-200 dark:border-slate-700/80 bg-slate-50/80 dark:bg-slate-900/30 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-600 dark:text-slate-400">
        <div id="pagination-info">
          Menampilkan <span class="text-slate-900 dark:text-white font-semibold">0</span> perangkat
        </div>
        <div id="pagination-controls" class="inline-flex items-center gap-1.5"></div>
      </div>
    <% } %>
  </div>

</main>

<!-- =========================================================
     MODAL 1: TAMBAH MASTER PERANGKAT
     ========================================================= -->
<div id="modal-add-device" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
  <div onclick="closeModal('modal-add-device')" class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm"></div>

  <div class="relative bg-slate-800 border border-slate-700 rounded-2xl w-full max-w-2xl max-h-[90vh] flex flex-col shadow-2xl z-10">
    <div class="px-6 py-4 border-b border-slate-700 flex items-center justify-between">
      <h3 class="text-base font-semibold text-emerald-400">+ Tambah Master Perangkat</h3>
      <button type="button" onclick="closeModal('modal-add-device')" class="text-slate-400 hover:text-white p-1 cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form action="/devices" method="POST" enctype="multipart/form-data" class="p-6 overflow-y-auto space-y-4 text-sm">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-slate-300 mb-1">Cabang *</label>
          <select name="branch_id" required class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-emerald-400">
            <% branches.forEach(b => { %>
              <option value="<%= b.id %>">[<%= b.branch_code %>] <%= b.branch_name %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-slate-300 mb-1">Jenis Perangkat *</label>
          <select name="device_type_id" id="add_device_type_id" onchange="onDeviceTypeChange('add')" required class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-emerald-400">
            <% deviceTypes.forEach(dt => { %>
              <option value="<%= dt.id %>" data-is-switch="<%= dt.is_switch %>"><%= dt.type_name %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div id="add_switch_options" class="hidden bg-slate-900/80 border border-emerald-500/30 rounded-lg p-3.5 grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-emerald-300 text-xs mb-1">Tipe Switch</label>
          <select name="switch_management" id="add_switch_management" onchange="toggleIpField('add')" class="w-full bg-slate-800 border border-slate-600 rounded-lg px-3 py-1.5 text-white">
            <option value="Managed">Managed</option>
            <option value="Unmanaged">Unmanaged</option>
          </select>
        </div>
        <div>
          <label class="block text-emerald-300 text-xs mb-1">Dukungan Daya</label>
          <select name="is_poe" class="w-full bg-slate-800 border border-slate-600 rounded-lg px-3 py-1.5 text-white">
            <option value="0">Non-PoE</option>
            <option value="1">PoE (Power over Ethernet)</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-slate-300 mb-1">Nama / Hostname *</label>
          <input type="text" name="hostname" placeholder="RSB-IGD-SW-01" required class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-emerald-400">
        </div>
        <div>
          <label class="block text-slate-300 mb-1">Lokasi</label>
          <input type="text" name="room_location" placeholder="Ruang Server Lt.2" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-emerald-400">
        </div>
      </div>

      <!-- Cascading Dropdown Brand & Type/Model -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="text-slate-300">Brand / Merk</label>
            <% if (can('menu.brands')) { %>
              <a href="/brands" class="text-[11px] text-emerald-400 hover:underline font-medium">+ Kelola Brand</a>
            <% } %>
          </div>
          <select name="brand_id" id="add_brand_id" onchange="populateModelDropdown('add')" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-emerald-400">
            <option value="">-- Pilih Brand --</option>
            <% brands.forEach(b => { %>
              <option value="<%= b.id %>"><%= b.brand_name %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="text-slate-300">Type / Model</label>
            <% if (can('menu.device-models')) { %>
              <a href="/device-models" class="text-[11px] text-sky-400 hover:underline font-medium">+ Tambah Model</a>
            <% } %>
          </div>
          <select name="model_id" id="add_model_id" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-emerald-400">
            <option value="">-- Pilih Brand Terlebih Dahulu --</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label class="block text-slate-300 text-xs mb-1">IP Address</label>
          <input type="text" name="ip_address" id="add_ip_address" placeholder="10.10.1.2" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white text-xs">
        </div>
        <div>
          <label class="block text-slate-300 text-xs mb-1">MAC Address</label>
          <input type="text" name="mac_address" placeholder="AA:BB:CC:11:22:33" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white text-xs">
        </div>
        <div>
          <label class="block text-slate-300 text-xs mb-1">Serial Number</label>
          <input type="text" name="serial_number" placeholder="SN12345678" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white text-xs">
        </div>
      </div>

      <!-- Konfigurasi Semua Tipe Port, Template Faceplate & Kapasitas -->
      <div class="bg-slate-900/60 border border-slate-700 rounded-lg p-3.5 space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2 border-b border-slate-800">
          <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Konfigurasi Port & Visual Faceplate</span>
          <div class="flex flex-wrap items-center gap-2">
            <select name="faceplate_template" id="add_faceplate_template" onchange="onFaceplateTemplateChange('add')"
              title="Template Visual Sasis Perangkat"
              class="bg-slate-800 border border-emerald-500/40 rounded px-2.5 py-1 text-xs text-emerald-300 font-medium focus:outline-none focus:border-emerald-400">
              <option value="rackmount">Rackmount</option>
              <option value="non_rackmount">Non-Rackmount</option>
              <option value="modem_ont">Modem / ONT</option>
              <option value="access_point">Access Point</option>
              <option value="home_router">Home Router</option>
              <option value="voip">VoIP / IP Phone</option>
              <option value="dvr_nvr">DVR / NVR</option>
              <option value="cctv">CCTV / IP Camera</option>
            </select>

            <select name="port_layout" id="add_port_layout" class="bg-slate-800 border border-slate-600 rounded px-2.5 py-1 text-xs text-slate-200">
              <option value="2_row">2 Baris</option>
              <option value="1_row">1 Baris</option>
            </select>
          </div>
        </div>

        <div class="space-y-2.5 text-xs">
          <!-- RJ45 -->
          <div class="grid grid-cols-12 gap-2 items-center">
            <span class="col-span-4 font-semibold text-slate-200">RJ45 (LAN)</span>
            <div class="col-span-4">
              <input type="number" name="rj45_count" value="8" min="0" max="64" placeholder="Jumlah" class="w-full bg-slate-800 border border-slate-600 rounded px-2.5 py-1.5 text-white">
            </div>
            <div class="col-span-4">
              <select name="rj45_capacity" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1.5 text-white">
                <option value="100M">100 Mbps</option>
                <option value="1G" selected>1 Gbps</option>
                <option value="2.5G">2.5 Gbps</option>
                <option value="10G">10 Gbps</option>
              </select>
            </div>
          </div>

          <!-- SFP -->
          <div class="grid grid-cols-12 gap-2 items-center">
            <span class="col-span-4 font-semibold text-sky-300">SFP</span>
            <div class="col-span-4">
              <input type="number" name="sfp_count" value="0" min="0" max="32" placeholder="Jumlah" class="w-full bg-slate-800 border border-slate-600 rounded px-2.5 py-1.5 text-white">
            </div>
            <div class="col-span-4">
              <select name="sfp_capacity" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1.5 text-white">
                <option value="100M">100 Mbps</option>
                <option value="1G" selected>1 Gbps</option>
                <option value="2.5G">2.5 Gbps</option>
              </select>
            </div>
          </div>

          <!-- SFP+ -->
          <div class="grid grid-cols-12 gap-2 items-center">
            <span class="col-span-4 font-semibold text-indigo-300">SFP+</span>
            <div class="col-span-4">
              <input type="number" name="sfp_plus_count" value="0" min="0" max="32" placeholder="Jumlah" class="w-full bg-slate-800 border border-slate-600 rounded px-2.5 py-1.5 text-white">
            </div>
            <div class="col-span-4">
              <select name="sfp_plus_capacity" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1.5 text-white">
                <option value="1G">1 Gbps</option>
                <option value="10G" selected>10 Gbps</option>
                <option value="25G">25 Gbps (SFP28)</option>
              </select>
            </div>
          </div>

          <!-- QSFP+ -->
          <div class="grid grid-cols-12 gap-2 items-center">
            <span class="col-span-4 font-semibold text-purple-300">QSFP+</span>
            <div class="col-span-4">
              <input type="number" name="qsfp_plus_count" value="0" min="0" max="16" placeholder="Jumlah" class="w-full bg-slate-800 border border-slate-600 rounded px-2.5 py-1.5 text-white">
            </div>
            <div class="col-span-4">
              <select name="qsfp_plus_capacity" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1.5 text-white">
                <option value="40G" selected>40 Gbps</option>
                <option value="4x10G">4x10 Gbps (Breakout)</option>
              </select>
            </div>
          </div>

          <!-- QSFP28 -->
          <div class="grid grid-cols-12 gap-2 items-center">
            <span class="col-span-4 font-semibold text-amber-300">QSFP28</span>
            <div class="col-span-4">
              <input type="number" name="qsfp28_count" value="0" min="0" max="16" placeholder="Jumlah" class="w-full bg-slate-800 border border-slate-600 rounded px-2.5 py-1.5 text-white">
            </div>
            <div class="col-span-4">
              <select name="qsfp28_capacity" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1.5 text-white">
                <option value="40G">40 Gbps</option>
                <option value="100G" selected>100 Gbps</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <!-- Upload & Preview Foto Fisik Perangkat -->
        <div class="space-y-2">
          <span class="block text-slate-300">Foto Fisik Perangkat <span id="add_physical_status" class="text-sky-400"></span></span>

          <div id="add_physical_preview_box" class="hidden relative rounded-lg overflow-hidden border border-slate-600 aspect-video bg-slate-900 group">
            <img id="add_physical_preview_img" src="" alt="Preview Foto Fisik" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-slate-950/60 opacity-0 group-hover:opacity-100 flex items-center justify-center gap-2 transition">
              <button type="button" onclick="openAddPhotoPopup('physical')"
                class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-md bg-slate-900/95 hover:bg-emerald-500 text-emerald-400 hover:text-slate-950 border border-emerald-500/40 font-semibold transition cursor-pointer">
                <i data-lucide="maximize-2" class="w-3.5 h-3.5"></i>
                <span>Perbesar</span>
              </button>
              <button type="button" onclick="clearAddPhoto('physical')"
                class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-md bg-slate-900/95 hover:bg-rose-500 text-rose-400 hover:text-white border border-rose-500/40 font-semibold transition cursor-pointer">
                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                <span>Hapus</span>
              </button>
            </div>
          </div>

          <label class="flex items-center gap-2.5 bg-slate-900/80 border border-slate-600 hover:border-emerald-400 rounded-lg p-1.5 cursor-pointer transition group">
            <span class="inline-flex items-center gap-1.5 bg-slate-700 group-hover:bg-emerald-500 group-hover:text-slate-950 text-slate-200 font-semibold px-3 py-1.5 rounded-md transition shrink-0">
              <i data-lucide="upload" class="w-3.5 h-3.5"></i>
              <span>Pilih Foto</span>
            </span>
            <span id="add_physical_filename" class="text-slate-400 truncate">Belum ada file dipilih</span>
            <input type="file" id="add_physical_input" name="physical_photo" accept="image/*" class="hidden"
              onchange="handleAddFileSelect(this, 'physical')">
          </label>
        </div>

        <!-- Upload & Preview Foto Stiker SN -->
        <div class="space-y-2">
          <span class="block text-slate-300">Foto Stiker SN <span id="add_sn_status" class="text-sky-400"></span></span>

          <div id="add_sn_preview_box" class="hidden relative rounded-lg overflow-hidden border border-slate-600 aspect-video bg-slate-900 group">
            <img id="add_sn_preview_img" src="" alt="Preview Foto SN" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-slate-950/60 opacity-0 group-hover:opacity-100 flex items-center justify-center gap-2 transition">
              <button type="button" onclick="openAddPhotoPopup('sn')"
                class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-md bg-slate-900/95 hover:bg-emerald-500 text-emerald-400 hover:text-slate-950 border border-emerald-500/40 font-semibold transition cursor-pointer">
                <i data-lucide="maximize-2" class="w-3.5 h-3.5"></i>
                <span>Perbesar</span>
              </button>
              <button type="button" onclick="clearAddPhoto('sn')"
                class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-md bg-slate-900/95 hover:bg-rose-500 text-rose-400 hover:text-white border border-rose-500/40 font-semibold transition cursor-pointer">
                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                <span>Hapus</span>
              </button>
            </div>
          </div>

          <label class="flex items-center gap-2.5 bg-slate-900/80 border border-slate-600 hover:border-emerald-400 rounded-lg p-1.5 cursor-pointer transition group">
            <span class="inline-flex items-center gap-1.5 bg-slate-700 group-hover:bg-emerald-500 group-hover:text-slate-950 text-slate-200 font-semibold px-3 py-1.5 rounded-md transition shrink-0">
              <i data-lucide="upload" class="w-3.5 h-3.5"></i>
              <span>Pilih Foto</span>
            </span>
            <span id="add_sn_filename" class="text-slate-400 truncate">Belum ada file dipilih</span>
            <input type="file" id="add_sn_input" name="sn_photo" accept="image/*" class="hidden"
              onchange="handleAddFileSelect(this, 'sn')">
          </label>
        </div>
      </div>

      <div class="pt-3 border-t border-slate-700 flex justify-end gap-3">
        <button type="button" onclick="closeModal('modal-add-device')" class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 font-medium transition cursor-pointer">
          Batal
        </button>
        <button type="submit" class="px-5 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-semibold transition cursor-pointer">
          Simpan & Generate Port
        </button>
      </div>
    </form>
  </div>
</div>

<!-- =========================================================
     MODAL 2: EDIT MASTER PERANGKAT
     ========================================================= -->
<div id="modal-edit-device" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
  <div onclick="closeModal('modal-edit-device')" class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm"></div>

  <div class="relative bg-slate-800 border border-slate-700 rounded-2xl w-full max-w-2xl max-h-[90vh] flex flex-col shadow-2xl z-10">
    <div class="px-6 py-4 border-b border-slate-700 flex items-center justify-between">
      <h3 class="text-base font-semibold text-sky-400">Edit Master Perangkat</h3>
      <button type="button" onclick="closeModal('modal-edit-device')" class="text-slate-400 hover:text-white p-1 cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form id="edit-device-form" method="POST" enctype="multipart/form-data" class="p-6 overflow-y-auto space-y-4 text-sm">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-slate-300 mb-1">Cabang *</label>
          <select name="branch_id" id="edit_branch_id" required class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-sky-400">
            <% branches.forEach(b => { %>
              <option value="<%= b.id %>">[<%= b.branch_code %>] <%= b.branch_name %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-slate-300 mb-1">Jenis Perangkat *</label>
          <select name="device_type_id" id="edit_device_type_id" onchange="onDeviceTypeChange('edit')" required class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-sky-400">
            <% deviceTypes.forEach(dt => { %>
              <option value="<%= dt.id %>" data-is-switch="<%= dt.is_switch %>"><%= dt.type_name %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div id="edit_switch_options" class="hidden bg-slate-900/80 border border-sky-500/30 rounded-lg p-3.5 grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-sky-300 text-xs mb-1">Tipe Switch</label>
          <select name="switch_management" id="edit_switch_management" onchange="toggleIpField('edit')" class="w-full bg-slate-800 border border-slate-600 rounded-lg px-3 py-1.5 text-white">
            <option value="Managed">Managed</option>
            <option value="Unmanaged">Unmanaged</option>
          </select>
        </div>
        <div>
          <label class="block text-sky-300 text-xs mb-1">Dukungan Daya</label>
          <select name="is_poe" id="edit_is_poe" class="w-full bg-slate-800 border border-slate-600 rounded-lg px-3 py-1.5 text-white">
            <option value="0">Non-PoE</option>
            <option value="1">PoE (Power over Ethernet)</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-slate-300 mb-1">Nama / Hostname *</label>
          <input type="text" name="hostname" id="edit_hostname" required class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-sky-400">
        </div>
        <div>
          <label class="block text-slate-300 mb-1">Lokasi</label>
          <input type="text" name="room_location" id="edit_room_location" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-sky-400">
        </div>
      </div>

      <!-- Cascading Dropdown Brand & Type/Model -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="text-slate-300">Brand / Merk</label>
            <% if (can('menu.brands')) { %>
              <a href="/brands" class="text-[11px] text-sky-400 hover:underline font-medium">+ Kelola Brand</a>
            <% } %>
          </div>
          <select name="brand_id" id="edit_brand_id" onchange="populateModelDropdown('edit')" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-sky-400">
            <option value="">-- Pilih Brand --</option>
            <% brands.forEach(b => { %>
              <option value="<%= b.id %>"><%= b.brand_name %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="text-slate-300">Type / Model</label>
            <% if (can('menu.device-models')) { %>
              <a href="/device-models" class="text-[11px] text-emerald-400 hover:underline font-medium">+ Tambah Model</a>
            <% } %>
          </div>
          <select name="model_id" id="edit_model_id" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-sky-400">
            <option value="">-- Pilih Brand Terlebih Dahulu --</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label class="block text-slate-300 text-xs mb-1">IP Address</label>
          <input type="text" name="ip_address" id="edit_ip_address" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white text-xs">
        </div>
        <div>
          <label class="block text-slate-300 text-xs mb-1">MAC Address</label>
          <input type="text" name="mac_address" id="edit_mac_address" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white text-xs">
        </div>
        <div>
          <label class="block text-slate-300 text-xs mb-1">Serial Number</label>
          <input type="text" name="serial_number" id="edit_serial_number" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white text-xs">
        </div>
      </div>

      <!-- Konfigurasi Semua Tipe Port, Template Faceplate & Kapasitas -->
      <div class="bg-slate-900/60 border border-slate-700 rounded-lg p-3.5 space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2 border-b border-slate-800">
          <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Konfigurasi Port & Visual Faceplate</span>
          <div class="flex flex-wrap items-center gap-2">
            <select name="faceplate_template" id="edit_faceplate_template" onchange="onFaceplateTemplateChange('edit')"
              title="Template Visual Sasis Perangkat"
              class="bg-slate-800 border border-sky-500/40 rounded px-2.5 py-1 text-xs text-sky-300 font-medium focus:outline-none focus:border-sky-400">
              <option value="rackmount">Rackmount</option>
              <option value="non_rackmount">Non-Rackmount</option>
              <option value="modem_ont">Modem / ONT</option>
              <option value="access_point">Access Point</option>
              <option value="home_router">Home Router</option>
              <option value="voip">VoIP / IP Phone</option>
              <option value="dvr_nvr">DVR / NVR</option>
              <option value="cctv">CCTV / IP Camera</option>
            </select>

            <select name="port_layout" id="edit_port_layout" class="bg-slate-800 border border-slate-600 rounded px-2.5 py-1 text-xs text-slate-200">
              <option value="2_row">2 Baris</option>
              <option value="1_row">1 Baris</option>
            </select>
          </div>
        </div>

        <div class="space-y-2.5 text-xs">
          <!-- RJ45 -->
          <div class="grid grid-cols-12 gap-2 items-center">
            <span class="col-span-4 font-semibold text-slate-200">RJ45 (LAN)</span>
            <div class="col-span-4">
              <input type="number" name="rj45_count" id="edit_rj45_count" min="0" max="64" class="w-full bg-slate-800 border border-slate-600 rounded px-2.5 py-1.5 text-white">
            </div>
            <div class="col-span-4">
              <select name="rj45_capacity" id="edit_rj45_capacity" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1.5 text-white">
                <option value="100M">100 Mbps</option>
                <option value="1G">1 Gbps</option>
                <option value="2.5G">2.5 Gbps</option>
                <option value="10G">10 Gbps</option>
              </select>
            </div>
          </div>

          <!-- SFP -->
          <div class="grid grid-cols-12 gap-2 items-center">
            <span class="col-span-4 font-semibold text-sky-300">SFP</span>
            <div class="col-span-4">
              <input type="number" name="sfp_count" id="edit_sfp_count" min="0" max="32" class="w-full bg-slate-800 border border-slate-600 rounded px-2.5 py-1.5 text-white">
            </div>
            <div class="col-span-4">
              <select name="sfp_capacity" id="edit_sfp_capacity" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1.5 text-white">
                <option value="100M">100 Mbps</option>
                <option value="1G">1 Gbps</option>
                <option value="2.5G">2.5 Gbps</option>
              </select>
            </div>
          </div>

          <!-- SFP+ -->
          <div class="grid grid-cols-12 gap-2 items-center">
            <span class="col-span-4 font-semibold text-indigo-300">SFP+</span>
            <div class="col-span-4">
              <input type="number" name="sfp_plus_count" id="edit_sfp_plus_count" min="0" max="32" class="w-full bg-slate-800 border border-slate-600 rounded px-2.5 py-1.5 text-white">
            </div>
            <div class="col-span-4">
              <select name="sfp_plus_capacity" id="edit_sfp_plus_capacity" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1.5 text-white">
                <option value="1G">1 Gbps</option>
                <option value="10G">10 Gbps</option>
                <option value="25G">25 Gbps (SFP28)</option>
              </select>
            </div>
          </div>

          <!-- QSFP+ -->
          <div class="grid grid-cols-12 gap-2 items-center">
            <span class="col-span-4 font-semibold text-purple-300">QSFP+</span>
            <div class="col-span-4">
              <input type="number" name="qsfp_plus_count" id="edit_qsfp_plus_count" min="0" max="16" class="w-full bg-slate-800 border border-slate-600 rounded px-2.5 py-1.5 text-white">
            </div>
            <div class="col-span-4">
              <select name="qsfp_plus_capacity" id="edit_qsfp_plus_capacity" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1.5 text-white">
                <option value="40G">40 Gbps</option>
                <option value="4x10G">4x10 Gbps (Breakout)</option>
              </select>
            </div>
          </div>

          <!-- QSFP28 -->
          <div class="grid grid-cols-12 gap-2 items-center">
            <span class="col-span-4 font-semibold text-amber-300">QSFP28</span>
            <div class="col-span-4">
              <input type="number" name="qsfp28_count" id="edit_qsfp28_count" min="0" max="16" class="w-full bg-slate-800 border border-slate-600 rounded px-2.5 py-1.5 text-white">
            </div>
            <div class="col-span-4">
              <select name="qsfp28_capacity" id="edit_qsfp28_capacity" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1.5 text-white">
                <option value="40G">40 Gbps</option>
                <option value="100G">100 Gbps</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <!-- Foto Fisik -->
        <div class="space-y-2">
          <span class="block text-slate-300">Foto Fisik <span id="edit_physical_status" class="text-emerald-400"></span></span>

          <div id="edit_physical_preview_box" class="hidden relative rounded-lg overflow-hidden border border-slate-600 aspect-video bg-slate-900 group">
            <img id="edit_physical_preview_img" src="" alt="Foto Fisik" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-slate-950/60 opacity-0 group-hover:opacity-100 flex items-center justify-center gap-2 transition">
              <button type="button" onclick="openEditPhotoPopup('physical')"
                class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-md bg-slate-900/95 hover:bg-emerald-500 text-emerald-400 hover:text-slate-950 border border-emerald-500/40 font-semibold transition cursor-pointer">
                <i data-lucide="maximize-2" class="w-3.5 h-3.5"></i>
                <span>Perbesar</span>
              </button>
              <button type="button" onclick="markPhotoDeleted('physical')"
                class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-md bg-slate-900/95 hover:bg-rose-500 text-rose-400 hover:text-white border border-rose-500/40 font-semibold transition cursor-pointer">
                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                <span>Hapus</span>
              </button>
            </div>
          </div>

          <input type="hidden" name="delete_physical_photo" id="delete_physical_photo_input" value="0">

          <label class="flex items-center gap-2.5 bg-slate-900/80 border border-slate-600 hover:border-emerald-400 rounded-lg p-1.5 cursor-pointer transition group">
            <span class="inline-flex items-center gap-1.5 bg-slate-700 group-hover:bg-emerald-500 group-hover:text-slate-950 text-slate-200 font-semibold px-3 py-1.5 rounded-md transition shrink-0">
              <i data-lucide="upload" class="w-3.5 h-3.5"></i>
              <span>Pilih Foto</span>
            </span>
            <span id="edit_physical_filename" class="text-slate-400 truncate">Belum ada file dipilih</span>
            <input type="file" name="physical_photo" accept="image/*" class="hidden"
              onchange="handleEditFileSelect(this, 'physical')">
          </label>
        </div>

        <!-- Foto Stiker SN -->
        <div class="space-y-2">
          <span class="block text-slate-300">Foto Stiker SN <span id="edit_sn_status" class="text-emerald-400"></span></span>

          <div id="edit_sn_preview_box" class="hidden relative rounded-lg overflow-hidden border border-slate-600 aspect-video bg-slate-900 group">
            <img id="edit_sn_preview_img" src="" alt="Foto SN" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-slate-950/60 opacity-0 group-hover:opacity-100 flex items-center justify-center gap-2 transition">
              <button type="button" onclick="openEditPhotoPopup('sn')"
                class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-md bg-slate-900/95 hover:bg-emerald-500 text-emerald-400 hover:text-slate-950 border border-emerald-500/40 font-semibold transition cursor-pointer">
                <i data-lucide="maximize-2" class="w-3.5 h-3.5"></i>
                <span>Perbesar</span>
              </button>
              <button type="button" onclick="markPhotoDeleted('sn')"
                class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-md bg-slate-900/95 hover:bg-rose-500 text-rose-400 hover:text-white border border-rose-500/40 font-semibold transition cursor-pointer">
                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                <span>Hapus</span>
              </button>
            </div>
          </div>

          <input type="hidden" name="delete_sn_photo" id="delete_sn_photo_input" value="0">

          <label class="flex items-center gap-2.5 bg-slate-900/80 border border-slate-600 hover:border-emerald-400 rounded-lg p-1.5 cursor-pointer transition group">
            <span class="inline-flex items-center gap-1.5 bg-slate-700 group-hover:bg-emerald-500 group-hover:text-slate-950 text-slate-200 font-semibold px-3 py-1.5 rounded-md transition shrink-0">
              <i data-lucide="upload" class="w-3.5 h-3.5"></i>
              <span>Pilih Foto</span>
            </span>
            <span id="edit_sn_filename" class="text-slate-400 truncate">Belum ada file dipilih</span>
            <input type="file" name="sn_photo" accept="image/*" class="hidden"
              onchange="handleEditFileSelect(this, 'sn')">
          </label>
        </div>
      </div>

      <div class="pt-3 border-t border-slate-700 flex justify-end gap-3">
        <button type="button" onclick="closeModal('modal-edit-device')" class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 font-medium transition cursor-pointer">
          Batal
        </button>
        <button type="submit" class="px-5 py-2 rounded-lg bg-sky-500 hover:bg-sky-600 text-slate-950 font-semibold transition cursor-pointer">
          Update Perangkat
        </button>
      </div>
    </form>
  </div>
</div>

<!-- =========================================================
     MODAL 3: KONFIRMASI HAPUS PERANGKAT
     ========================================================= -->
<div id="modal-delete-device" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
  <div onclick="closeModal('modal-delete-device')" class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm"></div>

  <div class="relative bg-slate-800 border border-slate-700 rounded-2xl w-full max-w-md p-6 shadow-2xl z-10 space-y-4">
    <div class="flex items-center gap-3 text-rose-400">
      <div class="p-2.5 rounded-full bg-rose-500/15 border border-rose-500/30">
        <i data-lucide="alert-triangle" class="w-6 h-6"></i>
      </div>
      <h3 class="text-lg font-semibold text-white">Hapus Perangkat?</h3>
    </div>

    <p class="text-sm text-slate-300 leading-relaxed">
      Apakah Anda yakin ingin menghapus perangkat <span id="delete-device-name" class="font-bold text-rose-400"></span>? Seluruh data port dan koneksi kabel yang terhubung ke perangkat ini juga akan ikut terhapus.
    </p>

    <form id="delete-device-form" method="POST" class="pt-2 flex justify-end gap-3 text-sm">
      <button type="button" onclick="closeModal('modal-delete-device')" class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 font-medium transition cursor-pointer">
        Batal
      </button>
      <button type="submit" class="px-4 py-2 rounded-lg bg-rose-500 hover:bg-rose-600 text-white font-semibold transition cursor-pointer">
        Ya, Hapus Permanen
      </button>
    </form>
  </div>
</div>

<!-- =========================================================
     MODAL 4: POPUP PREVIEW, DOWNLOAD & HAPUS FOTO
     ========================================================= -->
<div id="modal-edit-photo-popup" class="fixed inset-0 z-[60] hidden flex items-center justify-center p-4">
  <div onclick="closeModal('modal-edit-photo-popup')" class="fixed inset-0 bg-slate-950/85 backdrop-blur-sm"></div>

  <div class="relative bg-slate-800 border border-slate-700 rounded-2xl w-full max-w-3xl max-h-[90vh] flex flex-col shadow-2xl z-10 overflow-hidden">
    <div class="px-5 py-3.5 border-b border-slate-700 flex items-center justify-between">
      <h3 id="popup-photo-title" class="text-sm font-semibold text-white truncate">Preview Foto</h3>
      <button type="button" onclick="closeModal('modal-edit-photo-popup')" class="text-slate-400 hover:text-white p-1 cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <div class="p-4 bg-slate-950 flex-1 overflow-auto flex items-center justify-center">
      <img id="popup-photo-img" src="" alt="Preview Foto" class="max-h-[65vh] w-auto object-contain rounded-lg border border-slate-800">
    </div>

    <!-- Konfirmasi Hapus Langsung -->
    <div id="popup-photo-confirm-bar" class="hidden px-5 py-3 bg-rose-950/60 border-t border-rose-500/30 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
      <span class="text-rose-200 font-medium">Hapus foto ini secara permanen dari server sekarang?</span>
      <form id="popup-photo-delete-form" method="POST" class="flex items-center gap-2 shrink-0">
        <input type="hidden" name="photo_type" id="popup-photo-type-input">
        <input type="hidden" name="redirect_to" value="/devices">
        <button type="button" onclick="togglePopupDeleteConfirm(false)" class="px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 cursor-pointer">
          Batal
        </button>
        <button type="submit" class="px-3.5 py-1.5 rounded-lg bg-rose-500 hover:bg-rose-600 text-white font-semibold cursor-pointer">
          Ya, Hapus Permanen
        </button>
      </form>
    </div>

    <div id="popup-photo-footer" class="px-5 py-3.5 border-t border-slate-700 flex items-center justify-between gap-3 bg-slate-800">
      <% if (can('device.write')) { %>
        <button type="button" onclick="togglePopupDeleteConfirm(true)"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-rose-500/15 hover:bg-rose-500/25 text-rose-400 border border-rose-500/30 text-xs font-semibold transition cursor-pointer">
          <i data-lucide="trash-2" class="w-4 h-4"></i>
          <span>Hapus</span>
        </button>
      <% } %>

      <div class="flex items-center gap-2">
        <a id="popup-photo-download" href="#" download
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-slate-950 text-xs font-semibold transition">
          <i data-lucide="download" class="w-4 h-4"></i>
          <span>Download</span>
        </a>
        <button type="button" onclick="closeModal('modal-edit-photo-popup')"
          class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-medium cursor-pointer">
          Tutup
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const allDeviceModels = <%- JSON.stringify(typeof deviceModels !== 'undefined' ? deviceModels : []) %>;
  let currentEditingDevice = null;

  // =========================================================
  // AUTO-ADJUST PORT LAYOUT SAAT TEMPLATE FACEPLATE DIPILIH
  // =========================================================
  function onFaceplateTemplateChange(prefix) {
    const tplSelect = document.getElementById(`${prefix}_faceplate_template`);
    const layoutSelect = document.getElementById(`${prefix}_port_layout`);
    if (!tplSelect || !layoutSelect) return;

    const tpl = tplSelect.value;
    if (['modem_ont', 'access_point', 'home_router', 'voip', 'dvr_nvr', 'cctv'].includes(tpl)) {
      layoutSelect.value = '1_row';
    } else if (tpl === 'rackmount') {
      layoutSelect.value = '2_row';
    }
  }

  // =========================================================
  // CASCADING DROPDOWN BRAND -> MODEL
  // =========================================================
  function populateModelDropdown(prefix, selectedModelId = '') {
    const brandSelect = document.getElementById(`${prefix}_brand_id`);
    const typeSelect = document.getElementById(`${prefix}_device_type_id`);
    const modelSelect = document.getElementById(`${prefix}_model_id`);

    if (!brandSelect || !modelSelect) return;

    const brandId = brandSelect.value;
    const typeId = typeSelect ? typeSelect.value : '';

    modelSelect.innerHTML = '';

    if (!brandId) {
      modelSelect.innerHTML = '<option value="">-- Pilih Brand Terlebih Dahulu --</option>';
      return;
    }

    const filtered = allDeviceModels.filter(m =>
      String(m.brand_id) === String(brandId) &&
      (!m.device_type_id || String(m.device_type_id) === String(typeId) || String(m.id) === String(selectedModelId))
    );

    if (filtered.length === 0) {
      modelSelect.innerHTML = '<option value="">-- Tidak ada model untuk jenis perangkat ini --</option>';
      return;
    }

    const defaultOpt = document.createElement('option');
    defaultOpt.value = '';
    defaultOpt.textContent = '-- Pilih Type / Model --';
    modelSelect.appendChild(defaultOpt);

    filtered.forEach(m => {
      const opt = document.createElement('option');
      opt.value = m.id;
      opt.textContent = m.model_name;
      if (selectedModelId && String(m.id) === String(selectedModelId)) {
        opt.selected = true;
      }
      modelSelect.appendChild(opt);
    });
  }

  function onDeviceTypeChange(prefix) {
    toggleSwitchOptions(prefix);
    const currentModelVal = document.getElementById(`${prefix}_model_id`).value;
    populateModelDropdown(prefix, currentModelVal);
  }

  // =========================================================
  // LOGIKA SEARCH & PAGINATION TABEL PERANGKAT
  // =========================================================
  const STORAGE_KEY = 'netmgmt_devices_table_state';

  function loadTableState() {
    try {
      const saved = JSON.parse(sessionStorage.getItem(STORAGE_KEY));
      if (saved && typeof saved === 'object') {
        return {
          currentPage: parseInt(saved.currentPage, 10) || 1,
          perPage: saved.perPage || '8',
          searchQuery: saved.searchQuery || ''
        };
      }
    } catch (e) {}
    return { currentPage: 1, perPage: '8', searchQuery: '' };
  }

  function saveTableState() {
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify({
        currentPage,
        perPage,
        searchQuery
      }));
    } catch (e) {}
  }

  const initialState = loadTableState();
  let currentPage = initialState.currentPage;
  let perPage = initialState.perPage;
  let searchQuery = initialState.searchQuery;

  function renderDeviceTable() {
    const allRows = Array.from(document.querySelectorAll('#devices-table-body .device-row'));
    if (allRows.length === 0) return;

    const query = searchQuery.trim().toLowerCase();
    const matchedRows = allRows.filter(row => {
      if (!query) return true;
      return row.textContent.toLowerCase().includes(query);
    });

    const totalMatched = matchedRows.length;
    const effectivePerPage = perPage === 'all' ? Math.max(totalMatched, 1) : parseInt(perPage, 10);
    const totalPages = Math.max(Math.ceil(totalMatched / effectivePerPage), 1);

    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    // Simpan state terakhir setiap kali tabel dirender
    saveTableState();

    const startIndex = (currentPage - 1) * effectivePerPage;
    const endIndex = startIndex + effectivePerPage;

    allRows.forEach(row => row.classList.add('hidden'));
    matchedRows.slice(startIndex, endIndex).forEach(row => row.classList.remove('hidden'));

    const noResultsBox = document.getElementById('no-search-results');
    const paginationFooter = document.getElementById('pagination-footer');
    const tableWrapper = document.querySelector('#devices-table-body').closest('.overflow-x-auto');

    if (totalMatched === 0) {
      noResultsBox.classList.remove('hidden');
      paginationFooter.classList.add('hidden');
      tableWrapper.classList.add('hidden');
      document.getElementById('search-query-label').textContent = `"${searchQuery}"`;
      return;
    } else {
      noResultsBox.classList.add('hidden');
      paginationFooter.classList.remove('hidden');
      tableWrapper.classList.remove('hidden');
    }

    const showingStart = startIndex + 1;
    const showingEnd = Math.min(endIndex, totalMatched);
    const filterNote = query ? ` (difilter dari total ${allRows.length} perangkat)` : '';
    document.getElementById('pagination-info').innerHTML =
      `Menampilkan <span class="text-slate-900 dark:text-white font-semibold">${showingStart}&ndash;${showingEnd}</span> dari <span class="text-slate-900 dark:text-white font-semibold">${totalMatched}</span> perangkat${filterNote}`;

    const controlsEl = document.getElementById('pagination-controls');
    controlsEl.innerHTML = '';

    if (totalPages <= 1) return;

    const createPageBtn = (label, targetPage, isActive = false, isDisabled = false) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.innerHTML = label;
      btn.disabled = isDisabled;

      if (isActive) {
        btn.className = 'px-2.5 py-1 rounded-md bg-emerald-500 text-white dark:text-slate-950 font-bold shadow-2xs cursor-default';
      } else if (isDisabled) {
        btn.className = 'px-2.5 py-1 rounded-md bg-slate-100 text-slate-400 border border-slate-200 dark:bg-slate-800/50 dark:text-slate-600 dark:border-slate-700/50 cursor-not-allowed';
      } else {
        btn.className = 'px-2.5 py-1 rounded-md bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300 dark:border-slate-600 transition cursor-pointer shadow-2xs';
        btn.onclick = () => {
          currentPage = targetPage;
          renderDeviceTable();
        };
      }
      return btn;
    };

    controlsEl.appendChild(createPageBtn('&laquo; Prev', currentPage - 1, false, currentPage === 1));

    const pagesToShow = [];
    for (let p = 1; p <= totalPages; p++) {
      if (p === 1 || p === totalPages || (p >= currentPage - 1 && p <= currentPage + 1)) {
        pagesToShow.push(p);
      } else if (pagesToShow[pagesToShow.length - 1] !== '...') {
        pagesToShow.push('...');
      }
    }

    pagesToShow.forEach(item => {
      if (item === '...') {
        const dots = document.createElement('span');
        dots.textContent = '...';
        dots.className = 'px-2 py-1 text-slate-500';
        controlsEl.appendChild(dots);
      } else {
        controlsEl.appendChild(createPageBtn(item, item, item === currentPage, false));
      }
    });

    controlsEl.appendChild(createPageBtn('Next &raquo;', currentPage + 1, false, currentPage === totalPages));
  }

  function handleSearchChange() {
    const input = document.getElementById('device-search-input');
    const clearBtn = document.getElementById('clear-search-btn');
    searchQuery = input.value;
    currentPage = 1;

    if (searchQuery.length > 0) {
      clearBtn.classList.remove('hidden');
    } else {
      clearBtn.classList.add('hidden');
    }
    renderDeviceTable();
  }

  function clearDeviceSearch() {
    const input = document.getElementById('device-search-input');
    input.value = '';
    searchQuery = '';
    currentPage = 1;
    document.getElementById('clear-search-btn').classList.add('hidden');
    renderDeviceTable();
    input.focus();
  }

  function handlePerPageChange() {
    perPage = document.getElementById('devices-per-page').value;
    currentPage = 1;
    renderDeviceTable();
  }

  // =========================================================
  // LOGIKA MODAL TAMBAH, EDIT & PREVIEW FOTO
  // =========================================================
  function handleAddFileSelect(input, type) {
    const file = input.files[0];
    document.getElementById(`add_${type}_filename`).textContent = file ? file.name : 'Belum ada file dipilih';
    const box = document.getElementById(`add_${type}_preview_box`);
    const img = document.getElementById(`add_${type}_preview_img`);
    const status = document.getElementById(`add_${type}_status`);

    if (file) {
      img.src = URL.createObjectURL(file);
      box.classList.remove('hidden');
      status.textContent = '(Siap diupload)';
    } else {
      img.src = '';
      box.classList.add('hidden');
      status.textContent = '';
    }
  }

  function clearAddPhoto(type) {
    const input = document.getElementById(`add_${type}_input`);
    input.value = '';
    document.getElementById(`add_${type}_filename`).textContent = 'Belum ada file dipilih';
    document.getElementById(`add_${type}_preview_img`).src = '';
    document.getElementById(`add_${type}_preview_box`).classList.add('hidden');
    document.getElementById(`add_${type}_status`).textContent = '';
  }

  function openAddPhotoPopup(type) {
    const imgSrc = document.getElementById(`add_${type}_preview_img`).src;
    const labelTitle = type === 'physical'
      ? 'Preview Foto Fisik Perangkat'
      : 'Preview Foto Stiker SN';

    document.getElementById('popup-photo-title').textContent = labelTitle;
    document.getElementById('popup-photo-img').src = imgSrc;
    document.getElementById('popup-photo-download').href = imgSrc;

    togglePopupDeleteConfirm(false);
    const delBtn = document.querySelector('#popup-photo-footer button');
    if (delBtn) delBtn.classList.add('hidden');
    openModal('modal-edit-photo-popup');
  }

  function toggleSwitchOptions(prefix) {
    const select = document.getElementById(`${prefix}_device_type_id`);
    if (!select || select.options.length === 0) return;

    const selectedOption = select.options[select.selectedIndex];
    const isSwitch = selectedOption.getAttribute('data-is-switch') === '1';
    const switchOpts = document.getElementById(`${prefix}_switch_options`);

    if (isSwitch) {
      switchOpts.classList.remove('hidden');
    } else {
      switchOpts.classList.add('hidden');
      document.getElementById(`${prefix}_ip_address`).disabled = false;
    }
    toggleIpField(prefix);
  }

  function toggleIpField(prefix) {
    const select = document.getElementById(`${prefix}_device_type_id`);
    if (!select || select.options.length === 0) return;

    const selectedOption = select.options[select.selectedIndex];
    const isSwitch = selectedOption.getAttribute('data-is-switch') === '1';
    const mgmt = document.getElementById(`${prefix}_switch_management`).value;
    const ipInput = document.getElementById(`${prefix}_ip_address`);

    if (isSwitch && mgmt === 'Unmanaged') {
      ipInput.value = '';
      ipInput.disabled = true;
      ipInput.placeholder = 'Unmanaged (No IP)';
    } else {
      ipInput.disabled = false;
      ipInput.placeholder = '10.10.1.2';
    }
  }

  function openEditDeviceModal(btn) {
    const dev = JSON.parse(btn.getAttribute('data-device'));
    currentEditingDevice = dev;

    document.getElementById('edit-device-form').action = `/devices/${dev.id}/update`;
    document.getElementById('edit_branch_id').value = dev.branch_id;
    document.getElementById('edit_device_type_id').value = dev.device_type_id;
    document.getElementById('edit_switch_management').value = dev.switch_management || 'Managed';
    document.getElementById('edit_is_poe').value = dev.is_poe ? '1' : '0';

    document.getElementById('edit_hostname').value = dev.hostname || '';
    document.getElementById('edit_room_location').value = dev.room_location || '';

    document.getElementById('edit_brand_id').value = dev.brand_id || '';
    populateModelDropdown('edit', dev.model_id || '');

    document.getElementById('edit_ip_address').value = dev.ip_address || '';
    document.getElementById('edit_mac_address').value = dev.mac_address || '';
    document.getElementById('edit_serial_number').value = dev.serial_number || '';

    document.getElementById('edit_faceplate_template').value = dev.faceplate_template || 'rackmount';
    document.getElementById('edit_port_layout').value = dev.port_layout || '2_row';

    document.getElementById('edit_rj45_count').value = dev.rj45_count || 0;
    document.getElementById('edit_rj45_capacity').value = dev.rj45_capacity || '1G';

    document.getElementById('edit_sfp_count').value = dev.sfp_count || 0;
    document.getElementById('edit_sfp_capacity').value = dev.sfp_capacity || '1G';

    document.getElementById('edit_sfp_plus_count').value = dev.sfp_plus_count || 0;
    document.getElementById('edit_sfp_plus_capacity').value = dev.sfp_plus_capacity || '10G';

    document.getElementById('edit_qsfp_plus_count').value = dev.qsfp_plus_count || 0;
    document.getElementById('edit_qsfp_plus_capacity').value = dev.qsfp_plus_capacity || '40G';

    document.getElementById('edit_qsfp28_count').value = dev.qsfp28_count || 0;
    document.getElementById('edit_qsfp28_capacity').value = dev.qsfp28_capacity || '100G';

    document.getElementById('delete_physical_photo_input').value = '0';
    document.getElementById('edit_physical_filename').textContent = 'Belum ada file dipilih';
    const physBox = document.getElementById('edit_physical_preview_box');
    const physImg = document.getElementById('edit_physical_preview_img');
    if (dev.physical_photo) {
      document.getElementById('edit_physical_status').textContent = '(Sudah ada foto)';
      document.getElementById('edit_physical_status').className = 'text-emerald-400';
      physImg.src = dev.physical_photo;
      physBox.classList.remove('hidden');
    } else {
      document.getElementById('edit_physical_status').textContent = '';
      physImg.src = '';
      physBox.classList.add('hidden');
    }

    document.getElementById('delete_sn_photo_input').value = '0';
    document.getElementById('edit_sn_filename').textContent = 'Belum ada file dipilih';
    const snBox = document.getElementById('edit_sn_preview_box');
    const snImg = document.getElementById('edit_sn_preview_img');
    if (dev.sn_photo) {
      document.getElementById('edit_sn_status').textContent = '(Sudah ada foto)';
      document.getElementById('edit_sn_status').className = 'text-emerald-400';
      snImg.src = dev.sn_photo;
      snBox.classList.remove('hidden');
    } else {
      document.getElementById('edit_sn_status').textContent = '';
      snImg.src = '';
      snBox.classList.add('hidden');
    }

    toggleSwitchOptions('edit');
    openModal('modal-edit-device');
  }

  function handleEditFileSelect(input, type) {
    const file = input.files[0];
    document.getElementById(`edit_${type}_filename`).textContent = file ? file.name : 'Belum ada file dipilih';
    if (file) {
      document.getElementById(`delete_${type}_photo_input`).value = '0';
      const previewUrl = URL.createObjectURL(file);
      document.getElementById(`edit_${type}_preview_img`).src = previewUrl;
      document.getElementById(`edit_${type}_preview_box`).classList.remove('hidden');
      document.getElementById(`edit_${type}_status`).textContent = '(Foto baru dipilih)';
      document.getElementById(`edit_${type}_status`).className = 'text-sky-400';
    }
  }

  function markPhotoDeleted(type) {
    document.getElementById(`delete_${type}_photo_input`).value = '1';
    document.getElementById(`edit_${type}_preview_box`).classList.add('hidden');
    document.getElementById(`edit_${type}_status`).textContent = '(Akan dihapus saat Update)';
    document.getElementById(`edit_${type}_status`).className = 'text-rose-400';
  }

  function openEditPhotoPopup(type) {
    if (!currentEditingDevice) return;
    const imgSrc = document.getElementById(`edit_${type}_preview_img`).src;
    const labelTitle = type === 'physical'
      ? `Foto Fisik - ${currentEditingDevice.hostname}`
      : `Foto Stiker SN - ${currentEditingDevice.hostname}`;

    document.getElementById('popup-photo-title').textContent = labelTitle;
    document.getElementById('popup-photo-img').src = imgSrc;
    document.getElementById('popup-photo-download').href = imgSrc;
    document.getElementById('popup-photo-delete-form').action = `/devices/${currentEditingDevice.id}/delete-photo`;
    document.getElementById('popup-photo-type-input').value = type;

    togglePopupDeleteConfirm(false);

    const deleteBtn = document.querySelector('#popup-photo-footer button');
    if (deleteBtn) {
      if (imgSrc.startsWith('blob:')) {
        deleteBtn.classList.add('hidden');
      } else {
        deleteBtn.classList.remove('hidden');
      }
    }

    openModal('modal-edit-photo-popup');
  }

  function togglePopupDeleteConfirm(showConfirm) {
    const confirmBar = document.getElementById('popup-photo-confirm-bar');
    const footerBar = document.getElementById('popup-photo-footer');
    if (showConfirm) {
      confirmBar.classList.remove('hidden');
      footerBar.classList.add('hidden');
    } else {
      confirmBar.classList.add('hidden');
      footerBar.classList.remove('hidden');
    }
  }

  function confirmDeleteDevice(deviceId, hostname) {
    document.getElementById('delete-device-name').textContent = hostname;
    document.getElementById('delete-device-form').action = `/devices/${deviceId}/delete`;
    openModal('modal-delete-device');
  }

  document.addEventListener('DOMContentLoaded', () => {
    toggleSwitchOptions('add');
    populateModelDropdown('add');

    // Pulihkan nilai input search & dropdown jumlah per halaman dari sessionStorage
    const searchInput = document.getElementById('device-search-input');
    const perPageSelect = document.getElementById('devices-per-page');
    const clearBtn = document.getElementById('clear-search-btn');

    if (searchInput && searchQuery) {
      searchInput.value = searchQuery;
      if (clearBtn) clearBtn.classList.remove('hidden');
    }
    if (perPageSelect && perPage) {
      perPageSelect.value = String(perPage);
    }

    renderDeviceTable();
  });
</script>

<%- include('partials/footer') %>
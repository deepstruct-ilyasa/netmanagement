<div class="w-fit mx-auto flex items-center justify-center py-2">
    <div class="flex items-center">
        <!-- Bodi Kamera IP -->
        <div class="bg-gradient-to-b from-slate-100 to-slate-300 border-2 border-slate-400 rounded-2xl px-5 py-4 flex items-center gap-4 shadow-lg z-10">
            <!-- Lensa Kamera -->
            <div class="w-14 h-14 rounded-full bg-slate-900 border-4 border-slate-400 flex items-center justify-center shadow-inner shrink-0">
                <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-indigo-950 via-slate-900 to-cyan-500/40 border border-slate-600 flex items-center justify-center">
                    <div class="w-3 h-3 rounded-full bg-sky-300/60"></div>
                </div>
            </div>
            <div>
                <div class="text-sm font-bold text-slate-900 mt-1"><%= device.hostname %></div>
                <div class="text-[11px] text-slate-600"><%= device.brand || '' %> <%= device.model || '' %></div>
            </div>
        </div>
        
        <!-- Kabel Pigtail Penghubung -->
        <div class="w-10 h-3 bg-slate-700 border-y border-slate-500"></div>
        
        <!-- Junction Box Konektor Pigtail (RJ45 PoE + DC 12V) -->
        <div class="bg-slate-900 border-2 border-slate-600 rounded-xl p-3.5 flex items-center gap-4 shadow-lg">
            <!-- Port RJ45 Interaktif CCTV -->
            <div class="flex items-center gap-2">
                <% portGroups.RJ45.forEach(port => {
                    const st = getPortStyle(port);
                    let targetLabel = `Kosong (Max ${port.port_capacity || '100M'})`;
                    if (port.peer_device_hostname) {
                        targetLabel = `[${port.link_speed || '100M'}] Ke: ${port.peer_device_hostname} (${port.peer_port_name})`;
                    } else if (port.end_device_info) {
                        targetLabel = `[${port.link_speed || '100M'}] Ke: ${port.end_device_info}`;
                    }
                    %>
                    <button type="button"
                    data-port="<%= JSON.stringify(port) %>"
                    onclick="openPortModal(this)"
                    title="<%= port.port_name %> - <%= targetLabel %>"
                    class="group relative w-14 h-14 rounded-lg border-2 <%= st.box %> flex flex-col items-center justify-between p-1 transition transform hover:scale-105 cursor-pointer">
                    <div class="w-full flex items-center justify-between px-0.5">
                        <span class="w-1.5 h-1.5 rounded-full <%= st.led %>"></span>
                        <span class="text-[7px] font-mono font-bold px-1 rounded bg-black/40 leading-tight">
                            <%= st.speedBadge || port.port_capacity || '100M' %>
                        </span>
                    </div>
                    <svg class="w-8 h-5 text-slate-400" viewBox="0 0 32 22" fill="none">
                        <path d="M3 6H10V3H22V6H29V19H3V6Z" fill="#090d16" stroke="currentColor" stroke-width="1.5"/>
                        <line x1="8" y1="15" x2="8" y2="18.5" stroke="#f59e0b" stroke-width="1.2"/>
                        <line x1="12" y1="15" x2="12" y2="18.5" stroke="#f59e0b" stroke-width="1.2"/>
                        <line x1="16" y1="15" x2="16" y2="18.5" stroke="#f59e0b" stroke-width="1.2"/>
                        <line x1="20" y1="15" x2="20" y2="18.5" stroke="#f59e0b" stroke-width="1.2"/>
                        <line x1="24" y1="15" x2="24" y2="18.5" stroke="#f59e0b" stroke-width="1.2"/>
                    </svg>
                    <span class="text-[9px] font-mono font-bold truncate max-w-full leading-none">
                        RJ45 PoE
                    </span>
                </button>
                <% }) %>
            </div>
            
            <!-- Konektor DC 12V Barrel -->
            <div class="flex flex-col items-center gap-1 pl-3 border-l border-slate-700">
                <div class="w-8 h-8 rounded-full bg-rose-600/20 border-2 border-rose-500 flex items-center justify-center">
                    <div class="w-3 h-3 rounded-full bg-slate-950 border border-rose-300"></div>
                </div>
                <span class="text-[8px] font-mono text-rose-300">DC 12V</span>
            </div>
        </div>
    </div>
</div>
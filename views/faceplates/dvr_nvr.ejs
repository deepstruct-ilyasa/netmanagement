<div class="w-fit mx-auto flex flex-col items-center">
    <div class="bg-gradient-to-b from-zinc-800 via-zinc-900 to-zinc-950 border-2 border-zinc-600 rounded-xl p-5 shadow-2xl flex items-center gap-6 relative">
        <!-- Panel Identitas DVR/NVR -->
        <div class="w-36 flex flex-col justify-between border-r border-zinc-700 pr-4 py-1 shrink-0">
            <div>
                <div class="text-xs font-bold text-zinc-200 truncate" title="<%= device.hostname %>">
                    <%= device.hostname %>
                </div>
                <div class="text-xs font-semibold text-emerald-400"><%= device.brand || '' %></div>
                <div class="text-xs text-zinc-400 truncate"><%= device.model || '' %></div>
            </div>
        </div>
        
        <!-- Port Video Output (HDMI & VGA) -->
        <div class="flex items-center gap-3 bg-zinc-950/90 border border-zinc-700 rounded-lg px-3.5 py-2.5">
            <!-- HDMI -->
            <div class="flex flex-col items-center gap-1">
                <div class="w-12 h-6 bg-zinc-900 border-2 border-amber-400/60 rounded-xs flex items-center justify-center">
                    <div class="w-9 h-2 bg-black border border-amber-300/50"></div>
                </div>
                <span class="text-[9px] font-mono text-zinc-400">HDMI</span>
            </div>
            <!-- VGA DB15 -->
            <div class="flex flex-col items-center gap-1">
                <div class="w-14 h-7 bg-blue-700 border-2 border-zinc-400 rounded-xs flex items-center justify-center px-1">
                    <div class="grid grid-cols-5 gap-0.5">
                        <span class="w-1 h-1 rounded-full bg-amber-300"></span>
                        <span class="w-1 h-1 rounded-full bg-amber-300"></span>
                        <span class="w-1 h-1 rounded-full bg-amber-300"></span>
                        <span class="w-1 h-1 rounded-full bg-amber-300"></span>
                        <span class="w-1 h-1 rounded-full bg-amber-300"></span>
                    </div>
                </div>
                <span class="text-[9px] font-mono text-zinc-400">VGA</span>
            </div>
            <!-- Dual USB -->
            <div class="flex flex-col items-center gap-1">
                <div class="w-7 h-9 bg-zinc-900 border border-zinc-500 rounded-xs flex flex-col justify-between p-1">
                    <div class="h-2.5 bg-sky-500/40 border border-sky-400/60"></div>
                    <div class="h-2.5 bg-sky-500/40 border border-sky-400/60"></div>
                </div>
                <span class="text-[9px] font-mono text-zinc-400">USB</span>
            </div>
        </div>
        
        <!-- DERETAN PORT JARINGAN INTERAKTIF DVR/NVR (LAN / PoE Camera Ports) -->
        <div class="space-y-1.5">
            <div class="<%= isTwoRow ? 'grid grid-rows-2 grid-flow-col gap-2' : 'flex items-center gap-2' %> bg-zinc-950 p-2.5 rounded-lg border border-zinc-700">
                <% portGroups.RJ45.forEach(port => {
                    const st = getPortStyle(port);
                    let targetLabel = `Kosong (Max ${port.port_capacity || '1G'})`;
                    if (port.peer_device_hostname) {
                        targetLabel = `[${port.link_speed || '1G'}] Ke: ${port.peer_device_hostname} (${port.peer_port_name})`;
                    } else if (port.end_device_info) {
                        targetLabel = `[${port.link_speed || '1G'}] Ke: ${port.end_device_info}`;
                    }
                    %>
                    <button type="button"
                    data-port="<%= JSON.stringify(port) %>"
                    onclick="openPortModal(this)"
                    title="<%= port.port_name %> - <%= targetLabel %>"
                    class="group relative w-13 h-14 rounded-md border-2 <%= st.box %> flex flex-col items-center justify-between p-1 transition transform hover:scale-105 cursor-pointer">
                    <div class="w-full flex items-center justify-between px-0.5">
                        <span class="w-1.5 h-1.5 rounded-full <%= st.led %>"></span>
                        <span class="text-[7px] font-mono font-bold px-1 rounded bg-black/40 leading-tight">
                            <%= st.speedBadge || port.port_capacity || '1G' %>
                        </span>
                    </div>
                    <svg class="w-8 h-5 text-slate-400" viewBox="0 0 32 22" fill="none">
                        <path d="M3 6H10V3H22V6H29V19H3V6Z" fill="#090d16" stroke="currentColor" stroke-width="1.5"/>
                        <line x1="8" y1="15" x2="8" y2="18.5" stroke="#f59e0b" stroke-width="1.2"/>
                        <line x1="12" y1="15" x2="12" y2="18.5" stroke="#f59e0b" stroke-width="1.2"/>
                        <line x1="16" y1="15" x2="16" y2="18.5" stroke="#f59e0b" stroke-width="1.2"/>
                        <line x1="20" y1="15" x2="20" y2="18.5" stroke="#f59e0b" stroke-width="1.2"/>
                        <line x1="24" y1="15" x2="24" y2="18.5" stroke="#f59e0b" stroke-width="1.2"/>
                    </svg>
                    <span class="text-[9px] font-mono font-bold truncate max-w-full leading-none">
                        <%= port.port_name.replace('Port ', 'LAN') %>
                    </span>
                </button>
                <% }) %>
                
                <% fiberTypes.forEach(ft => { (portGroups[ft.key] || []).forEach(port => {
                    const st = getPortStyle(port);
                    %>
                    <button type="button"
                    data-port="<%= JSON.stringify(port) %>"
                    onclick="openPortModal(this)"
                    class="relative <%= ft.widthClass %> h-14 rounded-md border-2 <%= st.box %> flex flex-col items-center justify-between p-1 transition transform hover:scale-105 cursor-pointer">
                    <div class="w-full flex items-center justify-between px-0.5">
                        <span class="w-1.5 h-1.5 rounded-full <%= st.led %>"></span>
                        <span class="text-[7px] font-mono font-bold"><%= st.speedBadge || port.port_capacity %></span>
                    </div>
                    <span class="text-[9px] font-mono font-bold"><%= port.port_name %></span>
                </button>
                <% }) }) %>
            </div>
            <div class="text-[10px] font-mono uppercase tracking-wider text-zinc-400 text-center">
                NETWORK LAN PORTS
            </div>
        </div>
        
        <!-- Power Input DC 12V / AC -->
        <div class="flex flex-col items-center gap-1 pl-3 border-l border-zinc-700">
            <div class="w-10 h-10 rounded-lg bg-zinc-950 border-2 border-zinc-600 flex items-center justify-center">
                <div class="w-5 h-5 rounded-full bg-black border-2 border-amber-400/70 flex items-center justify-center">
                    <div class="w-1.5 h-1.5 rounded-full bg-amber-300"></div>
                </div>
            </div>
            <span class="text-[9px] font-mono text-zinc-400">DC 12V</span>
        </div>
    </div>
    <!-- Kaki Karet DVR/NVR (Nempel Persis ke Bodi) -->
    <div class="w-[86%] flex justify-between px-4">
        <div class="w-12 h-2 bg-zinc-700 border-x border-b border-zinc-600 rounded-b-md shadow"></div>
        <div class="w-12 h-2 bg-zinc-700 border-x border-b border-zinc-600 rounded-b-md shadow"></div>
    </div>
</div>
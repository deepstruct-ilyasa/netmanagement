<div class="min-w-max flex flex-col items-center">
  <div class="w-full bg-gradient-to-b from-slate-900 via-slate-950 to-slate-900 border-2 border-slate-600 rounded-xl p-4 shadow-inner flex items-stretch gap-5 relative">

    <!-- Rack Ear Kiri -->
    <div class="w-4 flex flex-col justify-between py-2 border-r border-slate-700/80 pr-3 shrink-0">
      <div class="w-2.5 h-4 rounded-full bg-slate-800 border border-slate-600"></div>
      <div class="w-2.5 h-4 rounded-full bg-slate-800 border border-slate-600"></div>
    </div>

    <!-- Panel Identitas Kiri Chassis -->
    <div class="w-36 flex flex-col justify-between border-r border-slate-800 pr-4 py-1 shrink-0">
      <div>
        <div class="text-xs font-bold text-zinc-200 truncate mt-0.5" title="<%= device.hostname %>">
          <%= device.hostname %>
        </div>
        <div class="text-[12px] font-bold tracking-widest text-emerald-400">
          <%= device.brand || device.type_name %>
        </div>
        <div class="text-[12px] font-medium text-slate-400 truncate"><%= device.model || '' %></div>
      </div>

      <div class="space-y-1.5 pt-3">
        <div class="flex items-center gap-2 text-[10px] text-zinc-200">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>PWR / SYS</span>
        </div>
        <% if (device.is_poe === 1) { %>
          <div class="flex items-center gap-2 text-[10px] text-amber-400">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            <span>Power over Ethernet</span>
          </div>
        <% } %>
      </div>
    </div>

    <!-- DERETAN BLOK PORT -->
    <div class="flex items-center gap-6 py-1">

      <!-- 1. BLOK PORT RJ45 (LAN) -->
      <% if (portGroups.RJ45.length > 0) { %>
        <div class="space-y-1.5">
          <div class="<%= isTwoRow ? 'grid grid-rows-2 grid-flow-col gap-2' : 'flex items-center gap-2' %> bg-slate-900/90 p-2.5 rounded-lg border border-slate-700/80">
            <% portGroups.RJ45.forEach(port => {
              const st = getPortStyle(port);
              let targetLabel = `Kosong (Max ${port.port_capacity || '1G'})`;
              if (port.peer_device_hostname) {
                targetLabel = `[${port.link_speed || '1G'}] Ke: ${port.peer_device_hostname} (${port.peer_port_name})`;
              } else if (port.end_device_info) {
                targetLabel = `[${port.link_speed || '1G'}] Ke: ${port.end_device_info}`;
              }
            %>
              <button type="button"
                data-port="<%= JSON.stringify(port) %>"
                onclick="openPortModal(this)"
                title="<%= port.port_name %> - <%= targetLabel %>"
                class="group relative w-13 h-14 rounded-md border-2 <%= st.box %> flex flex-col items-center justify-between p-1 transition transform hover:scale-105 cursor-pointer">

                <div class="w-full flex items-center justify-between px-0.5">
                  <span class="w-1.5 h-1.5 rounded-full <%= st.led %>"></span>
                  <% if (st.speedBadge) { %>
                    <span class="text-[7px] font-mono font-bold px-1 rounded bg-black/40 leading-tight">
                      <%= st.speedBadge %>
                    </span>
                  <% } else if (device.is_poe === 1) { %>
                    <span class="text-[8px] text-amber-400 leading-none">&#9889;</span>
                  <% } %>
                </div>

                <!-- SVG Socket RJ45 -->
                <svg class="w-8 h-5 text-slate-400" viewBox="0 0 32 22" fill="none">
                  <path d="M3 6H10V3H22V6H29V19H3V6Z" fill="#090d16" stroke="currentColor" stroke-width="1.5"/>
                  <line x1="7" y1="15" x2="7" y2="18.5" stroke="#f59e0b" stroke-width="1.2"/>
                  <line x1="9.5" y1="15" x2="9.5" y2="18.5" stroke="#f59e0b" stroke-width="1.2"/>
                  <line x1="12" y1="15" x2="12" y2="18.5" stroke="#f59e0b" stroke-width="1.2"/>
                  <line x1="14.5" y1="15" x2="14.5" y2="18.5" stroke="#f59e0b" stroke-width="1.2"/>
                  <line x1="17.5" y1="15" x2="17.5" y2="18.5" stroke="#f59e0b" stroke-width="1.2"/>
                  <line x1="20" y1="15" x2="20" y2="18.5" stroke="#f59e0b" stroke-width="1.2"/>
                  <line x1="22.5" y1="15" x2="22.5" y2="18.5" stroke="#f59e0b" stroke-width="1.2"/>
                  <line x1="25" y1="15" x2="25" y2="18.5" stroke="#f59e0b" stroke-width="1.2"/>
                </svg>

                <span class="text-[9px] font-mono font-bold truncate max-w-full leading-none">
                  <%= port.port_name.replace('Port ', '') %>
                </span>
              </button>
            <% }) %>
          </div>
          <div class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 text-center">
            RJ45 LAN
          </div>
        </div>
      <% } %>

      <!-- 2. BLOK PORT FIBER (SFP, SFP+, QSFP+, QSFP28) -->
      <% fiberTypes.forEach(ft => {
        const list = portGroups[ft.key];
        if (list && list.length > 0) {
      %>
        <div class="space-y-1.5">
          <div class="<%= (isTwoRow && list.length > 2) ? 'grid grid-rows-2 grid-flow-col gap-2' : 'flex items-center gap-2' %> bg-slate-900/90 p-2.5 rounded-lg border border-slate-700/80">
            <% list.forEach(port => {
              const st = getPortStyle(port);
              let targetLabel = `Kosong (Max ${port.port_capacity})`;
              if (port.peer_device_hostname) {
                targetLabel = `[${port.link_speed || port.port_capacity}] Ke: ${port.peer_device_hostname} (${port.peer_port_name})`;
              } else if (port.end_device_info) {
                targetLabel = `[${port.link_speed || port.port_capacity}] Ke: ${port.end_device_info}`;
              }
            %>
              <button type="button"
                data-port="<%= JSON.stringify(port) %>"
                onclick="openPortModal(this)"
                title="<%= port.port_name %> - <%= targetLabel %>"
                class="relative <%= ft.widthClass %> h-14 rounded-md border-2 <%= st.box %> flex flex-col items-center justify-between p-1 transition transform hover:scale-105 cursor-pointer">

                <div class="w-full flex items-center justify-between px-0.5">
                  <span class="w-1.5 h-1.5 rounded-full <%= st.led %>"></span>
                  <span class="text-[7px] font-mono font-bold <%= st.speedBadge ? 'px-1 rounded bg-black/40' : ft.badgeColor %>">
                    <%= st.speedBadge || port.port_capacity %>
                  </span>
                </div>

                <% if (!ft.isQuad) { %>
                  <svg class="w-9 h-5 text-slate-400" viewBox="0 0 36 20" fill="none">
                    <rect x="4" y="3" width="28" height="14" rx="1.5" fill="#090d16" stroke="currentColor" stroke-width="1.5"/>
                    <rect x="8" y="6" width="8" height="8" rx="0.5" fill="#1e293b" stroke="#475569" stroke-width="1"/>
                    <rect x="18" y="6" width="8" height="8" rx="0.5" fill="#1e293b" stroke="#475569" stroke-width="1"/>
                    <path d="M32 5H34.5V15H32" stroke="#94a3b8" stroke-width="1.5"/>
                  </svg>
                <% } else { %>
                  <svg class="w-14 h-5 text-slate-400" viewBox="0 0 56 20" fill="none">
                    <rect x="3" y="3" width="46" height="14" rx="1.5" fill="#090d16" stroke="currentColor" stroke-width="1.5"/>
                    <rect x="7" y="6" width="7" height="8" rx="0.5" fill="#1e293b" stroke="#64748b" stroke-width="1"/>
                    <rect x="16" y="6" width="7" height="8" rx="0.5" fill="#1e293b" stroke="#64748b" stroke-width="1"/>
                    <rect x="25" y="6" width="7" height="8" rx="0.5" fill="#1e293b" stroke="#64748b" stroke-width="1"/>
                    <rect x="34" y="6" width="7" height="8" rx="0.5" fill="#1e293b" stroke="#64748b" stroke-width="1"/>
                    <rect x="49" y="6" width="5" height="8" rx="1" fill="#334155" stroke="#94a3b8" stroke-width="1.2"/>
                  </svg>
                <% } %>

                <span class="text-[9px] font-mono font-bold truncate max-w-full leading-none">
                  <%= port.port_name %>
                </span>
              </button>
            <% }) %>
          </div>
          <div class="text-[10px] font-semibold uppercase tracking-wider <%= ft.badgeColor %> text-center">
            <%= ft.key %>
          </div>
        </div>
      <% } }) %>

    </div>

    <!-- Rack Ear Kanan -->
    <div class="w-4 flex flex-col justify-between py-2 border-l border-slate-700/80 pl-3 ml-auto shrink-0">
      <div class="w-2.5 h-4 rounded-full bg-slate-800 border border-slate-600"></div>
      <div class="w-2.5 h-4 rounded-full bg-slate-800 border border-slate-600"></div>
    </div>

  </div>
</div>
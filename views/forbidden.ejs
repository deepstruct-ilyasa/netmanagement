<%- include('partials/header', { pageTitle: 'Akses Ditolak' }) %>

<main class="p-6 flex-1 flex items-center justify-center">
  <div class="max-w-md w-full bg-slate-800 border border-slate-700 rounded-2xl p-8 text-center space-y-4 shadow-xl">
    <div class="w-14 h-14 rounded-2xl bg-rose-500/15 border border-rose-500/30 text-rose-400 flex items-center justify-center mx-auto">
      <i data-lucide="shield-alert" class="w-7 h-7"></i>
    </div>
    <h2 class="text-xl font-bold text-white">403 — Akses Dibatasi</h2>
    <p class="text-sm text-slate-300"><%= message %></p>
    <div class="pt-2">
      <a href="/" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-semibold text-sm transition">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        <span>Kembali ke Beranda</span>
      </a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
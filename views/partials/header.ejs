<!DOCTYPE html>
<html lang="en" class="dark preload">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'NetAsset Hospital' %></title>
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <script type="text/javascript" src="https://unpkg.com/vis-network/standalone/umd/vis-network.min.js"></script>
  <script>
    tailwind.config = {
      darkMode: 'class'
    };

    // Terapkan tema tersimpan sebelum halaman di-render (anti kedip)
    if (localStorage.getItem('theme') === 'light') {
      document.documentElement.classList.remove('dark');
    } else {
      document.documentElement.classList.add('dark');
    }

    // Terapkan status sidebar terakhir sebelum halaman di-render (anti kedip)
    if (localStorage.getItem('sidebarHidden') === 'true') {
      document.documentElement.classList.add('sidebar-is-hidden');
    }
  </script>

  <!-- Pengaturan Anti-Kedip & Adaptasi Otomatis Warna Saat Mode Terang (Light Mode) Aktif -->
  <style>
    /* Kunci sidebar langsung tersembunyi di desktop sejak frame 0 jika statusnya hidden */
    @media (min-width: 1024px) {
      html.sidebar-is-hidden #sidebar {
        display: none !important;
      }
    }

    /* Matikan transisi CSS sesaat ketika halaman baru dibuka agar tidak berkedip/beranimasi */
    html.preload * {
      transition: none !important;
    }

    /* Light Mode Overrides */
    html:not(.dark) body { background-color: #f1f5f9; color: #0f172a; }
    html:not(.dark) aside,
    html:not(.dark) header,
    html:not(.dark) .bg-slate-800,
    html:not(.dark) .bg-slate-800\/80 { background-color: #ffffff !important; border-color: #cbd5e1 !important; }
    html:not(.dark) .bg-slate-900,
    html:not(.dark) .bg-slate-900\/30,
    html:not(.dark) .bg-slate-900\/60,
    html:not(.dark) .bg-slate-900\/70,
    html:not(.dark) .bg-slate-900\/80 { background-color: #f8fafc !important; border-color: #cbd5e1 !important; }
    html:not(.dark) .bg-slate-700,
    html:not(.dark) .bg-slate-700\/60,
    html:not(.dark) .bg-slate-700\/70 { background-color: #e2e8f0 !important; color: #1e293b !important; }
    html:not(.dark) .hover\:bg-slate-700\/30:hover,
    html:not(.dark) .hover\:bg-slate-700\/50:hover { background-color: #f1f5f9 !important; }
    html:not(.dark) .border-slate-700,
    html:not(.dark) .border-slate-700\/60,
    html:not(.dark) .border-slate-700\/80,
    html:not(.dark) .border-slate-600,
    html:not(.dark) .border-slate-800 { border-color: #cbd5e1 !important; }
    html:not(.dark) .text-white { color: #0f172a !important; }
    html:not(.dark) .text-slate-100,
    html:not(.dark) .text-slate-200 { color: #1e293b !important; }
    html:not(.dark) .text-slate-300 { color: #334155 !important; }
    html:not(.dark) .text-slate-400 { color: #64748b !important; }
    html:not(.dark) .text-emerald-400 { color: #059669 !important; }
    html:not(.dark) input,
    html:not(.dark) select { color: #0f172a !important; }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex font-sans transition-colors duration-200">

  <!-- Panggil Sidebar -->
  <%- include('sidebar') %>

  <!-- Wrapper Konten Kanan -->
  <div class="flex-1 flex flex-col min-w-0">
    
    <!-- Top Header Bar -->
    <header class="h-16 bg-slate-800/80 backdrop-blur border-b border-slate-700 px-4 sm:px-6 flex items-center justify-between sticky top-0 z-20 transition-colors duration-200">
      <div class="flex items-center gap-3">
        <!-- Tombol Toggle Sidebar -->
        <button onclick="toggleSidebar()" class="p-2 rounded-lg bg-slate-700/60 hover:bg-slate-700 text-slate-200 focus:outline-none transition cursor-pointer" title="Toggle Sidebar">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
        <h1 class="text-base sm:text-lg font-semibold text-white truncate">
          <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %>
        </h1>
      </div>

      <!-- Tombol Toggle Tema Terang / Gelap -->
      <div class="flex items-center gap-3">
        <button id="theme-toggle" onclick="toggleTheme()" class="p-2 rounded-lg bg-slate-700/60 hover:bg-slate-700 text-slate-200 focus:outline-none transition cursor-pointer" title="Ganti Tema Terang / Gelap">
          <!-- Ikon Matahari (Muncul saat Dark Mode untuk beralih ke Terang) -->
          <svg id="icon-sun" class="w-5 h-5 text-amber-400 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
          <!-- Ikon Bulan (Muncul saat Light Mode untuk beralih ke Gelap) -->
          <svg id="icon-moon" class="w-5 h-5 text-slate-700 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
          </svg>
        </button>
      </div>
    </header>
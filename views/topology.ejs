    // =========================================================
    // GENERATOR KARTU KOTAK (IKON + HOSTNAME + IP ADDRESS)
    // =========================================================
    function createDeviceCardSvgUri(dev, isDark) {
      const cat = resolveDeviceCategory(dev);
      const accent = getCategoryAccent(cat);
      const iconInnerSvg = getRawIconPaths(cat);

      const hostname = escapeXml(dev.hostname || '-');
      const ipText = escapeXml(dev.ip_address || '-');

      const maxChars = Math.max(hostname.length, ipText.length);
      const cardWidth = Math.max(140, Math.min(230, maxChars * 8 + 36));
      const cardHeight = 104;
      const centerX = cardWidth / 2;

      const cardBg = isDark ? '#1e293b' : '#ffffff';
      const titleColor = isDark ? '#f8fafc' : '#0f172a';
      const ipBg = isDark ? '#0f172a' : '#f1f5f9';
      const ipColor = isDark ? '#34d399' : '#047857';

      const cardSvg = `
        <svg xmlns="http://www.w3.org/2000/svg" width="${cardWidth}" height="${cardHeight}" viewBox="0 0 ${cardWidth} ${cardHeight}">
          <!-- Kotak Kartu Utama -->
          <rect x="2" y="2" width="${cardWidth - 4}" height="${cardHeight - 4}" rx="12"
                fill="${cardBg}" stroke="${accent.border}" stroke-width="2.5"/>

          <!-- Strip Aksen Atas -->
          <path d="M14 2 H${cardWidth - 14} Q${cardWidth - 2} 2 ${cardWidth - 2} 10 V12 H2 V10 Q2 2 14 2 Z"
                fill="${accent.border}" opacity="0.25"/>

          <!-- Ikon Perangkat di Tengah Atas -->
          <g transform="translate(${centerX - 23}, 9) scale(0.718)">
            ${iconInnerSvg}
          </g>

          <!-- Teks Hostname -->
          <text x="${centerX}" y="70" text-anchor="middle"
                font-family="ui-sans-serif, system-ui, sans-serif" font-size="12" font-weight="700"
                fill="${titleColor}">
            ${hostname}
          </text>

          <!-- Kotak Kecil / Pill IP Address -->
          <rect x="${centerX - 56}" y="77" width="112" height="19" rx="5" fill="${ipBg}"/>
          <text x="${centerX}" y="90" text-anchor="middle"
                font-family="ui-monospace, SFMono-Regular, monospace" font-size="10.5" font-weight="600"
                fill="${ipColor}">
            ${ipText}
          </text>
        </svg>
      `;

      return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(cardSvg.trim());
    }

    // =========================================================
    // GENERATOR KARTU KOTAK END-DEVICE (PC / CCTV / PRINTER / VOIP)
    // =========================================================
    function createEndDeviceCardSvgUri(label, isDark) {
      const rawLabel = label || 'Client';
      const txt = rawLabel.toLowerCase();
      const safeLabel = escapeXml(rawLabel);

      let iconPath = '';
      if (txt.includes('cctv') || txt.includes('cam')) {
        iconPath = `<circle cx="18" cy="18" r="10" fill="#090d16" stroke="#38bdf8" stroke-width="2"/><circle cx="18" cy="18" r="4" fill="#38bdf8"/>`;
      } else if (txt.includes('print')) {
        iconPath = `<rect x="8" y="13" width="20" height="11" rx="2" fill="#cbd5e1"/><rect x="11" y="8" width="14" height="5" fill="#94a3b8"/><rect x="11" y="21" width="14" height="7" fill="#ffffff"/>`;
      } else if (txt.includes('tel') || txt.includes('voip') || txt.includes('phone')) {
        iconPath = `<path d="M12 10c-2 2-2 15 0 17l4-3v-4l-2-2 2-2v-4l-4-2z" fill="#f59e0b"/>`;
      } else {
        iconPath = `
          <rect x="6" y="8" width="24" height="16" rx="2" fill="#0f172a" stroke="#38bdf8" stroke-width="2"/>
          <path d="M14 24h8l2 5H12l2-5z" fill="#94a3b8"/>
        `;
      }

      const cardWidth = Math.max(120, Math.min(210, safeLabel.length * 7.5 + 32));
      const cardHeight = 76;
      const centerX = cardWidth / 2;

      const cardBg = isDark ? '#0f172a' : '#f8fafc';
      const borderColor = isDark ? '#475569' : '#94a3b8';
      const textColor = isDark ? '#e2e8f0' : '#1e293b';

      const svg = `
        <svg xmlns="http://www.w3.org/2000/svg" width="${cardWidth}" height="${cardHeight}" viewBox="0 0 ${cardWidth} ${cardHeight}">
          <rect x="2" y="2" width="${cardWidth - 4}" height="${cardHeight - 4}" rx="10"
                fill="${cardBg}" stroke="${borderColor}" stroke-width="1.8" stroke-dasharray="4 2"/>
          <g transform="translate(${centerX - 18}, 7)">
            ${iconPath}
          </g>
          <text x="${centerX}" y="58" text-anchor="middle"
                font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" font-weight="600"
                fill="${textColor}">
            ${safeLabel}
          </text>
        </svg>
      `;

      return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg.trim());
    }

    // =========================================================
    // TAMPIL / SEMBUNYI PANEL INSPECTOR (KANVAS FULL <-> 9 KOLOM)
    // =========================================================
    function openInspectorPanel() {
      const canvasWrap = document.getElementById('topology-canvas-wrapper');
      const panel = document.getElementById('inspector-panel');
      if (!canvasWrap || !panel) return;

      const wasHidden = panel.classList.contains('hidden');
      canvasWrap.classList.remove('lg:col-span-12');
      canvasWrap.classList.add('lg:col-span-9');
      panel.classList.remove('hidden');
      panel.classList.add('flex');

      if (wasHidden && network) {
        requestAnimationFrame(() => network.redraw());
      }
    }

    window.closeInspectorPanel = function () {
      const canvasWrap = document.getElementById('topology-canvas-wrapper');
      const panel = document.getElementById('inspector-panel');
      if (!canvasWrap || !panel) return;

      const wasVisible = !panel.classList.contains('hidden');
      panel.classList.add('hidden');
      panel.classList.remove('flex');
      canvasWrap.classList.remove('lg:col-span-9');
      canvasWrap.classList.add('lg:col-span-12');

      if (network) {
        network.unselectAll();
        if (wasVisible) {
          requestAnimationFrame(() => network.redraw());
        }
      }
    };

    function showEdgeDetails(c) {
      openInspectorPanel();
      document.getElementById('inspector-device').classList.add('hidden');
      document.getElementById('inspector-edge').classList.remove('hidden');

      document.getElementById('insp-edge-a').textContent = `${c.device_a_hostname} (${c.port_a_name})`;
      document.getElementById('insp-edge-b').textContent = c.device_b_hostname
        ? `${c.device_b_hostname} (${c.port_b_name})`
        : (c.end_device_info || '-');
      document.getElementById('insp-edge-speed').textContent = c.link_speed || '-';
      document.getElementById('insp-edge-cable').textContent = c.cable_type || '-';
      document.getElementById('insp-edge-vlan').textContent = c.vlan_info || '-';
      document.getElementById('insp-edge-notes').textContent = c.notes || 'Tidak ada catatan.';
    }

    function initTopology() {
      const container = document.getElementById('topology-canvas');
      if (!container || rawDevices.length === 0) return;

      // Hancurkan instance Vis.js lama jika masih tersisa dari navigasi sebelumnya
      if (window._activeTopologyNetwork && typeof window._activeTopologyNetwork.destroy === 'function') {
        try {
          window._activeTopologyNetwork.destroy();
        } catch (_) {}
        window._activeTopologyNetwork = null;
      }

      const isDark = document.documentElement.classList.contains('dark');
      const nodesArray = [];
      const edgesArray = [];

      // 1. Tambahkan Node Perangkat Utama dalam Bentuk Kartu Kotak
      rawDevices.forEach(dev => {
        nodesArray.push({
          id: `dev_${dev.id}`,
          shape: 'image',
          image: createDeviceCardSvgUri(dev, isDark),
          size: 46,
          shapeProperties: {
            useBorderWithImage: false
          },
          shadow: { enabled: true, color: 'rgba(0,0,0,0.30)', size: 10, x: 0, y: 4 },
          rawDevice: dev
        });
      });

      // 2. Tambahkan Jalur Koneksi (Edges) & End-Device Nodes
      rawConnections.forEach(conn => {
        const style = getEdgeStyleBySpeed(conn.link_speed);
        const fromNodeId = `dev_${conn.device_a_id}`;

        if (conn.device_b_id) {
          const toNodeId = `dev_${conn.device_b_id}`;
          edgesArray.push({
            id: `edge_${conn.connection_id}`,
            from: fromNodeId,
            to: toNodeId,
            label: `${conn.port_a_name} ↔ ${conn.port_b_name}\n(${conn.link_speed || '1G'})`,
            color: { color: style.color, highlight: '#f43f5e', hover: style.color },
            width: style.width,
            font: {
              size: 10,
              color: isDark ? '#cbd5e1' : '#334155',
              strokeWidth: 3,
              strokeColor: isDark ? '#0f172a' : '#ffffff',
              align: 'middle'
            },
            smooth: { type: 'dynamic' },
            rawConn: conn
          });
        } else if (conn.end_device_info) {
          const endNodeId = `end_${conn.connection_id}`;
          nodesArray.push({
            id: endNodeId,
            shape: 'image',
            image: createEndDeviceCardSvgUri(conn.end_device_info, isDark),
            size: 34,
            shapeProperties: {
              useBorderWithImage: false
            },
            shadow: { enabled: true, color: 'rgba(0,0,0,0.20)', size: 6, x: 0, y: 3 },
            isEndDevice: true,
            rawConn: conn
          });

          edgesArray.push({
            id: `edge_${conn.connection_id}`,
            from: fromNodeId,
            to: endNodeId,
            label: `${conn.port_a_name} (${conn.link_speed || '1G'})`,
            dashes: true,
            color: { color: '#64748b', highlight: '#f43f5e' },
            width: 1.8,
            font: {
              size: 9,
              color: isDark ? '#94a3b8' : '#475569',
              strokeWidth: 3,
              strokeColor: isDark ? '#0f172a' : '#ffffff'
            },
            rawConn: conn
          });
        }
      });

      nodesDataSet = new vis.DataSet(nodesArray);
      edgesDataSet = new vis.DataSet(edgesArray);

      const options = {
        interaction: {
          hover: true,
          tooltipDelay: 150,
          navigationButtons: false
        },
        physics: {
          enabled: true,
          barnesHut: {
            gravitationalConstant: -5500,
            centralGravity: 0.22,
            springLength: 220,
            springConstant: 0.04,
            damping: 0.09
          },
          stabilization: { iterations: 150 }
        }
      };

      network = new vis.Network(container, { nodes: nodesDataSet, edges: edgesDataSet }, options);
      window._activeTopologyNetwork = network;

      // =========================================================
      // PENYESUAIAN OTOMATIS ARAH TEKS PORT A ↔ PORT B SESUAI ROTASI VIS.JS
      // =========================================================
      function syncEdgeLabelsOrientation() {
        if (!network || !edgesDataSet) return;

        const positions = network.getPositions();
        const updates = [];

        edgesDataSet.forEach(edge => {
          const c = edge.rawConn;
          if (!c || !c.device_b_id) return;

          const posA = positions[`dev_${c.device_a_id}`];
          const posB = positions[`dev_${c.device_b_id}`];
          if (!posA || !posB) return;

          const dx = posB.x - posA.x;
          const dy = posB.y - posA.y;

          const isVisuallyReversed = dx < 0 || (dx === 0 && dy < 0);

          const expectedLabel = isVisuallyReversed
            ? `${c.port_b_name} ↔ ${c.port_a_name}\n(${c.link_speed || '1G'})`
            : `${c.port_a_name} ↔ ${c.port_b_name}\n(${c.link_speed || '1G'})`;

          if (edge.label !== expectedLabel) {
            updates.push({ id: edge.id, label: expectedLabel });
          }
        });

        if (updates.length > 0) {
          edgesDataSet.update(updates);
        }
      }

      network.on('stabilized', syncEdgeLabelsOrientation);
      network.on('dragging', syncEdgeLabelsOrientation);
      network.on('dragEnd', syncEdgeLabelsOrientation);

      // Event Klik Node atau Garis Kabel
      network.on('click', function (params) {
        const devBox = document.getElementById('inspector-device');
        const edgeBox = document.getElementById('inspector-edge');

        if (params.nodes.length > 0) {
          const nodeId = params.nodes[0];
          const clickedNode = nodesDataSet.get(nodeId);

          if (clickedNode && clickedNode.rawDevice) {
            const d = clickedNode.rawDevice;
            openInspectorPanel();
            edgeBox.classList.add('hidden');
            devBox.classList.remove('hidden');

            document.getElementById('insp-dev-type').textContent = d.type_name;
            document.getElementById('insp-dev-hostname').textContent = d.hostname;
            document.getElementById('insp-dev-codebranch').textContent = d.branch_code;
            document.getElementById('insp-dev-branch').textContent = d.branch_name;
            document.getElementById('insp-dev-location').textContent = d.room_location || '-';
            document.getElementById('insp-dev-model').textContent = `${d.brand || ''} ${d.model || ''}`.trim() || '-';
            document.getElementById('insp-dev-ip').textContent = d.ip_address || 'No IP';
            document.getElementById('insp-dev-mac').textContent = d.mac_address || '-';
            document.getElementById('insp-dev-ports').textContent = `${d.active_ports_count || 0} Port Terhubung`;
            document.getElementById('insp-dev-link').href = `/devices/${d.id}/visual`;
          } else if (clickedNode && clickedNode.isEndDevice) {
            showEdgeDetails(clickedNode.rawConn);
          }
        } else if (params.edges.length > 0) {
          const edgeId = params.edges[0];
          const clickedEdge = edgesDataSet.get(edgeId);
          if (clickedEdge && clickedEdge.rawConn) {
            showEdgeDetails(clickedEdge.rawConn);
          }
        } else {
          window.closeInspectorPanel();
        }
      });
    }

    // =========================================================
    // UPDATE WARNA NODE & LABEL KABEL SECARA REALTIME SAAT GANTI TEMA
    // =========================================================
    function updateTopologyTheme() {
      if (!nodesDataSet || !edgesDataSet) return;
      const isDark = document.documentElement.classList.contains('dark');

      const updatedNodes = nodesDataSet.get().map(node => {
        if (node.rawDevice) {
          return {
            id: node.id,
            image: createDeviceCardSvgUri(node.rawDevice, isDark)
          };
        }
        if (node.isEndDevice && node.rawConn) {
          return {
            id: node.id,
            image: createEndDeviceCardSvgUri(node.rawConn.end_device_info, isDark)
          };
        }
        return { id: node.id };
      });
      nodesDataSet.update(updatedNodes);

      const updatedEdges = edgesDataSet.get().map(edge => {
        const isEndEdge = edge.dashes === true;
        return {
          id: edge.id,
          font: {
            size: isEndEdge ? 9 : 10,
            color: isDark
              ? (isEndEdge ? '#94a3b8' : '#cbd5e1')
              : (isEndEdge ? '#475569' : '#334155'),
            strokeWidth: 3,
            strokeColor: isDark ? '#0f172a' : '#ffffff',
            align: isEndEdge ? undefined : 'middle'
          }
        };
      });
      edgesDataSet.update(updatedEdges);

      if (network) network.redraw();
    }

    // Ganti listener themeChanged lama jika sebelumnya sudah terdaftar (aman untuk PJAX)
    if (window._topoThemeHandler) {
      window.removeEventListener('themeChanged', window._topoThemeHandler);
    }
    window._topoThemeHandler = updateTopologyTheme;
    window.addEventListener('themeChanged', window._topoThemeHandler);

    window.fitTopologyScreen = function () {
      if (network) network.fit({ animation: true });
    };

    window.togglePhysics = function () {
      if (!network) return;
      physicsEnabled = !physicsEnabled;
      network.setOptions({ physics: { enabled: physicsEnabled } });

      const btnEl = document.getElementById('btn-toggle-physics');
      const lockIcon = document.getElementById('icon-physics-lock');
      const unlockIcon = document.getElementById('icon-physics-unlock');
      const textEl = document.getElementById('text-physics');

      if (physicsEnabled) {
        lockIcon.classList.remove('hidden');
        unlockIcon.classList.add('hidden');
        if (textEl) textEl.textContent = 'Kunci Posisi';
        btnEl.className = 'w-full px-3.5 py-2 text-left flex items-center gap-2.5 text-sky-800 dark:text-sky-300 hover:bg-sky-100 dark:hover:bg-sky-500/25 font-medium transition cursor-pointer';
      } else {
        lockIcon.classList.add('hidden');
        unlockIcon.classList.remove('hidden');
        if (textEl) textEl.textContent = 'Auto-Layout';
        btnEl.className = 'w-full px-3.5 py-2 text-left flex items-center gap-2.5 text-amber-800 dark:text-amber-300 hover:bg-amber-100 dark:hover:bg-amber-500/25 font-medium transition cursor-pointer';
      }
    };

    window.exportTopologyPNG = function () {
      const canvas = document.querySelector('#topology-canvas canvas');
      if (!canvas) return;
      const link = document.createElement('a');
      link.download = `topologi-jaringan-${new Date().toISOString().slice(0, 10)}.png`;
      link.href = canvas.toDataURL('image/png');
      link.click();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTopology);
    } else {
      initTopology();
    }
  })();
</script>


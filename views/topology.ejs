<%- include('partials/header', { pageTitle: 'Topologi Jaringan' }) %>
<main class="p-4 sm:p-5 flex-1 min-h-0 w-full flex flex-col gap-3">

  <!-- Bar Kontrol Atas -->
  <div class="shrink-0 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-4 py-3 rounded-xl shadow-sm flex flex-col lg:flex-row lg:items-center justify-between gap-3">
    <div>
      <h2 class="text-base font-semibold text-slate-800 dark:text-white flex items-center gap-2">
        <i data-lucide="share-2" class="w-4 h-4 text-emerald-500"></i>
        <span>Visualisasi Topologi Jaringan</span>
      </h2>
      <p class="text-xs text-slate-500 dark:text-slate-400">
        Menampilkan <strong class="text-slate-700 dark:text-slate-200"><%= devices.length %></strong> perangkat dan 
        <strong class="text-slate-700 dark:text-slate-200"><%= connections.length %></strong> jalur koneksi aktif. Klik node atau jalur kabel untuk melihat detail.
      </p>
    </div>

    <div class="flex items-center gap-2 text-xs">
      <!-- Filter Cabang -->
      <form method="GET" action="/topology" class="flex items-center gap-2 flex-1 sm:flex-initial min-w-0">
        <label for="branch_filter" class="text-slate-500 dark:text-slate-400 font-medium shrink-0">Cabang:</label>
        <select id="branch_filter" name="branch_id" onchange="this.form.submit()"
          class="w-full sm:w-auto max-w-full min-w-0 flex-1 truncate bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-1.5 text-slate-800 dark:text-white focus:outline-none focus:border-emerald-500">
          <% if (branches.length > 1) { %>
            <option value="all" <%= selectedBranchId === 'all' ? 'selected' : '' %>>Semua Cabang</option>
          <% } %>
          <% branches.forEach(b => { %>
            <option value="<%= b.id %>" <%= String(selectedBranchId) === String(b.id) ? 'selected' : '' %>>
              [<%= b.branch_code %>] <%= b.branch_name %>
            </option>
          <% }) %>
        </select>
      </form>

      <!-- Dropdown Menu Titik Tiga (Fit Layar, Kunci Posisi, Export PNG) -->
      <div class="relative shrink-0" id="topology-actions-wrapper">
        <button type="button" id="btn-topology-menu" onclick="toggleTopologyMenu(event)" title="Opsi Topologi"
          class="inline-flex items-center justify-center p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-200 dark:border-slate-600 transition cursor-pointer">
          <i data-lucide="more-vertical" class="w-4 h-4"></i>
        </button>

        <!-- Panel Menu Dropdown -->
        <div id="topology-actions-menu"
          class="hidden absolute right-0 top-full mt-1.5 w-48 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-xl py-1.5 z-50">
          
          <!-- 1. Fit Layar -->
          <button type="button" onclick="fitTopologyScreen(); closeTopologyMenu();"
            class="w-full px-3.5 py-2 text-left flex items-center gap-2.5 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700/70 font-medium transition cursor-pointer">
            <i data-lucide="maximize" class="w-4 h-4 text-slate-500 dark:text-slate-400 shrink-0"></i>
            <span>Fit Layar</span>
          </button>

          <!-- 2. Toggle Physics / Kunci Posisi -->
          <button type="button" id="btn-toggle-physics" onclick="togglePhysics(); closeTopologyMenu();"
            class="w-full px-3.5 py-2 text-left flex items-center gap-2.5 text-sky-700 dark:text-sky-300 hover:bg-sky-50 dark:hover:bg-sky-500/15 font-medium transition cursor-pointer">
            <i data-lucide="lock" class="w-4 h-4 shrink-0" id="icon-physics-lock"></i>
            <i data-lucide="unlock" class="w-4 h-4 shrink-0 hidden" id="icon-physics-unlock"></i>
            <span id="text-physics">Kunci Posisi</span>
          </button>

          <!-- 3. Export PNG -->
          <button type="button" onclick="exportTopologyPNG(); closeTopologyMenu();"
            class="w-full px-3.5 py-2 text-left flex items-center gap-2.5 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-500/15 font-semibold transition cursor-pointer">
            <i data-lucide="download" class="w-4 h-4 shrink-0"></i>
            <span>Export PNG</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Area Utama: Kanvas Topologi (Default Full 12 Kolom, menyusut ke 9 Kolom saat Node/Link diklik) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 flex-1 min-h-0">

    <!-- Kanvas Vis.js -->
    <div id="topology-canvas-wrapper" class="lg:col-span-12 relative bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl shadow-lg overflow-hidden flex flex-col min-h-[380px] lg:min-h-0 transition-all duration-200">
      <% if (devices.length === 0) { %>
        <div class="flex-1 flex flex-col items-center justify-center p-8 text-center text-slate-500 dark:text-slate-400 text-sm">
          <i data-lucide="network" class="w-10 h-10 mb-3 text-slate-400"></i>
          <p class="mb-2">Belum ada perangkat pada filter cabang ini.</p>
          <a href="/devices" class="text-emerald-500 hover:underline font-medium">+ Tambah perangkat di Master Perangkat</a>
        </div>
      <% } else { %>
        <!-- Absolute inset-0 memastikan kanvas Vis.js mengikuti tinggi container tanpa mendorong halaman -->
        <div id="topology-canvas" class="lg:absolute lg:inset-0 w-full h-full min-h-[380px] lg:min-h-0"></div>

        <!-- Legenda Kapasitas Link & Tipe Node (Pojok Kiri Bawah Kanvas) -->
        <div class="absolute bottom-3 left-3 right-3 sm:right-auto bg-white/90 dark:bg-slate-800/90 backdrop-blur-md border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-[11px] shadow-md flex flex-wrap items-center gap-x-3.5 gap-y-1 pointer-events-none">
          <span class="font-semibold text-slate-700 dark:text-slate-200">Kapasitas Link:</span>
          <span class="inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-300">
            <span class="w-3.5 h-1 rounded bg-amber-500 inline-block"></span> 100M
          </span>
          <span class="inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-300">
            <span class="w-3.5 h-1 rounded bg-emerald-500 inline-block"></span> 1G
          </span>
          <span class="inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-300">
            <span class="w-3.5 h-1.5 rounded bg-cyan-500 inline-block"></span> 2.5G / 10G
          </span>
          <span class="inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-300">
            <span class="w-3.5 h-2 rounded bg-purple-500 inline-block"></span> 40G / 100G
          </span>
          <span class="inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-300">
            <span class="w-3.5 h-0.5 border-t-2 border-dashed border-slate-400 inline-block"></span> End Device
          </span>
        </div>
      <% } %>
    </div>

    <!-- Panel Inspector Detail Node / Link (Hidden secara default, muncul 3 kolom saat diklik) -->
    <div id="inspector-panel" class="hidden lg:col-span-3 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-4 shadow-lg flex-col justify-between h-fit lg:max-h-full lg:overflow-y-auto space-y-4">
      <div>
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-700 pb-2.5 mb-3">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            Inspector Detail
          </h3>
          <button type="button" onclick="closeInspectorPanel()" title="Tutup Inspector"
            class="p-1 rounded-md text-slate-400 hover:text-slate-600 hover:bg-slate-100 dark:hover:text-slate-200 dark:hover:bg-slate-700 transition cursor-pointer">
            <i data-lucide="x" class="w-3.5 h-3.5"></i>
          </button>
        </div>

        <!-- Detail Perangkat (Muncul saat Node diklik) -->
        <div id="inspector-device" class="hidden space-y-3 text-xs">
          <div class="flex items-start justify-between gap-2">
            <h4 id="insp-dev-hostname" class="text-sm font-bold text-slate-800 dark:text-white break-all"></h4>
            <span id="insp-dev-type" class="shrink-0 inline-block px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-300"></span>
          </div>

          <div class="bg-slate-50 dark:bg-slate-900/70 border border-slate-200 dark:border-slate-700 rounded-lg p-3">
            <table class="w-full border-collapse text-xs">
              <tbody>
                <tr>
                  <td class="py-1 pr-3 text-slate-500 dark:text-slate-400 whitespace-nowrap align-top">Kode Cabang</td>
                  <td id="insp-dev-codebranch" class="py-1 font-medium text-slate-800 dark:text-slate-200 text-right align-top"></td>
                </tr>
                <tr>
                  <td class="py-1 pr-3 text-slate-500 dark:text-slate-400 whitespace-nowrap align-top">Nama Cabang</td>
                  <td id="insp-dev-branch" class="py-1 font-medium text-slate-800 dark:text-slate-200 text-right align-top"></td>
                </tr>
                <tr>
                  <td class="py-1 pr-3 text-slate-500 dark:text-slate-400 whitespace-nowrap align-top">Lokasi</td>
                  <td id="insp-dev-location" class="py-1 font-medium text-slate-800 dark:text-slate-200 text-right align-top"></td>
                </tr>
                <tr>
                  <td class="py-1 pr-3 text-slate-500 dark:text-slate-400 whitespace-nowrap align-top">Brand / Model</td>
                  <td id="insp-dev-model" class="py-1 font-medium text-slate-800 dark:text-slate-200 text-right align-top"></td>
                </tr>
                <tr>
                  <td class="py-1 pr-3 text-slate-500 dark:text-slate-400 whitespace-nowrap align-top">IP Address</td>
                  <td id="insp-dev-ip" class="py-1 font-mono font-semibold text-emerald-600 dark:text-emerald-400 text-right align-top"></td>
                </tr>
                <tr>
                  <td class="py-1 pr-3 text-slate-500 dark:text-slate-400 whitespace-nowrap align-top">MAC Address</td>
                  <td id="insp-dev-mac" class="py-1 font-mono text-slate-700 dark:text-slate-300 text-right align-top"></td>
                </tr>
                <tr>
                  <td class="py-1 pr-3 text-slate-500 dark:text-slate-400 whitespace-nowrap align-top">Port Terpakai</td>
                  <td id="insp-dev-ports" class="py-1 font-semibold text-sky-600 dark:text-sky-400 text-right align-top"></td>
                </tr>
              </tbody>
            </table>
          </div>

          <a id="insp-dev-link" href="#"
            class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-semibold transition">
            <i data-lucide="network" class="w-4 h-4"></i>
            <span>Buka Visual Faceplate</span>
          </a>
        </div>

        <!-- Detail Koneksi Kabel (Muncul saat Edge/Garis diklik) -->
        <div id="inspector-edge" class="hidden space-y-3 text-xs">
          <span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold bg-sky-100 text-sky-800 dark:bg-sky-500/20 dark:text-sky-300">
            Detail Jalur Koneksi
          </span>

          <div class="bg-slate-50 dark:bg-slate-900/70 border border-slate-200 dark:border-slate-700 rounded-lg p-3 space-y-2.5">
            <div>
              <span class="block text-[10px] uppercase text-slate-400">Titik Asal (Port A)</span>
              <span id="insp-edge-a" class="font-semibold text-slate-800 dark:text-white break-words"></span>
            </div>
            <div class="border-t border-slate-200 dark:border-slate-700 pt-2">
              <span class="block text-[10px] uppercase text-slate-400">Titik Tujuan (Port B / Client)</span>
              <span id="insp-edge-b" class="font-semibold text-slate-800 dark:text-white break-words"></span>
            </div>

            <div class="border-t border-slate-200 dark:border-slate-700 pt-1.5">
              <table class="w-full border-collapse text-xs">
                <tbody>
                  <tr>
                    <td class="py-1 pr-3 text-slate-500 dark:text-slate-400 whitespace-nowrap align-top">Link Speed</td>
                    <td id="insp-edge-speed" class="py-1 font-mono font-bold text-emerald-600 dark:text-emerald-400 text-right align-top"></td>
                  </tr>
                  <tr>
                    <td class="py-1 pr-3 text-slate-500 dark:text-slate-400 whitespace-nowrap align-top">Media Kabel</td>
                    <td id="insp-edge-cable" class="py-1 font-mono font-medium text-slate-800 dark:text-slate-200 text-right align-top"></td>
                  </tr>
                  <tr>
                    <td class="py-1 pr-3 text-slate-500 dark:text-slate-400 whitespace-nowrap align-top">VLAN Info</td>
                    <td id="insp-edge-vlan" class="py-1 font-mono font-semibold text-amber-600 dark:text-amber-300 text-right align-top"></td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div>
              <span class="block text-slate-500 dark:text-slate-400 mb-1">Catatan</span>
              <p id="insp-edge-notes" class="text-slate-700 dark:text-slate-300 bg-white dark:bg-slate-800 p-2 rounded border border-slate-200 dark:border-slate-700"></p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</main>

<script>
  (function () {
    const topoMenuWrapper = document.getElementById('topology-actions-wrapper');
    const topoActionsMenu = document.getElementById('topology-actions-menu');
    let topoMenuPinned = false;

    window.toggleTopologyMenu = function (e) {
      if (e) e.stopPropagation();
      if (!topoActionsMenu) return;
      topoMenuPinned = !topoMenuPinned;
      topoActionsMenu.classList.toggle('hidden', !topoMenuPinned);
    };

    window.closeTopologyMenu = function () {
      topoMenuPinned = false;
      if (topoActionsMenu) topoActionsMenu.classList.add('hidden');
    };

    if (topoMenuWrapper && topoActionsMenu) {
      topoMenuWrapper.addEventListener('mouseenter', () => {
        topoActionsMenu.classList.remove('hidden');
      });

      topoMenuWrapper.addEventListener('mouseleave', () => {
        if (!topoMenuPinned) {
          topoActionsMenu.classList.add('hidden');
        }
      });

      // Bersihkan listener klik global lama sebelum mendaftarkan yang baru (aman untuk PJAX)
      if (window._topoDocClickHandler) {
        document.removeEventListener('click', window._topoDocClickHandler);
      }
      window._topoDocClickHandler = (e) => {
        const currentWrapper = document.getElementById('topology-actions-wrapper');
        if (currentWrapper && !currentWrapper.contains(e.target)) {
          window.closeTopologyMenu();
        }
      };
      document.addEventListener('click', window._topoDocClickHandler);
    }

    const rawDevices = <%- JSON.stringify(devices) %>;
    const rawConnections = <%- JSON.stringify(connections) %>;

    let network = null;
    let nodesDataSet = null;
    let edgesDataSet = null;
    let physicsEnabled = true;

    function escapeXml(unsafe) {
      return String(unsafe || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&apos;');
    }

    function getEdgeStyleBySpeed(speed) {
      const spd = (speed || '1G').toUpperCase();
      if (spd === '100M') return { color: '#f59e0b', width: 2 };
      if (spd === '2.5G' || spd === '10G' || spd === '4X10G') return { color: '#06b6d4', width: 3.5 };
      if (spd === '25G' || spd === '40G' || spd === '100G') return { color: '#a855f7', width: 4.5 };
      return { color: '#10b981', width: 2.5 }; // Default 1G
    }

    // =========================================================
    // DETEKSI KATEGORI & WARNA AKSEN KARTU PERANGKAT
    // =========================================================
    function resolveDeviceCategory(dev) {
      const tpl = (dev.faceplate_template || '').toLowerCase();
      const typeName = (dev.type_name || '').toLowerCase();

      if (tpl === 'modem_ont' || typeName.includes('modem') || typeName.includes('ont') || typeName.includes('olt')) {
        return 'modem_ont';
      }
      if (tpl === 'home_router') return 'home_router';
      if (tpl === 'access_point' || typeName.includes('access point') || typeName.includes('wireless') || typeName === 'ap') {
        return 'access_point';
      }
      if (tpl === 'voip' || typeName.includes('voip') || typeName.includes('phone') || typeName.includes('telepon')) {
        return 'voip';
      }
      if (tpl === 'dvr_nvr' || typeName.includes('nvr') || typeName.includes('dvr')) {
        return 'dvr_nvr';
      }
      if (tpl === 'cctv' || typeName.includes('cctv') || typeName.includes('camera') || typeName.includes('kamera')) {
        return 'cctv';
      }
      if (typeName.includes('firewall')) return 'firewall';
      if (typeName.includes('router')) return 'router';
      if (typeName.includes('server')) return 'server';
      if (dev.is_switch === 1 || typeName.includes('switch')) return 'switch';
      return 'generic';
    }

    function getCategoryAccent(cat) {
      switch (cat) {
        case 'router':       return { border: '#38bdf8' };
        case 'firewall':     return { border: '#f87171' };
        case 'switch':       return { border: '#34d399' };
        case 'access_point': return { border: '#c084fc' };
        case 'home_router':  return { border: '#fbbf24' };
        case 'modem_ont':    return { border: '#22d3ee' };
        case 'dvr_nvr':      return { border: '#fb7185' };
        case 'cctv':         return { border: '#94a3b8' };
        case 'voip':         return { border: '#f59e0b' };
        case 'server':       return { border: '#fbbf24' };
        default:             return { border: '#64748b' };
      }
    }

    // =========================================================
    // KOLEKSI IKON VEKTOR SVG (KANVAS 64x64)
    // =========================================================
    function getRawIconPaths(cat) {
      switch (cat) {
        case 'router':
          return `
            <circle cx="32" cy="32" r="25" fill="#ffffff"/>
            <g transform="translate(4, 4) scale(1.555)">
              <path fill="#4799f0" d="M18,1.67a16,16,0,1,0,16,16A16,16,0,0,0,18,1.67ZM13.86,9.92a.8.8,0,0,1,1.13,0l2.21,2.19V5.93a.8.8,0,0,1,1.6,0v6.18L21,9.92a.8.8,0,1,1,1.13,1.14L18,15.15l-4.14-4.1A.8.8,0,0,1,13.86,9.92ZM10.32,21.74a.8.8,0,0,1-1.13,0L5,17.67l4.19-4.09a.8.8,0,1,1,1.12,1.14l-2.2,2.14h6.27a.8.8,0,0,1,0,1.6H8.11l2.2,2.15A.8.8,0,0,1,10.32,21.74Zm11.82,3.67a.8.8,0,0,1-1.13,0L18.8,23.23V29.4a.8.8,0,0,1-1.6,0V23.23L15,25.42a.8.8,0,1,1-1.13-1.14L18,20.18l4.14,4.1A.8.8,0,0,1,22.14,25.41Zm4.67-3.66a.8.8,0,1,1-1.12-1.14l2.2-2.15H21.63a.8.8,0,0,1,0-1.6h6.27l-2.2-2.14a.8.8,0,1,1,1.12-1.14L31,17.67Z"/>
            </g>
          `;

        case 'firewall':
          return `
            <g transform="translate(4, 4) scale(0.1093)">
              <g>
                <g>
                  <path fill="#DD2645" d="M112.06,215.486c11.732,0,21.326-9.595,21.326-21.324v-38.384c0-11.73-9.594-21.324-21.326-21.324 H32.093c-11.73,0.001-21.324,9.595-21.324,21.325v38.384c0,11.729,9.594,21.324,21.324,21.324h79.966V215.486z"/>
                  <path fill="#DD2645" d="M133.385,194.163c0,11.729,9.594,21.324,21.324,21.324l32.03-0.002 c13.506-21.198,29.826-41.833,46.552-61.363c4.424-5.167,9.775-11.855,14.864-19.666h-93.446c-11.73,0-21.324,9.594-21.324,21.324 V194.163z"/>
                  <path fill="#DD2645" d="M306.56,167.653c-3.624,19.21-6.221,34.927-7.964,47.833h58.695 c11.729,0,21.324-9.595,21.324-21.324v-38.384c0-11.73-9.595-21.324-21.324-21.324h-48.613 C309.395,144.492,308.847,155.544,306.56,167.653z"/>
                  <path fill="#DD2645" d="M378.615,155.779v38.384c0,11.729,9.594,21.324,21.324,21.324h79.966 c11.732,0,21.326-9.595,21.326-21.324v-38.384c0-11.73-9.594-21.324-21.326-21.324h-79.966 C388.209,134.455,378.615,144.049,378.615,155.779z"/>
                  <path fill="#DD2645" d="M479.904,215.486h-79.966h-42.647h-58.695c-5.555,41.161-2.434,53.783,3.625,60.209 c0,0,4.338-34.888,47.011-48.957c0,0-3.716,39.366,11.177,69.779h39.528h79.966c11.73,0,21.326-9.595,21.326-21.324v-38.381 C501.23,225.081,491.635,215.486,479.904,215.486z"/>
                  <path fill="#DD2645" d="M153.999,296.53c3.373-27.175,15.857-54.549,32.744-81.044h-32.035h-42.649H32.093 c-11.73,0-21.324,9.595-21.324,21.326v38.382c0,11.729,9.594,21.324,21.324,21.324h79.966c11.732,0,21.326,9.596,21.326,21.324 C133.385,306.35,142.593,296.91,153.999,296.53z"/>
